 },
 {
  "id": "04238:0026",
  "jp": "$c02逢魔人$c00クリスティ",
  "en": ""
 },
 {
  "id": "04238:0027",
  "jp": "あぁ",
  "en": ""
 },
 {
  "id": "04238:0028",
  "jp": "歯がゆいね……",
  "en": ""
 },
 {
  "id": "04238:0029",
  "jp": "仕方がない。まともに\\nやっても、私たちでは\\nとても勝てない",
  "en": ""
 },
 {
  "id": "04238:0030",
  "jp": "もう、正面からの\\n撃ち合いじゃないから\\nイライラするなぁー！",
  "en": ""
 },
 {
  "id": "04238:0031",
  "jp": "でも……",
  "en": ""
 },
 {
  "id": "04238:0032",
  "jp": "あぁ、でも……",
  "en": ""
 },
 {
  "id": "04238:0033",
  "jp": "まぁね。でも、やつらも\\n同じだよ、大時計の\\n封印が破れずに",
  "en": ""
 },
 {
  "id": "04238:0034",
  "jp": "刻音は\\n真実を照らし出す",
  "en": ""
 },
 {
  "id": "04238:0035",
  "jp": "正しき調律を\\n行えば、やつも弱まり\\n歴史も戻って",
  "en": ""
 },
 {
  "id": "04238:0036",
  "jp": "強大な力の殆どを\\nわざわざ、手間のかかる\\n歴史改変に使っている",
  "en": ""
 },
 {
  "id": "04238:0037",
  "jp": "ここで、起こる\\n事件の謎、\\n解き明かしてみせる",
  "en": ""
 },
 {
  "id": "04238:0038",
  "jp": "ふみゅっと一石二鳥",
  "en": ""
 },
 {
  "id": "04238:0039",
  "jp": "黒上が滅べば、封印が\\n解けて、閉じ込められて\\nいなかったことになる",
  "en": ""
 },
 {
  "id": "04238:0040",
  "jp": "うん、がんばろ！",
  "en": ""
 },
 {
  "id": "04238:0041",
  "jp": "あぁ、まずは\\n刻音を集めて\\n謎を解き明かそう",
  "en": ""
 },
 {
  "id": "04238:0042",
  "jp": "復讐も兼ねて一石二鳥\\nってことでしょ？",
  "en": ""
 },
 {
  "id": "04238:0043",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04238:0044",
  "jp": "そんなふざけた野望は\\nとっとと、ぶっ潰す！",
  "en": ""
 },
 {
  "id": "04238:0045",
  "jp": "あぁ、そうしよう",
  "en": ""
 },
 {
  "id": "04238:0046",
  "jp": "【壊された機関室】\\nの刻音を手に入れた！",
  "en": ""
 }
