  "en": ""
 },
 {
  "id": "04238:0012",
  "jp": "外部との連絡を\\n絶とうとしてる？",
  "en": ""
 },
 {
  "id": "04238:0013",
  "jp": "外と連絡させない\\nつもりふう",
