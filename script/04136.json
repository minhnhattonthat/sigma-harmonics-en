 },
 {
  "id": "04136:0012",
  "jp": "そうか、\\nよくやってくれた",
  "en": ""
 },
 {
  "id": "04136:0013",
  "jp": "いえ、\\n黒上の館を守るのも",
  "en": ""
 },
 {
  "id": "04136:0014",
  "jp": "私どもの\\n務めですので……",
  "en": ""
 },
 {
  "id": "04136:0015",
  "jp": "１５時を告げる\\n鐘がなる（仮）",
  "en": ""
 },
 {
  "id": "04136:0016",
  "jp": "皆さんに\\nお茶でも入れますね",
  "en": ""
 },
 {
  "id": "04136:0017",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04136:0018",
  "jp": "あ、あの２人、\\nあんなに強かったんだ",
  "en": ""
 },
 {
  "id": "04136:0019",
  "jp": "ふみゅ。\\n流石は黒上の\\n執事とメイド",
  "en": ""
 },
 {
  "id": "04136:0020",
  "jp": "な、なかなか\\nやるじゃない\\nあの２人",
  "en": ""
 },
 {
  "id": "04136:0021",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04136:0022",
  "jp": "姫籠が結界師だってのは\\n知ってるけど、",
  "en": ""
 },
 {
  "id": "04136:0023",
  "jp": "彼女が、$c02大逢魔$c00と\\n渡り合える程とはね",
  "en": ""
 },
 {
  "id": "04136:0024",
  "jp": "そういえば、執事は、\\n守人家の人間だったね",
  "en": ""
 },
 {
  "id": "04136:0025",
  "jp": "あっ！\\n聞いたことある",
  "en": ""
 },
 {
  "id": "04136:0026",
  "jp": "ふみゅ、【もりと】か\\n聞いたことある",
  "en": ""
 },
 {
  "id": "04136:0027",
  "jp": "ん？　もりと？\\n知ってるわ",
  "en": ""
 },
 {
  "id": "04136:0028",
  "jp": "使い人じゃないのに\\n$c02逢魔$c00と渡り合える\\n一族だって",
  "en": ""
 },
 {
  "id": "04136:0029",
  "jp": "特殊な力を使わず\\n己が肉体のみで、\\n$c02大逢魔$c00とも渡り合う",
  "en": ""
 },
 {
  "id": "04136:0030",
  "jp": "なんでも、使い人じゃ\\nないってのに、",
  "en": ""
 },
 {
  "id": "04136:0031",
  "jp": "あの人が\\nそうだったんだ……",
  "en": ""
 },
 {
  "id": "04136:0032",
  "jp": "そんな一族",
  "en": ""
 },
 {
  "id": "04136:0033",
  "jp": "$c02逢魔$c00を素手で\\nぶっ倒すって\\n連中でしょ？",
  "en": ""
 },
 {
  "id": "04136:0034",
  "jp": "…………\\nだから回りくどいんだ",
  "en": ""
 },
 {
  "id": "04136:0035",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04136:0036",
  "jp": "はてな？",
  "en": ""
 },
 {
  "id": "04136:0037",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04136:0038",
  "jp": "あの２人だけ\\nじゃなくて、",
  "en": ""
 },
 {
  "id": "04136:0039",
  "jp": "黒上家の誰もが、\\n恐らく$c02逢魔$c00と直接の\\n戦いになれば",
  "en": ""
 },
 {
  "id": "04136:0040",
  "jp": "簡単に遅れは取らない",
  "en": ""
 },
 {
  "id": "04136:0041",
  "jp": "そうだよね",
  "en": ""
 },
 {
  "id": "04136:0042",
  "jp": "ふみゅ、確かに",
  "en": ""
 },
 {
  "id": "04136:0043",
  "jp": "ま、確かにね\\n黒上の人間に\\n真っ向から",
  "en": ""
 },
 {
  "id": "04136:0044",
  "jp": "私たちだって、\\n$c02逢魔$c00なんかに\\n負けないもんね",
  "en": ""
 },
 {
  "id": "04136:0045",
  "jp": "その上、ここは黒上\\n使い人の頂点の居城",
  "en": ""
 },
 {
  "id": "04136:0046",
  "jp": "喧嘩うったって\\n損なだけよね",
  "en": ""
 },
 {
  "id": "04136:0047",
  "jp": "だからこそ、\\nこの特殊な狭間から、",
  "en": ""
 },
 {
  "id": "04136:0048",
  "jp": "運命そのものを変え、\\n直接手をくださずに、",
  "en": ""
 },
 {
  "id": "04136:0049",
  "jp": "滅ぼそうと\\nしている……",
  "en": ""
 },
 {
  "id": "04136:0050",
  "jp": "シグマ、絶対、\\n阻止しようね",
  "en": ""
 },
 {
  "id": "04136:0051",
  "jp": "ふみゅ。\\n絶対阻止",
  "en": ""
 },
 {
  "id": "04136:0052",
  "jp": "もー、回りくどいの\\n大ッ嫌い\\n絶対邪魔してやる",
  "en": ""
 },
 {
  "id": "04136:0053",
  "jp": "あぁ。\\n必ず、正しい時に\\n調律してみせる",
  "en": ""
 },
 {
  "id": "04136:0054",
  "jp": "【大逢魔を倒した２人】\\nの刻音を手に入れた！",
  "en": ""
 }
]
