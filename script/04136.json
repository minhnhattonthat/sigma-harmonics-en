 },
 {
  "id": "04136:0008",
  "jp": "何があった！？",
  "en": ""
 },
 {
  "id": "04136:0009",
  "jp": "お騒がせしました",
  "en": ""
 },
 {
  "id": "04136:0010",
  "jp": "$c02逢魔$c00が１匹、現出して\\nいましたので、",
  "en": ""
 },
 {
  "id": "04136:0011",
  "jp": "私どもで、\\n消滅させておきました",
