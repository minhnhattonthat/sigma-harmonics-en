[
 {
  "id": "04136:0000",
  "jp": "$c02逢魔$c00？！",
  "en": ""
 },
 {
  "id": "04136:0001",
  "jp": "なぜ、\\nこちらの世界へ？！",
  "en": ""
 },
 {
  "id": "04136:0002",
  "jp": "これでは、\\n守人失格だな……",
  "en": ""
 },
 {
  "id": "04136:0003",
  "jp": "お手伝いします",
  "en": ""
 },
 {
  "id": "04136:0004",
  "jp": "すまない",
  "en": ""
 },
 {
  "id": "04136:0005",
  "jp": "旦那様たちの手を\\n煩わせる前に\\n片してしまおう",
  "en": ""
 },
 {
  "id": "04136:0006",
  "jp": "はい",
