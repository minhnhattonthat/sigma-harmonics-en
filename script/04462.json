[
 {
  "id": "04462:0000",
  "jp": "久しぶりの思考連結だ\\n少し要点を整理しよう",
  "en": ""
 },
 {
  "id": "04462:0001",
  "jp": "【思考に潜む闇】は\\n黒い点として視覚化\\nされる",
  "en": ""
 },
 {
  "id": "04462:0002",
  "jp": "黒い点の中にある\\n白い点の数が",
  "en": ""
 },
 {
  "id": "04462:0003",
  "jp": "その闇を晴らすのに\\n必要な刻音の数……",
  "en": ""
 },
 {
  "id": "04462:0004",
  "jp": "今まで手に入れた\\n刻音は全て右端に\\n並んでいる",
  "en": ""
 },
 {
  "id": "04462:0005",
  "jp": "刻音は思考の闇に\\n隣接したところにしか\\n置くことが出来ない",
  "en": ""
 },
 {
  "id": "04462:0006",
  "jp": "白い点の数だけ\\n刻音を置けば",
  "en": ""
 },
 {
  "id": "04462:0007",
  "jp": "刻音に応じて\\n思考連結が起き\\n闇は晴れる",
  "en": ""
 },
 {
  "id": "04462:0008",
  "jp": "だが、それは置いた\\n刻音に応じて\\n起きた連結で",
  "en": ""
 },
 {
  "id": "04462:0009",
  "jp": "必ずしも正解とは\\n限らない",
  "en": ""
 },
 {
  "id": "04462:0010",
  "jp": "もう一度、思考連結を\\nやり直す時は",
  "en": ""
 },
 {
  "id": "04462:0011",
  "jp": "再推理を選び、\\n初めから刻音を\\n置く必要がある",
  "en": ""
 },
 {
  "id": "04462:0012",
  "jp": "また闇を晴らす\\nことによって",
  "en": ""
 },
 {
  "id": "04462:0013",
  "jp": "新たな闇や\\n新しい刻音を\\n生みだすこともある…",
  "en": ""
 },
 {
  "id": "04462:0014",
  "jp": "現れた\\n《思考の闇》は３つ",
  "en": ""
 },
 {
  "id": "04462:0015",
  "jp": "それぞれの\\n黒い点をタッチして",
  "en": ""
 },
 {
  "id": "04462:0016",
  "jp": "何を整理し、思考を\\n繋げていけばいいのか\\n確認してみよう",
  "en": ""
 },
 {
  "id": "04462:0017",
  "jp": "超常的な現象を示す\\n刻音があったはずだ\\n二つまとめてみよう",
  "en": ""
 },
 {
  "id": "04462:0018",
  "jp": "この館の状況を直接\\n示す刻音があるはずだ",
  "en": ""
 },
 {
  "id": "04462:0019",
  "jp": "足りない場合は\\n他の闇を先に晴らそう",
  "en": ""
 },
 {
  "id": "04462:0020",
  "jp": "仮面の男とネオン\\n二人の証言をまとめて\\nみよう",
  "en": ""
 },
 {
  "id": "04462:0021",
  "jp": "よし、今現れた闇に\\nこれまで生みだした\\n刻音をはめてみよう",
  "en": ""
 },
 {
  "id": "04462:0022",
  "jp": "《不可思議な状況》\\n普通ではない何かか…",
  "en": ""
 },
 {
  "id": "04462:0023",
  "jp": "この刻音は、\\n『館に関する闇』を",
  "en": ""
 },
 {
  "id": "04462:0024",
  "jp": "晴らすのに\\n使えるかもしれない",
  "en": ""
 },
 {
  "id": "04462:0025",
  "jp": "二人の証言は完全に\\n《食い違っている》",
  "en": ""
 },
 {
  "id": "04462:0026",
  "jp": "この刻音は、\\n『最後に』新たな闇が\\n現れたら使ってみよう",
  "en": ""
 },
 {
  "id": "04462:0027",
  "jp": "普通ではない状況\\n突然、荒廃した館……",
  "en": ""
 },
 {
  "id": "04462:0028",
  "jp": "《知らない世界の館》\\nなのか？",
  "en": ""
 },
 {
  "id": "04462:0029",
  "jp": "新たな刻音\\n【不可思議な状況】\\nを生みだした！",
  "en": ""
 },
 {
  "id": "04462:0030",
  "jp": "新たな刻音\\n【食い違っている証言】\\nを生みだした！",
  "en": ""
 },
 {
  "id": "04462:0031",
  "jp": "新たな刻音\\n【知らない世界の館】\\nを生みだした！",
  "en": ""
 },
 {
  "id": "04462:0032",
  "jp": "最後の答え\\n【時の狭間】\\nを導き出した！！",
  "en": ""
 },
 {
  "id": "04462:0033",
  "jp": "あ……",
  "en": ""
 },
 {
  "id": "04462:0034",
  "jp": "その刻音ですけど\\n置くところが\\n違います",
  "en": ""
 },
 {
  "id": "04462:0035",
  "jp": "突然で、すみません\\n今回は、最初なので",
  "en": ""
 },
 {
  "id": "04462:0036",
  "jp": "私の方から少し\\nアドバイスしますね",
  "en": ""
 },
 {
  "id": "04462:0037",
  "jp": "黒い点をタッチし\\n思考の闇の内容を\\nよく考えて",
  "en": ""
 },
 {
  "id": "04462:0038",
  "jp": "それに関する\\n刻音だけを",
  "en": ""
 },
 {
  "id": "04462:0039",
  "jp": "置いていけば\\n闇は晴れていきます",
  "en": ""
 },
 {
  "id": "04462:0040",
  "jp": "それと、一度置いた\\n刻音は元に戻せない\\nので、再推理を選択",
  "en": ""
 },
 {
  "id": "04462:0041",
  "jp": "推理を最初から\\n組み立てなおす必要が\\nあります",
  "en": ""
 },
 {
  "id": "04462:0042",
  "jp": "今回は、私の方から\\n再推理を選びますね",
  "en": ""
 },
 {
  "id": "04462:0043",
  "jp": "それでは続きをどうぞ",
  "en": ""
 },
 {
  "id": "04462:0044",
  "jp": "既に刻音\\n【不可思議な状況】\\nを生みだしている",
  "en": ""
 },
 {
  "id": "04462:0045",
  "jp": "既に刻音\\n【知らない世界の館】\\nを生みだしている",
  "en": ""
 },
 {
  "id": "04462:0046",
  "jp": "既に刻音\\n【食い違っている証言】\\nを生みだしている",
  "en": ""
 },
 {
  "id": "04462:0047",
  "jp": "そうか……",
  "en": ""
 },
 {
  "id": "04462:0048",
  "jp": "刻音は全て奏でられた\\n真実を解き明かそう…",
  "en": ""
 },
 {
  "id": "04462:0049",
  "jp": "それは推理を中断する\\n時に使用します",
  "en": ""
 },
 {
  "id": "04462:0050",
  "jp": "今回は最初なので、\\n答えに辿り着くまで\\nがんばってください",
  "en": ""
 },
 {
  "id": "04462:0051",
  "jp": "再推理をすると",
  "en": ""
 },
 {
  "id": "04462:0052",
  "jp": "置いた刻音は\\n全て最初の状態に\\n戻るがいいのか？",
  "en": ""
 },
 {
  "id": "04462:0053",
  "jp": "本当に推理を\\nしなおすのなら",
  "en": ""
 },
 {
  "id": "04462:0054",
  "jp": "もう１度、再推理\\nボタンを押そう",
  "en": ""
 },
 {
  "id": "04462:0055",
  "jp": "α版序章イベントでは\\nメニューから推理を\\n選べません",
  "en": ""
 },
 {
  "id": "04462:0056",
  "jp": "α版バトルモードでは\\nメニューから推理を\\n選べません",
  "en": ""
 },
 {
  "id": "04462:0057",
  "jp": "推理を楽しむ場合は、\\nトップメニューから\\n推理モードを\\n選択してください",
  "en": ""
 },
 {
  "id": "04462:0058",
  "jp": "こんにちわ\\nシグマ",
  "en": ""
 },
 {
  "id": "04462:0059",
  "jp": "こんばんわ",
  "en": ""
 }
]
