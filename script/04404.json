 },
 {
  "id": "04404:0058",
  "jp": "大婆は$c02自殺$c00……\\nこれで、推理を\\n進めよう",
  "en": ""
 },
 {
  "id": "04404:0059",
  "jp": "犯人は少女……\\nこれで、推理を\\n進めよう",
  "en": ""
 },
 {
  "id": "04404:0060",
  "jp": "犯人はメイド……\\nこれで、推理を\\n進めよう",
  "en": ""
 },
 {
  "id": "04404:0061",
  "jp": "犯人は佳子……\\nこれで、推理を\\n進めよう",
  "en": ""
 },
 {
  "id": "04404:0062",
  "jp": "犯人は静馬……\\nこれで、推理を\\n進めよう",
  "en": ""
 },
 {
  "id": "04404:0063",
  "jp": "この闇の結論はだした\\n推理を先に進めよう",
