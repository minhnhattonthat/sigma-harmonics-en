 },
 {
  "id": "04404:0054",
  "jp": "これが最後だ。\\n静馬が犯人だとする\\n刻音をまとめよう",
  "en": ""
 },
 {
  "id": "04404:0055",
  "jp": "居間にいたのは静馬、\\n佳子、ねね、$c02死$c00んだ大婆\\nいなかったのはメイド",
