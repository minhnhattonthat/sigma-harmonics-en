 },
 {
  "id": "04404:0045",
  "jp": "それも１つの選択……",
  "en": ""
 },
 {
  "id": "04404:0046",
  "jp": "ならば残る謎は１つ\\n大婆が$c02自殺$c00ととれる\\n刻音があるはずだ",
  "en": ""
 },
 {
  "id": "04404:0047",
  "jp": "ならば残る謎は１つ\\n少女が犯人なのを示す\\n刻音があるはずだ",
  "en": ""
 },
 {
  "id": "04404:0048",
  "jp": "メイドが犯人……\\nそれを示す証拠は３つ\\nあるはずだ",
  "en": ""
 },
 {
  "id": "04404:0049",
  "jp": "居間にいた人物が\\n食事中に行った犯行\\nだと考えた場合、",
