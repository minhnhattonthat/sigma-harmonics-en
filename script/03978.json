[
 {
  "id": "03978:0000",
  "jp": "良かった、\\nここは無事だった",
  "en": ""
 },
 {
  "id": "03978:0001",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "03978:0002",
  "jp": "ただいま！\\n一体、何が……",
  "en": ""
 },
 {
  "id": "03978:0003",
  "jp": "何者だ？",
  "en": ""
 },
 {
  "id": "03978:0004",
  "jp": "この施設は、\\n関係者以外の\\n立ち入りを禁じている",
  "en": ""
 },
 {
  "id": "03978:0005",
  "jp": "今すぐに帰れ",
  "en": ""
 },
 {
  "id": "03978:0006",
  "jp": "な、なんで？\\nどうして\\nそんなこと言うの？",
  "en": ""
 },
 {
  "id": "03978:0007",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "03978:0008",
  "jp": "$c04八咫に持たれし\\n非時香果……",
  "en": ""
 },
 {
  "id": "03978:0009",
  "jp": "$c04この手に取り戻し\\n帰られん$c00",
  "en": ""
 },
 {
  "id": "03978:0010",
  "jp": "？！",
  "en": ""
 },
 {
  "id": "03978:0011",
  "jp": "し、失礼いたしました",
  "en": ""
 },
 {
  "id": "03978:0012",
  "jp": "お帰りなさいませ、\\n【使い人】様……",
  "en": ""
 },
 {
  "id": "03978:0013",
  "jp": "ひとつ聞いて\\nいいかい？",
  "en": ""
 },
 {
  "id": "03978:0014",
  "jp": "はい、なんなりと",
  "en": ""
 },
 {
  "id": "03978:0015",
  "jp": "僕と面識は？",
  "en": ""
 },
 {
  "id": "03978:0016",
  "jp": "いえ……",
  "en": ""
 },
 {
  "id": "03978:0017",
  "jp": "ここ$c02五十年$c00、\\n使い人様が訪れた\\n記録は、ございません",
  "en": ""
 },
 {
  "id": "03978:0018",
  "jp": "なんだって？\\n…………五十年？",
  "en": ""
 },
 {
  "id": "03978:0019",
  "jp": "？？？\\nど、どういうこと？",
  "en": ""
 },
 {
  "id": "03978:0020",
  "jp": "執事さん、\\nどうしちゃったの？",
  "en": ""
 },
 {
  "id": "03978:0021",
  "jp": "ねぇ、シグマ",
  "en": ""
 },
 {
  "id": "03978:0022",
  "jp": "今朝もここから\\n普通に\\n登校したんだよね？",
  "en": ""
 },
 {
  "id": "03978:0023",
  "jp": "あぁ……",
  "en": ""
 },
 {
  "id": "03978:0024",
  "jp": "執事さん、緊急事態で\\nあんな態度を\\n取ってるの？",
  "en": ""
 },
 {
  "id": "03978:0025",
  "jp": "……いや。\\nそれにしては、\\n様子がおかしい……",
  "en": ""
 },
 {
  "id": "03978:0026",
  "jp": "もう少し、ここを\\n調べた方がよさそうだ",
  "en": ""
 },
 {
  "id": "03978:0027",
  "jp": "何が起こっているか\\n推理をしてみよう",
  "en": ""
 },
 {
  "id": "03978:0028",
  "jp": "シグマは得た情報から\\n重要な【音】を聞き\\n分けることができます",
  "en": ""
 },
 {
  "id": "03978:0029",
  "jp": "この【音】を、\\n彼の頭脳に\\n【刻】み込んだものを",
  "en": ""
 },
 {
  "id": "03978:0030",
  "jp": "【刻音】（こくいん）\\nと呼びます",
  "en": ""
 },
 {
  "id": "03978:0031",
  "jp": "刻音はシグマが推理を\\n展開する時に\\n必要となります",
  "en": ""
 },
 {
  "id": "03978:0032",
  "jp": "$c01【用語集】に\\n項目が追加された$c00",
  "en": ""
 },
 {
  "id": "03978:0033",
  "jp": "《用語》はストーリー\\n進行に合わせて\\n追加されていきます",
  "en": ""
 },
 {
  "id": "03978:0034",
  "jp": "【用語集】はメニュー\\n【システム】から\\n選ぶことができます",
  "en": ""
 },
 {
  "id": "03978:0035",
  "jp": "シグマ、調べないの？",
  "en": ""
 },
 {
  "id": "03978:0036",
  "jp": "そうだね、\\n調音査を使って\\n光を調べてみよう",
  "en": ""
 },
 {
  "id": "03978:0037",
  "jp": "調音査をするには\\nメニューの【調音査】\\nを選ぶんだよ",
  "en": ""
 },
 {
  "id": "03978:0038",
  "jp": "ねぇ、シグマ",
  "en": ""
 },
 {
  "id": "03978:0039",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "03978:0040",
  "jp": "さっき、\\n執事さんに言ってた\\n八咫のなんとかって",
  "en": ""
 },
 {
  "id": "03978:0041",
  "jp": "黒上が使う術か\\n何かの一文？",
  "en": ""
 },
 {
  "id": "03978:0042",
  "jp": "あぁ、合い言葉として\\n使ったんだ",
  "en": ""
 },
 {
  "id": "03978:0043",
  "jp": "僕が黒上だって\\n気づいてもらう\\nためにね",
  "en": ""
 },
 {
  "id": "03978:0044",
  "jp": "【執事は僕らを……】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "03978:0045",
  "jp": "【五十年不在】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "03978:0046",
  "jp": "【シグマが唱えた言葉】\\nの刻音を手に入れた！",
  "en": ""
 }
]
