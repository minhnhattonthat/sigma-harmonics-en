[
 {
  "id": "04294:0000",
  "jp": "何か、私に\\nお聞きになりたい\\nことがあるとか",
  "en": ""
 },
 {
  "id": "04294:0001",
  "jp": "ああ、単刀直入に…",
  "en": ""
 },
 {
  "id": "04294:0002",
  "jp": "おっと、その前に、\\n私から芙蓉様の\\nお耳に入れたいことが",
  "en": ""
 },
 {
  "id": "04294:0003",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04294:0004",
  "jp": "麟様が、お亡くなりに\\nなりました",
  "en": ""
 },
 {
  "id": "04294:0005",
  "jp": "なんですって",
  "en": ""
 },
 {
  "id": "04294:0006",
  "jp": "……あなたが麟を\\n$c02殺$c00したのね？",
  "en": ""
 },
 {
  "id": "04294:0007",
  "jp": "いいえ、違いますよ",
  "en": ""
 },
 {
  "id": "04294:0008",
  "jp": "突然、何を\\nおっしゃいますやら",
  "en": ""
 },
 {
  "id": "04294:0009",
  "jp": "見え透いた嘘を！",
  "en": ""
 },
 {
  "id": "04294:0010",
  "jp": "おや、譲葉の方から\\nそのようなお言葉を\\nかけられるとは、",
  "en": ""
 },
 {
  "id": "04294:0011",
  "jp": "心外ですな",
  "en": ""
 },
 {
  "id": "04294:0012",
  "jp": "確かに、\\n言の葉に揺らぎは\\n感じられなかった",
  "en": ""
 },
 {
  "id": "04294:0013",
  "jp": "一体どういう……？",
  "en": ""
 },
 {
  "id": "04294:0014",
  "jp": "これでお別れです",
  "en": ""
 },
 {
  "id": "04294:0015",
  "jp": "芙蓉さん、\\n$c02何かを言おうと$c00した\\n途端に……",
  "en": ""
 },
 {
  "id": "04294:0016",
  "jp": "言の葉、$c02何か聞くふう$c00\\nだった？",
  "en": ""
 },
 {
  "id": "04294:0017",
  "jp": "芙蓉が、$c02何か言おうと$c00\\nした所だったのに",
  "en": ""
 },
 {
  "id": "04294:0018",
  "jp": "うん、それに\\n気になるのは、",
  "en": ""
 },
 {
  "id": "04294:0019",
  "jp": "$c02麟が死んだ$c00、\\nという執事の発言だ",
  "en": ""
 },
 {
  "id": "04294:0020",
  "jp": "何かの間違いじゃ\\nないのかしら",
  "en": ""
 },
 {
  "id": "04294:0021",
  "jp": "りんりん、いつの間に？\\n本当？",
  "en": ""
 },
 {
  "id": "04294:0022",
  "jp": "これも嘘、ってわけじゃ\\nなさそうね",
  "en": ""
 },
 {
  "id": "04294:0023",
  "jp": "譲葉の者が聞いて\\n見抜けないので\\nあれば、",
  "en": ""
 },
 {
  "id": "04294:0024",
  "jp": "執事が言ったことは\\n本当だと考える\\nしかない",
  "en": ""
 },
 {
  "id": "04294:0025",
  "jp": "ちょっと、やっかいな\\nことになってきたね",
  "en": ""
 },
 {
  "id": "04294:0026",
  "jp": "【芙蓉の死】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04294:0027",
  "jp": "超推理に\\n「芙蓉の発言」\\nに関する闇が現れた！",
  "en": ""
 },
 {
  "id": "04294:0028",
  "jp": "超推理に\\n「麟の死亡」\\nに関する闇が現れた！",
  "en": ""
 }
]
