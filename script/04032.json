 },
 {
  "id": "04032:0015",
  "jp": "……さてね",
  "en": ""
 },
 {
  "id": "04032:0016",
  "jp": "これだけじゃ、\\nなんとも言えない",
  "en": ""
 },
 {
  "id": "04032:0017",
  "jp": "【人物　メイド】\\nの刻音を手に入れた\\n（仮）",
  "en": ""
 },
 {
  "id": "04032:0018",
  "jp": "【メイドは自殺？】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04032:0019",
  "jp": "最初に見た、\\n始まりの事件も、\\n１度確認してみよう",
  "en": ""
 },
 {
  "id": "04032:0020",
  "jp": "さっきは、刻音も\\n作らなかったしね",
  "en": ""
 },
 {
  "id": "04032:0021",
  "jp": "あれは【居間】\\nだったよね。\\n行ってみましょう",
  "en": ""
 },
 {
  "id": "04032:0022",
  "jp": "この時間には、\\nこれ以上の魂の影が\\n存在しないようだ",
  "en": ""
 },
 {
  "id": "04032:0023",
  "jp": "他の時間に行けるか\\n大時計の間で\\n調べてみよう",
  "en": ""
 },
 {
  "id": "04032:0024",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04032:0025",
  "jp": "安定してる時を\\nほどいて、他の時間を\\n紡ぎ直す時は",
  "en": ""
 },
 {
  "id": "04032:0026",
  "jp": "大時計を調音査で\\n調べれば\\nいいんだよね？",
  "en": ""
 },
 {
  "id": "04032:0027",
  "jp": "あぁ",
  "en": ""
 },
 {
  "id": "04032:0028",
  "jp": "大時計を【調音査】すれば\\n紡ぐ時を選べるよ",
  "en": ""
 },
 {
  "id": "04032:0029",
  "jp": "$c01大時計の間で\\n【時紡ぎ】が\\nできるようになった$c00",
  "en": ""
 },
 {
  "id": "04032:0030",
  "jp": "$c01チュートリアル\\n《時紡ぎ》《時渡り》\\nが追加された$c00",
  "en": ""
 },
 {
  "id": "04032:0031",
  "jp": "この事件で必要な\\n刻音は全て\\n集まったみたいだ",
  "en": ""
 },
 {
  "id": "04032:0032",
  "jp": "じゃあ……",
  "en": ""
 },
 {
  "id": "04032:0033",
  "jp": "ではでは",
  "en": ""
 },
 {
  "id": "04032:0034",
  "jp": "よし！\\nならなら",
  "en": ""
 },
 {
  "id": "04032:0035",
  "jp": "あぁ、超推理で\\nこの謎を解き明かそう",
  "en": ""
 }
