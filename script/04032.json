 },
 {
  "id": "04032:0012",
  "jp": "なんで……？",
  "en": ""
 },
 {
  "id": "04032:0013",
  "jp": "スープの飲み過ぎ……\\nの訳はない",
  "en": ""
 },
 {
  "id": "04032:0014",
  "jp": "そんなふうには\\n見えないわよ",
