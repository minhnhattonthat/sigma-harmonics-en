[
 {
  "id": "04026:0000",
  "jp": "トマトのスープ……\\nそれに……",
  "en": ""
 },
 {
  "id": "04026:0001",
  "jp": "よくない印……",
  "en": ""
 },
 {
  "id": "04026:0002",
  "jp": "さ、食事にしましょう",
  "en": ""
 },
 {
  "id": "04026:0003",
  "jp": "……",
  "en": ""
 },
 {
  "id": "04026:0004",
  "jp": "なんね、\\n食べんのかえ？",
  "en": ""
 },
 {
  "id": "04026:0005",
  "jp": "いらない",
  "en": ""
 },
 {
  "id": "04026:0006",
  "jp": "まぁったく……\\n好き嫌いしおって",
  "en": ""
 },
 {
  "id": "04026:0007",
  "jp": "まぁ、ねねの\\nトマト嫌いは",
  "en": ""
 },
 {
  "id": "04026:0008",
  "jp": "今に始まったことじゃ\\nありませんし",
  "en": ""
 },
 {
  "id": "04026:0009",
  "jp": "だぁから、\\n食べやすいよう\\nスープを……",
  "en": ""
 },
 {
  "id": "04026:0010",
  "jp": "……？",
  "en": ""
 },
 {
  "id": "04026:0011",
  "jp": "ぐっ！？",
  "en": ""
 },
 {
  "id": "04026:0012",
  "jp": "大婆様！？",
  "en": ""
 },
 {
  "id": "04026:0013",
  "jp": "馬鹿な……",
  "en": ""
 },
 {
  "id": "04026:0014",
  "jp": "$c02死$c00んでいる……",
  "en": ""
 },
 {
  "id": "04026:0015",
  "jp": "……",
  "en": ""
 },
 {
  "id": "04026:0016",
  "jp": "ねねは、部屋に\\n戻っていなさい",
  "en": ""
 },
 {
  "id": "04026:0017",
  "jp": "佳子、\\nユリ子はどこだ？",
  "en": ""
 },
 {
  "id": "04026:0018",
  "jp": "えっ？\\nユリ子さん？",
  "en": ""
 },
 {
  "id": "04026:0019",
  "jp": "そういえば、\\n今日は一緒に\\nいないわね……",
  "en": ""
 },
 {
  "id": "04026:0020",
  "jp": "ユリ子！\\nユリ子！！",
  "en": ""
 },
 {
  "id": "04026:0021",
  "jp": "これが……\\n始まりなの……",
  "en": ""
 },
 {
  "id": "04026:0022",
  "jp": "くっ……",
  "en": ""
 },
 {
  "id": "04026:0023",
  "jp": "シグマ？",
  "en": ""
 },
 {
  "id": "04026:0024",
  "jp": "シグマ！？",
  "en": ""
 },
 {
  "id": "04026:0025",
  "jp": "大丈夫……",
  "en": ""
 },
 {
  "id": "04026:0026",
  "jp": "なる、ほど……",
  "en": ""
 },
 {
  "id": "04026:0027",
  "jp": "この事件を発端にして\\n黒上一族は滅び",
  "en": ""
 },
 {
  "id": "04026:0028",
  "jp": "僕の両親、\\nそして僕自身の\\n存在も消える……",
  "en": ""
 },
 {
  "id": "04026:0029",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04026:0030",
  "jp": "なぜ僕は、元の時間で\\n消えずに残れたんだ\\n……？",
  "en": ""
 },
 {
  "id": "04026:0031",
  "jp": "ねぇ、\\nほんと大丈夫……？",
  "en": ""
 },
 {
  "id": "04026:0032",
  "jp": "あぁ、大丈夫\\nもう、安定してる\\nみたいだ",
  "en": ""
 },
 {
  "id": "04026:0033",
  "jp": "びっくりした……",
  "en": ""
 },
 {
  "id": "04026:0034",
  "jp": "あれかな？　過去が\\n変わってきてるから、",
  "en": ""
 },
 {
  "id": "04026:0035",
  "jp": "私たちの存在も、\\nゆらいじゃってる\\nのかな……",
  "en": ""
 },
 {
  "id": "04026:0036",
  "jp": "……恐らくね",
  "en": ""
 },
 {
  "id": "04026:0037",
  "jp": "あれ、そういえば",
  "en": ""
 },
 {
  "id": "04026:0038",
  "jp": "今の私たちって、\\n過去そのものに\\nいるわけじゃないから",
  "en": ""
 },
 {
  "id": "04026:0039",
  "jp": "あの人たちに\\n直接、触れたり",
  "en": ""
 },
 {
  "id": "04026:0040",
  "jp": "何かを伝えたりは\\nできないんだよね？",
  "en": ""
 },
 {
  "id": "04026:0041",
  "jp": "あぁ",
  "en": ""
 },
 {
  "id": "04026:0042",
  "jp": "僕らは不安定な\\n時間に漂っている",
  "en": ""
 },
 {
  "id": "04026:0043",
  "jp": "時の残滓を\\n視ているにすぎない",
  "en": ""
 },
 {
  "id": "04026:0044",
  "jp": "だよね",
  "en": ""
 },
 {
  "id": "04026:0045",
  "jp": "じゃあ、過去を変えた\\n犯人は、どうやって、",
  "en": ""
 },
 {
  "id": "04026:0046",
  "jp": "こんなふうに、\\nありもしない事件を\\n作りだしてるの？",
  "en": ""
 },
 {
  "id": "04026:0047",
  "jp": "いや、犯人である、\\n【過去の変革者】も",
  "en": ""
 },
 {
  "id": "04026:0048",
  "jp": "過去そのものを\\n作っている\\nわけじゃない",
  "en": ""
 },
 {
  "id": "04026:0049",
  "jp": "？？\\nじゃあ、どうやって？",
  "en": ""
 },
 {
  "id": "04026:0050",
  "jp": "恐らくこれは、\\n過去の人物に、",
  "en": ""
 },
 {
  "id": "04026:0051",
  "jp": "【アイツを$c02殺$c00すしかない】",
  "en": ""
 },
 {
  "id": "04026:0052",
  "jp": "というような\\n感情や想いを抱かせ",
  "en": ""
 },
 {
  "id": "04026:0053",
  "jp": "犯行を行わせて\\nいるんだろうね",
  "en": ""
 },
 {
  "id": "04026:0054",
  "jp": "えっ？！\\nそんなことできるの？",
  "en": ""
 },
 {
  "id": "04026:0055",
  "jp": "【$c02逢魔$c00】を使えばね",
  "en": ""
 },
 {
  "id": "04026:0056",
  "jp": "【$c02逢魔$c00】……を？",
  "en": ""
 },
 {
  "id": "04026:0057",
  "jp": "あぁ",
  "en": ""
 },
 {
  "id": "04026:0058",
  "jp": "【$c02逢魔$c00】は、\\n時という次元に\\n縛られないと同時に",
  "en": ""
 },
 {
  "id": "04026:0059",
  "jp": "あらゆる時と\\n隣り合わせに\\n存在している",
  "en": ""
 },
 {
  "id": "04026:0060",
  "jp": "そして、ごく稀に、\\n時の壁を越え\\n人の意識に干渉をする",
  "en": ""
 },
 {
  "id": "04026:0061",
  "jp": "【$c02魔$c00が差す】\\nっていうのは、それさ",
  "en": ""
 },
 {
  "id": "04026:0062",
  "jp": "そして、変革者は、\\nこの時の狭間から……",
  "en": ""
 },
 {
  "id": "04026:0063",
  "jp": "【$c02逢魔$c00】を使い、\\n過去の人たちに、\\n$c02殺人$c00をさせてる",
  "en": ""
 },
 {
  "id": "04026:0064",
  "jp": "多分ね",
  "en": ""
 },
 {
  "id": "04026:0065",
  "jp": "で、でもシグマ、\\nそんなことって……",
  "en": ""
 },
 {
  "id": "04026:0066",
  "jp": "あぁ、僕も、\\nにわかには\\n信じられないけどね",
  "en": ""
 },
 {
  "id": "04026:0067",
  "jp": "そんなことが\\nできるのは……",
  "en": ""
 },
 {
  "id": "04026:0068",
  "jp": "くっ……",
  "en": ""
 },
 {
  "id": "04026:0069",
  "jp": "シグマ？",
  "en": ""
 },
 {
  "id": "04026:0070",
  "jp": "$c01ほぉ……$c00",
  "en": ""
 },
 {
  "id": "04026:0071",
  "jp": "！？",
  "en": ""
 },
 {
  "id": "04026:0072",
  "jp": "$c01黒上……なのか？",
  "en": ""
 },
 {
  "id": "04026:0073",
  "jp": "$c01まさか生き残りが\\nいたとはな……$c00",
  "en": ""
 },
 {
  "id": "04026:0074",
  "jp": "お前が、\\n歴史を変えた犯人……\\n変革者か",
  "en": ""
 },
 {
  "id": "04026:0075",
  "jp": "$c01……はっ、\\nなんだその\\nくだらん台詞は",
  "en": ""
 },
 {
  "id": "04026:0076",
  "jp": "$c01貴様、その様では、\\nたかが知れてしまうぞ",
  "en": ""
 },
 {
  "id": "04026:0077",
  "jp": "$c01道理で、この狭間に\\n散らばる無限の死$c00",
  "en": ""
 },
 {
  "id": "04026:0078",
  "jp": "$c01何１つ調律されて\\nないわけだ$c00",
  "en": ""
 },
 {
  "id": "04026:0079",
  "jp": "無限の$c02死$c00……？",
  "en": ""
 },
 {
  "id": "04026:0080",
  "jp": "$c01そうだ、耳を澄ませ",
  "en": ""
 },
 {
  "id": "04026:0081",
  "jp": "$c01貴様なら、この世界の\\n悲鳴が聞こえたはずだ",
  "en": ""
 },
 {
  "id": "04026:0082",
  "jp": "$c01時は捻られ、\\n砕かれ、\\n泣き叫んでいる",
  "en": ""
 },
 {
  "id": "04026:0083",
  "jp": "$c01さっさと、捻られた\\n現象を解き明かし、",
  "en": ""
 },
 {
  "id": "04026:0084",
  "jp": "$c01元なる時へ\\n調律することだな$c00",
  "en": ""
 },
 {
  "id": "04026:0085",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04026:0086",
  "jp": "シグマ、\\n今の男が犯人かな？",
  "en": ""
 },
 {
  "id": "04026:0087",
  "jp": "……分からない……",
  "en": ""
 },
 {
  "id": "04026:0088",
  "jp": "絶対、犯人。\\n怪しすぎるもん",
  "en": ""
 },
 {
  "id": "04026:0089",
  "jp": "ただ、\\nあの男のいった通り、\\n元の歴史に戻すには",
  "en": ""
 },
 {
  "id": "04026:0090",
  "jp": "ここで【時の調律】を\\n行うのが一番良いの\\nかもしれない",
  "en": ""
 },
 {
  "id": "04026:0091",
  "jp": "時の調律？？",
  "en": ""
 },
 {
  "id": "04026:0092",
  "jp": "どうしたらいいの？",
  "en": ""
 },
 {
  "id": "04026:0093",
  "jp": "そうだね、まずは、",
  "en": ""
 },
 {
  "id": "04026:0094",
  "jp": "この捻れた過去で、\\n何が起こったのか",
  "en": ""
 },
 {
  "id": "04026:0095",
  "jp": "それを解き明かす\\nことからかな",
  "en": ""
 },
 {
  "id": "04026:0096",
  "jp": "じゃあ、\\n謎解きアイテムの、",
  "en": ""
 },
 {
  "id": "04026:0097",
  "jp": "【刻音】をシッカリ\\n集めなくちゃ",
  "en": ""
 },
 {
  "id": "04026:0098",
  "jp": "【刻音】さえ集めれば、\\nシグマの超推理で、",
  "en": ""
 },
 {
  "id": "04026:0099",
  "jp": "どんな謎でも\\n解決できるもんね",
  "en": ""
 },
 {
  "id": "04026:0100",
  "jp": "あぁ、そして\\n捻れを生み出している\\n【$c02逢魔$c00】を倒せば、",
  "en": ""
 },
 {
  "id": "04026:0101",
  "jp": "時の調律は完成する",
  "en": ""
 },
 {
  "id": "04026:0102",
  "jp": "よし、がんばろ！",
  "en": ""
 },
 {
  "id": "04026:0103",
  "jp": "あぁ、この歪んだ世界、",
  "en": ""
 },
 {
  "id": "04026:0104",
  "jp": "僕らで\\n調律してみせよう",
  "en": ""
 },
 {
  "id": "04026:0105",
  "jp": "やっぱり、食事に毒が\\n入ってたのかな……？",
  "en": ""
 },
 {
  "id": "04026:0106",
  "jp": "やはり、\\n毒を飲まされてる？",
  "en": ""
 },
 {
  "id": "04026:0107",
  "jp": "やっぱ、この時には\\n毒を飲まされてる\\nわけよね",
  "en": ""
 },
 {
  "id": "04026:0108",
  "jp": "そう、見えるけどね",
  "en": ""
 },
 {
  "id": "04026:0109",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04026:0110",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04026:0111",
  "jp": "はい？",
  "en": ""
 },
 {
  "id": "04026:0112",
  "jp": "僕らは、\\n過去を断片的に\\n視てるだけだから",
  "en": ""
 },
 {
  "id": "04026:0113",
  "jp": "どんなことでも、\\n決めつけない方が\\nいいってことさ",
  "en": ""
 },
 {
  "id": "04026:0114",
  "jp": "うーん、\\nつまり私たちは、",
  "en": ""
 },
 {
  "id": "04026:0115",
  "jp": "ふみゅ\\nイチリあり",
  "en": ""
 },
 {
  "id": "04026:0116",
  "jp": "分かってるわよ",
  "en": ""
 },
 {
  "id": "04026:0117",
  "jp": "過去のものを、直接\\n触ったり、調べたりは\\nできないから",
  "en": ""
 },
 {
  "id": "04026:0118",
  "jp": "情報には振り回されず、\\nシグマを\\n振り回そう……",
  "en": ""
 },
 {
  "id": "04026:0119",
  "jp": "あくまでも情報は、\\n直感的に捉えよう",
  "en": ""
 },
 {
  "id": "04026:0120",
  "jp": "視たことは、あくまで\\n情報として客観的に\\n捉えていこう",
  "en": ""
 },
 {
  "id": "04026:0121",
  "jp": "ってこと？",
  "en": ""
 },
 {
  "id": "04026:0122",
  "jp": "ってことよね",
  "en": ""
 },
 {
  "id": "04026:0123",
  "jp": "ってことかしら？",
  "en": ""
 },
 {
  "id": "04026:0124",
  "jp": "そういうこと",
  "en": ""
 },
 {
  "id": "04026:0125",
  "jp": "はは……",
  "en": ""
 },
 {
  "id": "04026:0126",
  "jp": "いや、だから……",
  "en": ""
 },
 {
  "id": "04026:0127",
  "jp": "そういえば、\\nお婆さんが倒れた時",
  "en": ""
 },
 {
  "id": "04026:0128",
  "jp": "シグマ、婆ちゃん、\\nバタンキューの時",
  "en": ""
 },
 {
  "id": "04026:0129",
  "jp": "そういえばさ\\n大婆が倒れた時",
  "en": ""
 },
 {
  "id": "04026:0130",
  "jp": "シミになってた\\nところに何か\\n書いてなかった？",
  "en": ""
 },
 {
  "id": "04026:0131",
  "jp": "何か書いてあったの\\n気づき済み？",
  "en": ""
 },
 {
  "id": "04026:0132",
  "jp": "クロスの所に\\nなんか書いてなかった？",
  "en": ""
 },
 {
  "id": "04026:0133",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04026:0134",
  "jp": "【赤茄子を\\n　啄み$c02死$c00にゆく\\n　老雀】……か",
  "en": ""
 },
 {
  "id": "04026:0135",
  "jp": "老雀っていうのは、\\nお婆さんを\\nさしてるのかな？",
  "en": ""
 },
 {
  "id": "04026:0136",
  "jp": "老いた雀は、\\n婆ちゃんのことと\\n思われる",
  "en": ""
 },
 {
  "id": "04026:0137",
  "jp": "ろーじゃん？\\n麻雀の親戚？",
