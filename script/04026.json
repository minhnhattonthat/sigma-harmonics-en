 },
 {
  "id": "04026:0138",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04026:0139",
  "jp": "い、いや、\\n【ろうすずめ】\\nじゃないかな？",
  "en": ""
 },
 {
  "id": "04026:0140",
  "jp": "赤茄子というのは、\\nトマトのことだから",
  "en": ""
 },
 {
  "id": "04026:0141",
  "jp": "トマトのスープを\\n飲んで$c02死$c00ぬのは、",
  "en": ""
 },
 {
  "id": "04026:0142",
  "jp": "大婆だと暗示している\\nわけか……",
  "en": ""
 },
 {
  "id": "04026:0143",
  "jp": "それって、\\n犯人からの\\nメッセージ……？",
  "en": ""
 },
 {
  "id": "04026:0144",
  "jp": "ふみゅ\\n犯人からの予告状",
  "en": ""
 },
 {
  "id": "04026:0145",
  "jp": "？　何それ、\\n犯人が書いたの？",
  "en": ""
 },
 {
  "id": "04026:0146",
  "jp": "そうだね、事前に\\n予告を済ましている\\nということは",
  "en": ""
 },
 {
  "id": "04026:0147",
  "jp": "それにしては、\\nしょぼい書き込みね",
  "en": ""
 },
 {
  "id": "04026:0148",
  "jp": "犯人は大婆を狙い、\\n大婆だけを$c02殺$c00した……",
  "en": ""
 },
 {
  "id": "04026:0149",
  "jp": "もっと、ドカーンと\\n書けばいいのに",
  "en": ""
 },
 {
  "id": "04026:0150",
  "jp": "と、見て取れるけど……",
  "en": ""
 },
 {
  "id": "04026:0151",
  "jp": "そ、そうだね",
  "en": ""
 },
 {
  "id": "04026:0152",
  "jp": "けど？",
  "en": ""
 },
 {
  "id": "04026:0153",
  "jp": "それも、１つの推理",
  "en": ""
 },
 {
  "id": "04026:0154",
  "jp": "ここで、重要なのは\\n事前に予告をしたなら",
  "en": ""
 },
 {
  "id": "04026:0155",
  "jp": "これも、\\nただの情報の１つさ",
  "en": ""
 },
 {
  "id": "04026:0156",
  "jp": "そう、真相は\\nまだ分からない",
  "en": ""
 },
 {
  "id": "04026:0157",
  "jp": "犯人は大婆を狙い、\\n大婆だけを$c02殺$c00した\\nようにも見える点",
  "en": ""
 },
 {
  "id": "04026:0158",
  "jp": "他の物事と、\\n照らし合わせながら\\n考えよう",
  "en": ""
 },
 {
  "id": "04026:0159",
  "jp": "じゃあ、\\nそれで超推理しましょ",
  "en": ""
 },
 {
  "id": "04026:0160",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04026:0161",
  "jp": "了解",
  "en": ""
 },
 {
  "id": "04026:0162",
  "jp": "ま、まだ、早いって",
  "en": ""
 },
 {
  "id": "04026:0163",
  "jp": "あれ？",
  "en": ""
 },
 {
  "id": "04026:0164",
  "jp": "ふみゅ？",
  "en": ""
 },
 {
  "id": "04026:0165",
  "jp": "うん？\\nあぁ、そうよ",
  "en": ""
 },
 {
  "id": "04026:0166",
  "jp": "でも、もし犯人が、\\n大婆様に毒を\\n盛ったとしたら",
  "en": ""
 },
 {
  "id": "04026:0167",
  "jp": "仮定。犯人が\\n婆ちゃんの食事に\\n毒を入れたとする",
  "en": ""
 },
 {
  "id": "04026:0168",
  "jp": "犯人が毒盛ったのって、\\nいつ？？",
  "en": ""
 },
 {
  "id": "04026:0169",
  "jp": "一体、いつ……？",
  "en": ""
 },
 {
  "id": "04026:0170",
  "jp": "でも、しかし、\\nいつ入れた？",
  "en": ""
 },
 {
  "id": "04026:0171",
  "jp": "それが分かってからの\\n方がいいんじゃない？",
  "en": ""
 },
 {
  "id": "04026:0172",
  "jp": "食事中に、そんなこと\\nしてた人は\\nいなかったわ",
  "en": ""
 },
 {
  "id": "04026:0173",
  "jp": "食事中は、\\nそんな隙はなかった",
  "en": ""
 },
 {
  "id": "04026:0174",
  "jp": "食事中に毒盛ってる\\n人なんかいなかったし",
  "en": ""
 },
 {
  "id": "04026:0175",
  "jp": "……あぁ。\\n視ている限りでは……",
  "en": ""
 },
 {
  "id": "04026:0176",
  "jp": "あ、あぁ、\\n視ている限りでは……",
  "en": ""
 },
 {
  "id": "04026:0177",
  "jp": "【食事中に毒を\\n　盛るのは不可能】\\nだった",
  "en": ""
 },
 {
  "id": "04026:0178",
  "jp": "食事は、\\nねねちゃん以外は\\n同じもの食べたよね？",
  "en": ""
 },
 {
  "id": "04026:0179",
  "jp": "食事は、ねねっちが\\nトマト飲まなかった\\nだけで、後は一緒ふう",
  "en": ""
 },
 {
  "id": "04026:0180",
  "jp": "食事は、ねねがスープ\\n飲まなかっただけで\\n後は一緒だったわよね",
  "en": ""
 },
 {
  "id": "04026:0181",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04026:0182",
  "jp": "この時間には、\\nこれ以上の魂の影が\\n存在しないようだ",
  "en": ""
 },
 {
  "id": "04026:0183",
  "jp": "他の時間に行けるか\\n大時計の間で\\n調べてみよう",
  "en": ""
 },
 {
  "id": "04026:0184",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04026:0185",
  "jp": "安定してる時を\\nほどいて、他の時間を\\n紡ぎ直す時は",
  "en": ""
 },
 {
  "id": "04026:0186",
  "jp": "大時計を調音査で\\n調べれば\\nいいんだよね？",
  "en": ""
 },
 {
  "id": "04026:0187",
  "jp": "あぁ",
  "en": ""
 },
 {
  "id": "04026:0188",
  "jp": "大時計を【調音査】すれば\\n紡ぐ時を選べるよ",
  "en": ""
 },
 {
  "id": "04026:0189",
  "jp": "【人物　大婆様】\\nの刻音を手に入れた\\n（仮）",
  "en": ""
 },
 {
  "id": "04026:0190",
  "jp": "【人物　少女】\\nの刻音を手に入れた\\n（仮）",
  "en": ""
 },
 {
  "id": "04026:0191",
  "jp": "【人物　静馬】\\nの刻音を手に入れた\\n（仮）",
  "en": ""
 },
 {
  "id": "04026:0192",
  "jp": "【人物　佳子】\\nの刻音を手に入れた\\n（仮）",
  "en": ""
 },
 {
  "id": "04026:0193",
  "jp": "【誰も毒を……】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04026:0194",
  "jp": "【トマトが嫌いな少女】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04026:0195",
  "jp": "【殺人予告？】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04026:0196",
  "jp": "$c01大時計の間で\\n【時紡ぎ】が\\nできるようになった$c00",
  "en": ""
 },
 {
  "id": "04026:0197",
  "jp": "$c01【用語集】に\\n【式札】\\nが追加された$c00",
  "en": ""
 },
 {
  "id": "04026:0198",
  "jp": "$c01【用語集】に\\n【時紡ぎ】\\nが追加された$c00",
  "en": ""
 },
 {
  "id": "04026:0199",
  "jp": "この事件で必要な\\n刻音は全て\\n集まったみたいだ",
  "en": ""
 },
 {
  "id": "04026:0200",
  "jp": "じゃあ……",
  "en": ""
 },
 {
  "id": "04026:0201",
  "jp": "ではでは",
  "en": ""
 },
 {
  "id": "04026:0202",
  "jp": "よし！\\nならなら",
  "en": ""
 },
 {
  "id": "04026:0203",
  "jp": "あぁ、超推理で\\nこの謎を解き明かそう",
  "en": ""
 }
]
