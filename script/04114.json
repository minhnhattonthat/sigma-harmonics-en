 {
  "id": "04114:0001",
  "jp": "あ、式札で\\n他の時が紡げるように\\nなったみたい",
  "en": ""
 },
 {
  "id": "04114:0002",
  "jp": "あ、新しい時間、紡げる\\nようになったふう",
  "en": ""
 },
 {
  "id": "04114:0003",
  "jp": "ん？　式札に\\n新しい時間が\\n増えてるわね",
  "en": ""
 },
 {
  "id": "04114:0004",
  "jp": "でも、ずいぶん、\\n時間が安定せずに\\nゆらいでるのね",
  "en": ""
 },
 {
  "id": "04114:0005",
  "jp": "しかし、時間、不安定\\nゆらゆらしてる",
  "en": ""
 },
 {
  "id": "04114:0006",
  "jp": "しっかし、ずいぶんと\\n不安定な時間ね",
  "en": ""
 },
 {
  "id": "04114:0007",
  "jp": "$c02大逢魔$c00が時を隠そうと\\nしているのかも\\nしれない",
  "en": ""
 },
 {
  "id": "04114:0008",
  "jp": "そんなこともするの？",
  "en": ""
 },
 {
  "id": "04114:0009",
  "jp": "ふみゅ。\\n流石は$c02大逢魔$c00",
  "en": ""
 },
 {
  "id": "04114:0010",
  "jp": "あいつら、\\nそんなこともすんの？",
  "en": ""
 },
 {
  "id": "04114:0011",
  "jp": "僕らは、情報が\\n多いほど、上手く\\n調律できるからね",
  "en": ""
 },
 {
  "id": "04114:0012",
  "jp": "色々と見せたくは\\nないんだろうね",
  "en": ""
 },
 {
  "id": "04114:0013",
  "jp": "そんな……",
  "en": ""
 },
 {
  "id": "04114:0014",
  "jp": "なるほど……",
  "en": ""
 },
 {
  "id": "04114:0015",
  "jp": "なるほどね",
  "en": ""
 },
 {
  "id": "04114:0016",
  "jp": "でも、今みたいに\\nいくら隠そうとしても",
  "en": ""
 },
 {
  "id": "04114:0017",
  "jp": "変革した時間や事柄は\\n隠しきれないし",
  "en": ""
 },
 {
  "id": "04114:0018",
  "jp": "嘘の再演を見せる\\nなんてことはできない",
  "en": ""
 },
 {
  "id": "04114:0019",
  "jp": "うん、じゃあ、\\n私たちは、落ち着いて",
  "en": ""
 },
 {
  "id": "04114:0020",
  "jp": "ふみゅ。ならば\\n平素の通り、\\nこと進めると吉",
  "en": ""
 },
 {
  "id": "04114:0021",
  "jp": "まぁ、そんなら\\n話は早いわ",
  "en": ""
 },
 {
  "id": "04114:0022",
  "jp": "刻音を集めてけば\\nいいんだよね？",
  "en": ""
 },
 {
  "id": "04114:0023",
  "jp": "ダミー",
  "en": ""
 },
 {
  "id": "04114:0024",
  "jp": "アタシたちは、\\nキッチリ刻音集めれば\\nいいわけでしょ？",
  "en": ""
 },
 {
  "id": "04114:0025",
  "jp": "そういうことさ",
  "en": ""
 }
