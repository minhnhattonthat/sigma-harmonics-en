 {
  "id": "04282:0020",
  "jp": "はは……\\nまだ何かあるかね？",
  "en": ""
 },
 {
  "id": "04282:0021",
  "jp": "あるのならすぐに\\n見せるのだな、",
  "en": ""
 },
 {
  "id": "04282:0022",
  "jp": "さもなければ……",
  "en": ""
 },
 {
  "id": "04282:0023",
