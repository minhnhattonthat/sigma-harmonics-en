[
 {
  "id": "04282:0000",
  "jp": "……君はここまで\\n何をしに来たんだ？",
  "en": ""
 },
 {
  "id": "04282:0001",
  "jp": "お前を倒し、\\n僕の知っている\\n世界を取り戻す",
  "en": ""
 },
 {
  "id": "04282:0002",
  "jp": "そこに君は\\nいないのだぞ？",
  "en": ""
 },
 {
  "id": "04282:0003",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04282:0004",
  "jp": "世界が安定すれば\\n調律者は消える",
  "en": ""
 },
 {
  "id": "04282:0005",
  "jp": "君が取り戻すという\\n偽りの世界でも、",
  "en": ""
 },
 {
  "id": "04282:0006",
  "jp": "己が調律すべく時が\\n安定すれば君は消える",
  "en": ""
 },
 {
  "id": "04282:0007",
  "jp": "あの、もう１人の\\n女性体のようにな",
