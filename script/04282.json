 },
 {
  "id": "04282:0009",
  "jp": "僕は、\\nこの世界を否定する",
  "en": ""
 },
 {
  "id": "04282:0010",
  "jp": "シグマとしての\\n役目を放棄し、",
  "en": ""
 },
 {
  "id": "04282:0011",
  "jp": "この世界の\\nシグマである\\n私と戦うというのか？",
  "en": ""
 },
 {
  "id": "04282:0012",
  "jp": "あぁ",
  "en": ""
 },
 {
  "id": "04282:0013",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04282:0014",
  "jp": "此度の調律は\\nイレギュラーが多い",
  "en": ""
 },
 {
  "id": "04282:0015",
  "jp": "私の元となった\\n人間の時紡ぎから、",
  "en": ""
 },
 {
  "id": "04282:0016",
  "jp": "更に別の時が生まれ、",
  "en": ""
 },
 {
  "id": "04282:0017",
  "jp": "私以外のシグマが\\n複数生まれた",
