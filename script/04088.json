[
 {
  "id": "04088:0000",
  "jp": "……",
  "en": ""
 },
 {
  "id": "04088:0001",
  "jp": "ねね、\\nどうかしたのか？",
  "en": ""
 },
 {
  "id": "04088:0002",
  "jp": "何か、変……",
  "en": ""
 },
 {
  "id": "04088:0003",
  "jp": "変？",
  "en": ""
 },
 {
  "id": "04088:0004",
  "jp": "……",
  "en": ""
 },
 {
  "id": "04088:0005",
  "jp": "気のせいかも",
  "en": ""
 },
 {
  "id": "04088:0006",
  "jp": "大時計の異変だと、\\n大変なことだな",
  "en": ""
 },
 {
  "id": "04088:0007",
  "jp": "でも、普通みたいです",
  "en": ""
 },
 {
  "id": "04088:0008",
  "jp": "そうだな",
  "en": ""
 },
 {
  "id": "04088:0009",
  "jp": "ねねには、時の変革が\\n起きてしまった時、",
  "en": ""
 },
 {
  "id": "04088:0010",
  "jp": "どうしたらいいのか、\\n話したかな？",
  "en": ""
 },
 {
  "id": "04088:0011",
  "jp": "いいえ",
  "en": ""
 },
 {
  "id": "04088:0012",
  "jp": "ふむ、そうか\\nでは、話しておこう",
  "en": ""
 },
 {
  "id": "04088:0013",
  "jp": "ごく稀に、強大な力を\\nもった$c02逢魔$c00が生まれ、",
  "en": ""
 },
 {
  "id": "04088:0014",
  "jp": "その影響で、\\n時が書き変わって\\nしまう場合がある",
  "en": ""
 },
 {
  "id": "04088:0015",
  "jp": "そんなことが……？",
  "en": ""
 },
 {
  "id": "04088:0016",
  "jp": "ただし、書き変わった\\n時が安定するには、\\n時間がかかる",
  "en": ""
 },
 {
  "id": "04088:0017",
  "jp": "だから、\\n完全に書き変わって\\nしまう前に、",
  "en": ""
 },
 {
  "id": "04088:0018",
  "jp": "元凶である$c02逢魔$c00を\\n倒せば、時を元に戻す\\nことができるわけだ",
  "en": ""
 },
 {
  "id": "04088:0019",
  "jp": "父様なら、\\n簡単ですか？",
  "en": ""
 },
 {
  "id": "04088:0020",
  "jp": "いや、私でも、\\n時を書き変えるほどの\\n$c02逢魔$c00となると、",
  "en": ""
 },
 {
  "id": "04088:0021",
  "jp": "簡単には\\nいかないだろうな",
  "en": ""
 },
 {
  "id": "04088:0022",
  "jp": "じゃあ、\\nどうしたら？",
  "en": ""
 },
 {
  "id": "04088:0023",
  "jp": "まず、書き変わって\\nしまった事柄を、",
  "en": ""
 },
 {
  "id": "04088:0024",
  "jp": "１つ１つ\\n解きほぐすんだ",
  "en": ""
 },
 {
  "id": "04088:0025",
  "jp": "そうすることで、\\n$c02逢魔$c00の力を\\n弱めることができる",
  "en": ""
 },
 {
  "id": "04088:0026",
  "jp": "これを《時の調律》と\\n呼ぶんだよ",
  "en": ""
 },
 {
  "id": "04088:0027",
  "jp": "$c02逢魔$c00の力を弱めれば、\\n私でも倒せますか？",
  "en": ""
 },
 {
  "id": "04088:0028",
  "jp": "そうだな、\\nねねには、少し\\n早いかもしれないが",
  "en": ""
 },
 {
  "id": "04088:0029",
  "jp": "ちゃんと調律できれば、\\n倒せるかもしれんな",
  "en": ""
 },
 {
  "id": "04088:0030",
  "jp": "……これって、\\n今の私たちの\\n状況だよね？",
  "en": ""
 },
 {
  "id": "04088:0031",
  "jp": "私は、\\nしっかり戦うので",
  "en": ""
 },
 {
  "id": "04088:0032",
  "jp": "おー、ねねちゃん\\nやる気だねぇ",
  "en": ""
 },
 {
  "id": "04088:0033",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04088:0034",
  "jp": "シグマは\\nしっかり考える",
  "en": ""
 },
 {
  "id": "04088:0035",
  "jp": "アタシだって、若い頃は\\nガンガンいわしてた\\nもんよ",
  "en": ""
 },
 {
  "id": "04088:0036",
  "jp": "そして、静馬がいう通り\\n超推理で謎を\\n解き明かすほど、",
  "en": ""
 },
 {
  "id": "04088:0037",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04088:0038",
  "jp": "ガンガン何を\\nいってたんだ\\n君は",
  "en": ""
 },
 {
  "id": "04088:0039",
  "jp": "元凶となっている\\n$c02逢魔$c00の力を\\n弱めることができる",
  "en": ""
 },
 {
  "id": "04088:0040",
  "jp": "分不相応",
  "en": ""
 },
 {
  "id": "04088:0041",
  "jp": "というか、\\nまだ若いって",
  "en": ""
 },
 {
  "id": "04088:0042",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04088:0043",
  "jp": "い、いや、それは、\\n使い方違うと思う",
  "en": ""
 },
 {
  "id": "04088:0044",
  "jp": "でも、シグマと私が、\\nすっごく強かったら、",
  "en": ""
 },
 {
  "id": "04088:0045",
  "jp": "謎を解かなくても、\\n$c02逢魔$c00倒せちゃうよね？",
  "en": ""
 },
 {
  "id": "04088:0046",
  "jp": "はは、そうだね",
  "en": ""
 },
 {
  "id": "04088:0047",
  "jp": "ユリ子、\\nどこに行くんじゃ？",
  "en": ""
 },
 {
  "id": "04088:0048",
  "jp": "あ、はい、奥様の\\nワインを切らせて\\nいましたので……",
  "en": ""
 },
 {
  "id": "04088:0049",
  "jp": "外に、買いに\\n行くつもりかい？",
  "en": ""
 },
 {
  "id": "04088:0050",
  "jp": "ええ、ええ、\\nどうせ、わしは飲まん",
  "en": ""
 },
 {
  "id": "04088:0051",
  "jp": "え、でも……",
  "en": ""
 },
 {
  "id": "04088:0052",
  "jp": "そんなことよりも、",
  "en": ""
 },
 {
  "id": "04088:0053",
  "jp": "今日のお昼は、\\n赤茄子のスープを\\n作っておくれ",
  "en": ""
 },
 {
  "id": "04088:0054",
  "jp": "赤茄子……\\nトマトですか？",
  "en": ""
 },
 {
  "id": "04088:0055",
  "jp": "でも、トマトは……",
  "en": ""
 },
 {
  "id": "04088:0056",
  "jp": "ええんじゃ、\\nあの子も少しずつ、",
  "en": ""
 },
 {
  "id": "04088:0057",
  "jp": "好き嫌いを\\nなくさんといかんて",
  "en": ""
 },
 {
  "id": "04088:0058",
  "jp": "あ、これで、\\nユリ子さんは\\nねねちゃんが嫌いな",
  "en": ""
 },
 {
  "id": "04088:0059",
  "jp": "ふみゅ。なるほど、\\nこれで、ユリユリが\\nトマトにした理由判明",
  "en": ""
 },
 {
  "id": "04088:0060",
  "jp": "スープにすれば、飲める\\nってもんでも\\nないのにね",
  "en": ""
 },
 {
  "id": "04088:0061",
  "jp": "トマトのスープを\\n作ったのね？",
  "en": ""
 },
 {
  "id": "04088:0062",
  "jp": "ユリ子は、大婆のいう\\n通りに作っただけと",
  "en": ""
 },
 {
  "id": "04088:0063",
  "jp": "そうだね。\\nそれと、",
  "en": ""
 },
 {
  "id": "04088:0064",
  "jp": "大婆が普段から\\nワインを飲まないのも\\n確認できた",
  "en": ""
 },
 {
  "id": "04088:0065",
  "jp": "刻音を\\n生み出すほどじゃ\\nないみたいだけどね",
  "en": ""
 }
]
