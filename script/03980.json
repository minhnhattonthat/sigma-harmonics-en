[
 {
  "id": "03980:0000",
  "jp": "そんな……",
  "en": ""
 },
 {
  "id": "03980:0001",
  "jp": "ここは無事だと\\n思ったのに、中は\\nめちゃくちゃなんて",
  "en": ""
 },
 {
  "id": "03980:0002",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "03980:0003",
  "jp": "ねぇ、これって、\\nおかしすぎるよ！",
  "en": ""
 },
 {
  "id": "03980:0004",
  "jp": "シグマのお父様と\\nお母様を探して、",
  "en": ""
 },
 {
  "id": "03980:0005",
  "jp": "何が起こったのか\\n教えてもらおうよ",
  "en": ""
 },
 {
  "id": "03980:0006",
  "jp": "無駄だよ",
  "en": ""
 },
 {
  "id": "03980:0007",
  "jp": "えっ？",
  "en": ""
 },
 {
  "id": "03980:0008",
  "jp": "よく見て",
  "en": ""
 },
 {
  "id": "03980:0009",
  "jp": "あっ……",
  "en": ""
 },
 {
  "id": "03980:0010",
  "jp": "大時計……",
  "en": ""
 },
 {
  "id": "03980:0011",
  "jp": "あっ！　あっ……",
  "en": ""
 },
 {
  "id": "03980:0012",
  "jp": "そ、そうよ……\\nこんなの……\\nありえない……",
  "en": ""
 },
 {
  "id": "03980:0013",
  "jp": "神代の時代より、\\n僕ら黒上が守っている\\n封印……",
  "en": ""
 },
 {
  "id": "03980:0014",
  "jp": "その大時計までも\\n破壊されてるんだ……",
  "en": ""
 },
 {
  "id": "03980:0015",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "03980:0016",
  "jp": "やっぱり、そのせいで\\n【$c02逢魔$c00】が\\n外の世界にまで……",
  "en": ""
 },
 {
  "id": "03980:0017",
  "jp": "あぁ、こんなことは\\n僕の両親……",
  "en": ""
 },
 {
  "id": "03980:0018",
  "jp": "いや、使い人たちが\\nいるのなら\\n起こるはずがない",
  "en": ""
 },
 {
  "id": "03980:0019",
  "jp": "なんなの……\\n一体……",
  "en": ""
 },
 {
  "id": "03980:0020",
  "jp": "みんな\\n消えちゃったの？",
  "en": ""
 },
 {
  "id": "03980:0021",
  "jp": "何が起こってるの……",
  "en": ""
 },
 {
  "id": "03980:0022",
  "jp": "なんの光だ……？",
  "en": ""
 },
 {
  "id": "03980:0023",
  "jp": "なに！？",
  "en": ""
 },
 {
  "id": "03980:0024",
  "jp": "シグマ、\\n【音】を使って\\n調査してみよ",
  "en": ""
 },
 {
  "id": "03980:0025",
  "jp": "【調音査】か……",
  "en": ""
 },
 {
  "id": "03980:0026",
  "jp": "あぁ、\\nやってみよう",
  "en": ""
 },
 {
  "id": "03980:0027",
  "jp": "シグマは【音】を使い\\n調べた対象から\\n【刻音】を作りだせます",
  "en": ""
 },
 {
  "id": "03980:0028",
  "jp": "これを【調音査】\\nと呼びます",
  "en": ""
 },
 {
  "id": "03980:0029",
  "jp": "$c01メニューから\\n【調音査】\\nが選べるようになった$c00",
  "en": ""
 },
 {
  "id": "03980:0030",
  "jp": "【調音査】を選ぶと\\nタッチした場所を\\n調べることができます",
  "en": ""
 },
 {
  "id": "03980:0031",
  "jp": "$c01【用語集】に\\n【調音査】\\nが追加された$c00",
  "en": ""
 },
 {
  "id": "03980:0032",
  "jp": "空間が歪んでるのか？",
  "en": ""
 },
 {
  "id": "03980:0033",
  "jp": "くっ！\\n吸い込まれる？！",
  "en": ""
 },
 {
  "id": "03980:0034",
  "jp": "【空間の歪み】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "03980:0035",
  "jp": "えっ！えっ！えっ？！",
  "en": ""
 },
 {
  "id": "03980:0036",
  "jp": "ホールが消えちゃった！",
  "en": ""
 },
 {
  "id": "03980:0037",
  "jp": "ね、ねぇシグマ！\\nここって？！",
  "en": ""
 },
 {
  "id": "03980:0038",
  "jp": "分からない……",
  "en": ""
 },
 {
  "id": "03980:0039",
  "jp": "よし、\\n推理をしてみよう",
  "en": ""
 },
 {
  "id": "03980:0040",
  "jp": "今まで手に入れた\\n刻音を使えば【超推理】\\nができるはずだ",
  "en": ""
 },
 {
  "id": "03980:0041",
  "jp": "$c01メニューから\\n【超推理】\\nが選べるようになった$c00",
  "en": ""
 },
 {
  "id": "03980:0042",
  "jp": "【超推理】画面では\\n手に入れた【刻音】の\\n確認もできます",
  "en": ""
 },
 {
  "id": "03980:0043",
  "jp": "メニューから\\n【超推理】を選び\\n謎を解いてみましょう",
  "en": ""
 },
 {
  "id": "03980:0044",
  "jp": "$c01【用語集】に\\n【超推理】\\nが追加された$c00",
  "en": ""
 },
 {
  "id": "03980:0045",
  "jp": "ここは……",
  "en": ""
 },
 {
  "id": "03980:0046",
  "jp": "時の狭間……",
  "en": ""
 },
 {
  "id": "03980:0047",
  "jp": "時の狭間",
  "en": ""
 },
 {
  "id": "03980:0048",
  "jp": "？\\nときの……\\nはざま……？",
  "en": ""
 },
 {
  "id": "03980:0049",
  "jp": "時と時の隙間にある、\\n時間の流れから\\n切り離された異世界",
  "en": ""
 },
 {
  "id": "03980:0050",
  "jp": "時間という概念から\\n外れた同位要素を\\n含む世界を……",
  "en": ""
 },
 {
  "id": "03980:0051",
  "jp": "ん？？？？",
  "en": ""
 },
 {
  "id": "03980:0052",
  "jp": "そうだね、\\n単純に時間が\\n止まってる世界……",
  "en": ""
 },
 {
  "id": "03980:0053",
  "jp": "くらいの認識で\\nいいと思う",
  "en": ""
 },
 {
  "id": "03980:0054",
  "jp": "うん。\\nでも何もないね……",
  "en": ""
 },
 {
  "id": "03980:0055",
  "jp": "これは、僕らが世界を\\n認識するための\\n条件である、",
  "en": ""
 },
 {
  "id": "03980:0056",
  "jp": "【時】が定められて\\nいないからだね",
  "en": ""
 },
 {
  "id": "03980:0057",
  "jp": "ふ～ん",
  "en": ""
 },
 {
  "id": "03980:0058",
  "jp": "ネオン",
  "en": ""
 },
 {
  "id": "03980:0059",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "03980:0060",
  "jp": "ネオン、館の入口で\\n執事が言っていたこと\\n憶えてるかい？",
  "en": ""
 },
 {
  "id": "03980:0061",
  "jp": "うん、私たちのことを\\n知らないって感じで\\n変なこと言ってた",
  "en": ""
 },
 {
  "id": "03980:0062",
  "jp": "あれは、\\n変じゃないんだよ",
  "en": ""
 },
 {
  "id": "03980:0063",
  "jp": "彼のいる世界では",
  "en": ""
 },
 {
  "id": "03980:0064",
  "jp": "え？",
  "en": ""
 },
 {
  "id": "03980:0065",
  "jp": "彼の生まれた世界では、",
  "en": ""
 },
 {
  "id": "03980:0066",
  "jp": "五十年の間、\\n使い人は\\n存在しておらず、",
  "en": ""
 },
 {
  "id": "03980:0067",
  "jp": "もちろん、\\n僕との面識もない",
  "en": ""
 },
 {
  "id": "03980:0068",
  "jp": "どういうこと？",
  "en": ""
 },
 {
  "id": "03980:0069",
  "jp": "つまり、\\n過去という時が……",
  "en": ""
 },
 {
  "id": "03980:0070",
  "jp": "書き変わっている",
  "en": ""
 },
 {
  "id": "03980:0071",
  "jp": "……？",
  "en": ""
 },
 {
  "id": "03980:0072",
  "jp": "！？\\n時が……？？",
  "en": ""
 },
 {
  "id": "03980:0073",
  "jp": "な、何が\\n変わってるの？！",
  "en": ""
 },
 {
  "id": "03980:0074",
  "jp": "今までの状況から\\n導きだされる\\n結論はひとつ……",
  "en": ""
 },
 {
  "id": "03980:0075",
  "jp": "黒上一族、",
  "en": ""
 },
 {
  "id": "03980:0076",
  "jp": "いや、使い人たちの\\n$c02滅亡$c00",
  "en": ""
 },
 {
  "id": "03980:0077",
  "jp": "$c02滅亡$c00……？！",
  "en": ""
 },
 {
  "id": "03980:0078",
  "jp": "そ、そんな……",
  "en": ""
 },
 {
  "id": "03980:0079",
  "jp": "で、でも、シグマ",
  "en": ""
 },
 {
  "id": "03980:0080",
  "jp": "時を書き変えるなんて\\n簡単にできること\\nじゃないよ",
  "en": ""
 },
 {
  "id": "03980:0081",
  "jp": "そう、こんなことが\\nできるのは、\\nひどく限られる",
  "en": ""
 },
 {
  "id": "03980:0082",
  "jp": "僕ら……\\n黒上や月弓……\\nとかね",
  "en": ""
 },
 {
  "id": "03980:0083",
  "jp": "あっ！\\n思い出した！",
  "en": ""
 },
 {
  "id": "03980:0084",
  "jp": "黒上と月弓に\\n伝えられる古の秘術",
  "en": ""
 },
 {
  "id": "03980:0085",
  "jp": "封印されし狭間を使い\\n今ではない時を結ぶ",
  "en": ""
 },
 {
  "id": "03980:0086",
  "jp": "【時紡ぎの儀】！",
  "en": ""
 },
 {
  "id": "03980:0087",
  "jp": "あぁ、誰かが、大時計の\\n封印を解き、この狭間で\\n【時を紡いだ】",
  "en": ""
 },
 {
  "id": "03980:0088",
  "jp": "私たち……\\n一族の人間が……？",
  "en": ""
 },
 {
  "id": "03980:0089",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "03980:0090",
  "jp": "とにかく……",
  "en": ""
 },
 {
  "id": "03980:0091",
  "jp": "この狭間が\\n繋がる過去で、",
  "en": ""
 },
 {
  "id": "03980:0092",
  "jp": "一体、\\n何が起こったのか\\n調べてみよう",
  "en": ""
 },
 {
  "id": "03980:0093",
  "jp": "う、うん",
  "en": ""
 },
 {
  "id": "03980:0094",
  "jp": "まずは、\\nここを認識するために\\n時間を安定させないと",
  "en": ""
 },
 {
  "id": "03980:0095",
  "jp": "時間の安定？",
  "en": ""
 },
 {
  "id": "03980:0096",
  "jp": "それって、\\nその【時紡ぎ】でしょ？",
  "en": ""
 },
 {
  "id": "03980:0097",
  "jp": "そ、そんなの\\n私たちじゃ無理だよ",
  "en": ""
 },
 {
  "id": "03980:0098",
  "jp": "それくらい\\n大きな術だと",
  "en": ""
 },
 {
  "id": "03980:0099",
  "jp": "かなり強い\\n神霊とかいないと……",
  "en": ""
 },
 {
  "id": "03980:0100",
  "jp": "ネオン、この狭間に\\nいる神霊は？",
  "en": ""
 },
 {
  "id": "03980:0101",
  "jp": "ここで新しい\\n【式札】を\\n生みだせないかな？",
  "en": ""
 },
 {
  "id": "03980:0102",
  "jp": "…………？",
  "en": ""
 },
 {
  "id": "03980:0103",
  "jp": "……あっ！",
  "en": ""
 },
 {
  "id": "03980:0104",
  "jp": "うん、いくつか、\\n強い力がある",
  "en": ""
 },
 {
  "id": "03980:0105",
  "jp": "やってみる",
  "en": ""
 },
 {
  "id": "03980:0106",
  "jp": "我、月弓の名において\\n其らを求む者なり",
  "en": ""
 },
 {
  "id": "03980:0107",
  "jp": "古の盟約に従い\\n式なる札に\\n力を分け与え賜え",
  "en": ""
 },
 {
  "id": "03980:0108",
  "jp": "式力封神！！",
  "en": ""
 },
 {
  "id": "03980:0109",
  "jp": "何の準備もなかった\\nから、今の所は、\\nこれだけね",
  "en": ""
 },
 {
  "id": "03980:0110",
  "jp": "よし、まずは、\\nその札で時を\\n安定させてみよう",
  "en": ""
 },
 {
  "id": "03980:0111",
  "jp": "うん！",
  "en": ""
 },
 {
  "id": "03980:0112",
  "jp": "【時紡ぎ】……\\n時間は十二時？",
  "en": ""
 },
 {
  "id": "03980:0113",
  "jp": "初めてだったけど、\\nうまくいったね",
  "en": ""
 },
 {
  "id": "03980:0114",
  "jp": "まぁね",
  "en": ""
 },
 {
  "id": "03980:0115",
  "jp": "ただ僕らは、誰かが\\n繋げた道をなぞって",
  "en": ""
 },
 {
  "id": "03980:0116",
  "jp": "時間を安定させた\\nだけだからね",
  "en": ""
 },
 {
  "id": "03980:0117",
  "jp": "１からやるとなると、\\nこう簡単には\\nいかないさ",
  "en": ""
 },
 {
  "id": "03980:0118",
  "jp": "そうだよね。\\n黒上と月弓の秘中の秘、\\nだもんね",
  "en": ""
 },
 {
  "id": "03980:0119",
  "jp": "あぁ",
  "en": ""
 },
 {
  "id": "03980:0120",
  "jp": "！？",
  "en": ""
 },
 {
  "id": "03980:0121",
  "jp": "これって、過去が……\\n視えてきてるの？",
  "en": ""
 },
 {
  "id": "03980:0122",
  "jp": "あぁ、【時の再演】だ。\\nそしてこれが……",
  "en": ""
 },
 {
  "id": "03980:0123",
  "jp": "ねじ曲げられた\\n世界があげる、\\n最初の悲鳴……",
  "en": ""
 },
 {
  "id": "03980:0124",
  "jp": "【荒廃している館】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "03980:0125",
  "jp": "【空間の歪み】\\nの刻音を手に入れた！",
  "en": ""
 }
]
