[
 {
  "id": "04036:0000",
  "jp": "？\\n静馬様？",
  "en": ""
 },
 {
  "id": "04036:0001",
  "jp": "あぁ、ユリ子",
  "en": ""
 },
 {
  "id": "04036:0002",
  "jp": "食事ができたのか？",
  "en": ""
 },
 {
  "id": "04036:0003",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "04036:0004",
  "jp": "静馬様は、ここで？",
  "en": ""
 },
 {
  "id": "04036:0005",
  "jp": "いや、そろそろ\\n食事かと思ってね",
  "en": ""
 },
 {
  "id": "04036:0006",
  "jp": "少し早く、下りて\\nきてしまったようだ",
  "en": ""
 },
 {
  "id": "04036:0007",
  "jp": "ふふ、そうでしたか",
  "en": ""
 },
 {
  "id": "04036:0008",
  "jp": "お先にワインでも\\n召し上がりますか？",
  "en": ""
 },
 {
  "id": "04036:0009",
  "jp": "そうだな。\\nそうしてくれ",
  "en": ""
 },
 {
  "id": "04036:0010",
  "jp": "やっぱり、料理は\\nユリ子さんが作り、\\n配膳までしてるのね",
  "en": ""
 },
 {
  "id": "04036:0011",
  "jp": "ふみゅ、料理は\\nユリユリ自ら配膳",
  "en": ""
 },
 {
  "id": "04036:0012",
  "jp": "ねぇ、もしかして\\nユリ子って\\nヒメカゴさん？",
  "en": ""
 },
 {
  "id": "04036:0013",
  "jp": "そういえば、彼女って、\\nただのお手伝いさん\\nなのかな？",
  "en": ""
 },
 {
  "id": "04036:0014",
  "jp": "確認。\\nユリユリも使い人？",
  "en": ""
 },
 {
  "id": "04036:0015",
  "jp": "そうだね。\\n服に青いラインも\\n入ってるし、",
  "en": ""
 },
 {
  "id": "04036:0016",
  "jp": "いや、ただのお手伝いさん\\nではないよ",
  "en": ""
 },
 {
  "id": "04036:0017",
  "jp": "そうだね。着ている\\n服に青いラインが\\n入ってるから",
  "en": ""
 },
 {
  "id": "04036:0018",
  "jp": "姫籠家の人で\\n間違いないと思う",
  "en": ""
 },
 {
  "id": "04036:0019",
  "jp": "彼女の服に、青い色が\\n使われてるよね？",
  "en": ""
 },
 {
  "id": "04036:0020",
  "jp": "姫籠家かな？",
  "en": ""
 },
 {
  "id": "04036:0021",
  "jp": "ヒメカゴさんが\\n作るドーナッツ\\nおいしいのよねぇ",
  "en": ""
 },
 {
  "id": "04036:0022",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04036:0023",
  "jp": "ふみゅ。ヒメカゴか\\n確か、結界師？",
  "en": ""
 },
 {
  "id": "04036:0024",
  "jp": "あぁ、そうか、姫籠は\\n代々、黒上に\\n仕えてるから",
  "en": ""
 },
 {
  "id": "04036:0025",
  "jp": "ネオンも\\n知ってると思うけど、\\n使い人の中には",
  "en": ""
 },
 {
  "id": "04036:0026",
  "jp": "あぁ、【封使い】だ",
  "en": ""
 },
 {
  "id": "04036:0027",
  "jp": "ネオンの知ってる\\n姫籠さんも",
  "en": ""
 },
 {
  "id": "04036:0028",
  "jp": "それぞれ、\\nその家でしか使わない\\n色があるんだ",
  "en": ""
 },
 {
  "id": "04036:0029",
  "jp": "戦いにはでずに\\n代々、大時計の結界を\\n管理してる",
  "en": ""
 },
 {
  "id": "04036:0030",
  "jp": "時代は違うけど、\\n同じ家の人だね",
  "en": ""
 },
 {
  "id": "04036:0031",
  "jp": "あ、聞いたことある",
  "en": ""
 },
 {
  "id": "04036:0032",
  "jp": "その上、黒上の\\n家事全般も管理？",
  "en": ""
 },
 {
  "id": "04036:0033",
  "jp": "彼女って\\n大時計の結界も\\n守ってるんだっけ？",
  "en": ""
 },
 {
  "id": "04036:0034",
  "jp": "で、確か、\\n青は姫籠家だよ",
  "en": ""
 },
 {
  "id": "04036:0035",
  "jp": "まぁね。食事も彼女の\\n担当みたいだね",
  "en": ""
 },
 {
  "id": "04036:0036",
  "jp": "そう結界師。\\n【封使い】の一族だよ",
  "en": ""
 },
 {
  "id": "04036:0037",
  "jp": "ん？\\nヒメカゴさん？",
  "en": ""
 },
 {
  "id": "04036:0038",
  "jp": "結界を守りながら、\\n黒上家の家事全般を\\nこなすなんて、",
  "en": ""
 },
 {
  "id": "04036:0039",
  "jp": "あぁ、戦いには出ずに、",
  "en": ""
 },
 {
  "id": "04036:0040",
  "jp": "意外と\\nスーパーウーマンね",
  "en": ""
 },
 {
  "id": "04036:0041",
  "jp": "代々、黒上の家に仕え、\\n館を守っている\\nらしいね",
  "en": ""
 },
 {
  "id": "04036:0042",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04036:0043",
  "jp": "その上、家事全般まで\\nやってくれてるよ",
  "en": ""
 },
 {
  "id": "04036:0044",
  "jp": "それで、料理まで",
  "en": ""
 },
 {
  "id": "04036:0045",
  "jp": "黒上家、専属メイド\\nって感じね",
  "en": ""
 },
 {
  "id": "04036:0046",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04036:0047",
  "jp": "【静馬は居間に】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04036:0048",
  "jp": "【メイドが食事の準備】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04036:0049",
  "jp": "この事件で必要な\\n刻音は全て\\n集まったみたいだ",
  "en": ""
 },
 {
  "id": "04036:0050",
  "jp": "じゃあ……",
  "en": ""
 },
 {
  "id": "04036:0051",
  "jp": "ではでは",
  "en": ""
 },
 {
  "id": "04036:0052",
  "jp": "よし！\\nならなら",
  "en": ""
 },
 {
  "id": "04036:0053",
  "jp": "あぁ、超推理で\\nこの謎を解き明かそう",
  "en": ""
 },
 {
  "id": "04036:0054",
  "jp": "$c01メニューから\\n【超推理】を選び\\n闇を払ってください",
  "en": ""
 },
 {
  "id": "04036:0055",
  "jp": "$c01【用語集】に\\n《時の調律》\\nが追加された$c00",
  "en": ""
 },
 {
  "id": "04036:0056",
  "jp": "【時の調律】の話を\\nしますか？",
  "en": ""
 },
 {
  "id": "04036:0057",
  "jp": "※チュートリアル内で\\n予定している内容を\\nはじめます",
  "en": ""
 }
]
