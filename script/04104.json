[
 {
  "id": "04104:0000",
  "jp": "初めまして、譲葉です",
  "en": ""
 },
 {
  "id": "04104:0001",
  "jp": "みなさんしばらく\\nお付き合いください",
  "en": ""
 },
 {
  "id": "04104:0002",
  "jp": "大婆様より、\\n少しでも早い解決を\\nと頼まれましたので",
  "en": ""
 },
 {
  "id": "04104:0003",
  "jp": "こちらに、まとめて\\n集まって\\nいただきました",
  "en": ""
 },
 {
  "id": "04104:0004",
  "jp": "既に、\\n現場は拝見させて\\nいただきました",
  "en": ""
 },
 {
  "id": "04104:0005",
  "jp": "あとは、みなさんの\\nお話を聞けば、すぐに\\n真実は見えますわ",
  "en": ""
 },
 {
  "id": "04104:0006",
  "jp": "では、お一人ずつ、\\nお話をお願いします",
  "en": ""
 },
 {
  "id": "04104:0007",
  "jp": "まず、ユリ子さんが\\n発見された前後から\\nお伺いします……",
  "en": ""
 },
 {
  "id": "04104:0008",
  "jp": "では、ここにいた間、\\n通ったのは２人\\nだけなのですね？",
  "en": ""
 },
 {
  "id": "04104:0009",
  "jp": "はい、ユリ子さんが\\n２階にいったのと、",
  "en": ""
 },
 {
  "id": "04104:0010",
  "jp": "母様が２階から\\n下りてきただけです",
  "en": ""
 },
 {
  "id": "04104:0011",
  "jp": "その後、変な音が\\n聞こえたので\\n見に行ったら……",
  "en": ""
 },
 {
  "id": "04104:0012",
  "jp": "２階にいるはずの、\\nユリ子が、列車の中で\\n$c02死$c00んでいた",
  "en": ""
 },
 {
  "id": "04104:0013",
  "jp": "はい……",
  "en": ""
 },
 {
  "id": "04104:0014",
  "jp": "えぇ、私が探した時、\\nユリ子は部屋にも\\nいませんでした",
  "en": ""
 },
 {
  "id": "04104:0015",
  "jp": "わしも、みておらん",
  "en": ""
 },
 {
  "id": "04104:0016",
  "jp": "それで、大婆様から\\n鍵を借り、１階の厨へ\\n行ったのですね？",
  "en": ""
 },
 {
  "id": "04104:0017",
  "jp": "えぇ、そこで、\\nねねがホームへ\\n向かうのを見かけて",
  "en": ""
 },
 {
  "id": "04104:0018",
  "jp": "……\\nユリ子を見つけたわ",
  "en": ""
 },
 {
  "id": "04104:0019",
  "jp": "大婆様は、佳子さんへ\\n鍵を渡した後、\\n１人で部屋にいたと",
  "en": ""
 },
 {
  "id": "04104:0020",
  "jp": "そうじゃ",
  "en": ""
 },
 {
  "id": "04104:0021",
  "jp": "はい、旦那様に呼ばれ、\\n部屋へ行きました",
  "en": ""
 },
 {
  "id": "04104:0022",
  "jp": "その後は、旦那様と\\n娯楽室で、玉突きを\\nしておりました",
  "en": ""
 },
 {
  "id": "04104:0023",
  "jp": "ずっとですか……",
  "en": ""
 },
 {
  "id": "04104:0024",
  "jp": "いえ、途中、旦那様が\\n少し休憩をと\\n申しまして、",
  "en": ""
 },
 {
  "id": "04104:0025",
  "jp": "短い間ですが、\\n中断いたしました",
  "en": ""
 },
 {
  "id": "04104:0026",
  "jp": "次は、ご頭首のご遺体が\\n発見された時の\\nことを……",
  "en": ""
 },
 {
  "id": "04104:0027",
  "jp": "えぇ、確かに\\nユリ子の部屋には、\\n鍵がかかっていました",
  "en": ""
 },
 {
  "id": "04104:0028",
  "jp": "丁度、鍵をお借りした\\nままでしたので、開けて\\n中に入りましたら……",
  "en": ""
 },
 {
  "id": "04104:0029",
  "jp": "部屋の中央で、\\nご頭首が大の字に\\n倒れていたと……",
  "en": ""
 },
 {
  "id": "04104:0030",
  "jp": "すぐに\\n亡くなっていると……",
  "en": ""
 },
 {
  "id": "04104:0031",
  "jp": "あれだけ、派手にだと、\\n確認するまでも\\nないでしょう",
  "en": ""
 },
 {
  "id": "04104:0032",
  "jp": "まるで、未完成の絵に\\n最後の仕上げをした\\nようでしたわね",
  "en": ""
 },
 {
  "id": "04104:0033",
  "jp": "芙蓉……！",
  "en": ""
 },
 {
  "id": "04104:0034",
  "jp": "あら、失言でしたか？",
  "en": ""
 },
 {
  "id": "04104:0035",
  "jp": "続けましょう、\\nでは、大婆様は？",
  "en": ""
 },
 {
  "id": "04104:0036",
  "jp": "……わしは、\\n佳子の悲鳴を聞き、\\nユリ子の部屋に行った",
  "en": ""
 },
 {
  "id": "04104:0037",
  "jp": "そして、\\n佳子の向こうで\\n倒れとる静馬を……",
  "en": ""
 },
 {
  "id": "04104:0038",
  "jp": "私も、悲鳴を聞き、\\nしばらくの後、\\n奥様の元へ",
  "en": ""
 },
 {
  "id": "04104:0039",
  "jp": "その場へ着いたのは、\\n大婆様の後でした",
  "en": ""
 },
 {
  "id": "04104:0040",
  "jp": "ねねちゃんは……",
  "en": ""
 },
 {
  "id": "04104:0041",
  "jp": "それは、\\nどうでもいいわ",
  "en": ""
 },
 {
  "id": "04104:0042",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04104:0043",
  "jp": "面白いわね、誰も\\n偽を使っていないわ",
  "en": ""
 },
 {
  "id": "04104:0044",
  "jp": "確かに、誰の会話にも\\n嘘はないようです",
  "en": ""
 },
 {
  "id": "04104:0045",
  "jp": "そうよ、だから……",
  "en": ""
 },
 {
  "id": "04104:0046",
  "jp": "もう、全ては\\n見えたじゃない",
  "en": ""
 },
 {
  "id": "04104:0047",
  "jp": "はい、そうですね",
  "en": ""
 },
 {
  "id": "04104:0048",
  "jp": "！？",
  "en": ""
 },
 {
  "id": "04104:0049",
  "jp": "言の葉は、揺すられ、\\n真実は白日の下へ\\n現れました",
  "en": ""
 },
 {
  "id": "04104:0050",
  "jp": "さぁ、語りましょう\\nこの事件のあらましを",
  "en": ""
 },
 {
  "id": "04104:0051",
  "jp": "？！",
  "en": ""
 },
 {
  "id": "04104:0052",
  "jp": "ふみゅ？！",
  "en": ""
 },
 {
  "id": "04104:0053",
  "jp": "なっ！？",
  "en": ""
 },
 {
  "id": "04104:0054",
  "jp": "変革者の妨害\\nかもしれない……",
  "en": ""
 },
 {
  "id": "04104:0055",
  "jp": "よほど、この再演は\\n見られたくない\\nってことかな",
  "en": ""
 },
 {
  "id": "04104:0056",
  "jp": "ねぇ、今、譲葉さんが\\n言ってたことって\\n本当なの？",
  "en": ""
 },
 {
  "id": "04104:0057",
  "jp": "シグマ、あの親子が\\n言ってたことは事実？",
  "en": ""
 },
 {
  "id": "04104:0058",
  "jp": "ふーん。で、\\nあの２人が、言ってた\\nことってマジ？",
  "en": ""
 },
 {
  "id": "04104:0059",
  "jp": "そうだね、譲葉は、\\n言葉の真偽を見分ける",
  "en": ""
 },
 {
  "id": "04104:0060",
  "jp": "その譲葉が、彼らの\\n証言に嘘はないと\\n言っているのだし",
  "en": ""
 },
 {
  "id": "04104:0061",
  "jp": "確かに、僕らが\\n集めた刻音と矛盾する\\nところもなかった",
  "en": ""
 },
 {
  "id": "04104:0062",
  "jp": "全部が真実……",
  "en": ""
 },
 {
  "id": "04104:0063",
  "jp": "ふみゅ。\\n言い得てしかり\\n矛盾はない",
  "en": ""
 },
 {
  "id": "04104:0064",
  "jp": "なるほど",
  "en": ""
 },
 {
  "id": "04104:0065",
  "jp": "彼女は、全て見えた\\nとも言っていたわ",
  "en": ""
 },
 {
  "id": "04104:0066",
  "jp": "ならば……",
  "en": ""
 },
 {
  "id": "04104:0067",
  "jp": "じゃあ、話は早いわね",
  "en": ""
 },
 {
  "id": "04104:0068",
  "jp": "あぁ、つまり、僕らも、",
  "en": ""
 },
 {
  "id": "04104:0069",
  "jp": "もう、真実に\\n辿り着いているはずだ\\nということだね",
  "en": ""
 },
 {
  "id": "04104:0070",
  "jp": "……よし、\\n超推理をしてみよう！",
  "en": ""
 },
 {
  "id": "04104:0071",
  "jp": "【佳子だけが通った】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04104:0072",
  "jp": "【休憩を挟んだ２人】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04104:0073",
  "jp": "静馬の提案で休憩\\nの刻音を手に入れた\\n（仮）",
  "en": ""
 },
 {
  "id": "04104:0074",
  "jp": "ユリ子の行方\\nの刻音を手に入れた\\n（仮）",
  "en": ""
 }
]
