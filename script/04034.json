[
 {
  "id": "04034:0000",
  "jp": "ユリ子さん？",
  "en": ""
 },
 {
  "id": "04034:0001",
  "jp": "はい、奥様\\nご用でしょうか？",
  "en": ""
 },
 {
  "id": "04034:0002",
  "jp": "そのスープ、\\n少し、味見しても\\nいいかしら？",
  "en": ""
 },
 {
  "id": "04034:0003",
  "jp": "あ、はい、どうぞ",
  "en": ""
 },
 {
  "id": "04034:0004",
  "jp": "じゃあ、\\nいただくわね",
  "en": ""
 },
 {
  "id": "04034:0005",
  "jp": "あら、やっぱり\\nトマトなのね？",
  "en": ""
 },
 {
  "id": "04034:0006",
  "jp": "はい、大婆様から……",
  "en": ""
 },
 {
  "id": "04034:0007",
  "jp": "どうした？",
  "en": ""
 },
 {
  "id": "04034:0008",
  "jp": "いえ、スープが\\nトマトなのね？",
  "en": ""
 },
 {
  "id": "04034:0009",
  "jp": "って話を\\nユリ子さんと……",
  "en": ""
 },
 {
  "id": "04034:0010",
  "jp": "……トマト？",
  "en": ""
 },
 {
  "id": "04034:0011",
  "jp": "ねねは、トマトが\\n嫌いだった\\nはずだが？",
  "en": ""
 },
 {
  "id": "04034:0012",
  "jp": "……作り直せんのか？",
  "en": ""
 },
 {
  "id": "04034:0013",
  "jp": "なんでも、大婆様の\\nご指示だそうよ",
  "en": ""
 },
 {
  "id": "04034:0014",
  "jp": "すみません……",
  "en": ""
 },
 {
  "id": "04034:0015",
  "jp": "そうか……",
  "en": ""
 },
 {
  "id": "04034:0016",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04034:0017",
  "jp": "そういえば\\nあなたは、一体\\n何しにいらしたの？",
  "en": ""
 },
 {
  "id": "04034:0018",
  "jp": "あぁ、ワインを\\n決めたのでな、\\n持ってきただけだ",
  "en": ""
 },
 {
  "id": "04034:0019",
  "jp": "ちょうどよかったわ",
  "en": ""
 },
 {
  "id": "04034:0020",
  "jp": "それ、私も\\nいただきますわね",
  "en": ""
 },
 {
  "id": "04034:0021",
  "jp": "ん？\\n赤だがいいのかね？",
  "en": ""
 },
 {
  "id": "04034:0022",
  "jp": "お前は、白しか\\n飲まないと\\n思っていたが",
  "en": ""
 },
 {
  "id": "04034:0023",
  "jp": "白が全部、切れて\\nしまったのよ",
  "en": ""
 },
 {
  "id": "04034:0024",
  "jp": "ねぇ、ユリ子さん",
  "en": ""
 },
 {
  "id": "04034:0025",
  "jp": "すみません……",
  "en": ""
 },
 {
  "id": "04034:0026",
  "jp": "普通の会話だね……",
  "en": ""
 },
 {
  "id": "04034:0027",
  "jp": "白ワインと赤ワイン、\\nよっちゃんは、\\n食事ではなく",
  "en": ""
 },
 {
  "id": "04034:0028",
  "jp": "あー、アタシも\\nトマト嫌いだぁー",
  "en": ""
 },
 {
  "id": "04034:0029",
  "jp": "とてもこの後に、\\n$c02殺人$c00が起こる\\nようにみえない……",
  "en": ""
 },
 {
  "id": "04034:0030",
  "jp": "好みだけで、\\n選んでるふう？",
  "en": ""
 },
 {
  "id": "04034:0031",
  "jp": "でも、ハンバーグに\\n入ってると\\n食べれるのよね",
  "en": ""
 },
 {
  "id": "04034:0032",
  "jp": "それに、ケチャップは\\nオッケーだけど\\nジュースもダメね",
  "en": ""
 },
 {
  "id": "04034:0033",
  "jp": "うーん、そうだわ\\nトマトとドーナッツ\\nって、どうなんだろ？",
  "en": ""
 },
 {
  "id": "04034:0034",
  "jp": "そうだね……",
  "en": ""
 },
 {
  "id": "04034:0035",
  "jp": "そうだね。\\n日本人は多いんじゃ\\nないかな？",
  "en": ""
 },
 {
  "id": "04034:0036",
  "jp": "でも、何かと合わせれば\\n意味を持つ\\nかもしれない",
  "en": ""
 },
 {
  "id": "04034:0037",
  "jp": "ふみゅ。\\n私はどちらかと言うと\\n……",
  "en": ""
 },
 {
  "id": "04034:0038",
  "jp": "会話のいくつかを\\n刻音にしておこう",
  "en": ""
 },
 {
  "id": "04034:0039",
  "jp": "未成年の飲酒は\\n法律で禁じられて\\nいます",
  "en": ""
 },
 {
  "id": "04034:0040",
  "jp": "さ、さぁ？",
  "en": ""
 },
 {
  "id": "04034:0041",
  "jp": "【ワイン】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04034:0042",
  "jp": "【厨の佳子】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04034:0043",
  "jp": "この事件で必要な\\n刻音は全て\\n集まったみたいだ",
  "en": ""
 },
 {
  "id": "04034:0044",
  "jp": "じゃあ……",
  "en": ""
 },
 {
  "id": "04034:0045",
  "jp": "ではでは",
  "en": ""
 },
 {
  "id": "04034:0046",
  "jp": "よし！\\nならなら",
  "en": ""
 },
 {
  "id": "04034:0047",
  "jp": "あぁ、超推理で\\nこの謎を解き明かそう",
  "en": ""
 },
 {
  "id": "04034:0048",
  "jp": "メニューから\\n【超推理】を選び\\n闇を払ってください",
  "en": ""
 },
 {
  "id": "04034:0049",
  "jp": "$c01【用語集】に\\n《時の調律》\\nが追加された$c00",
  "en": ""
 },
 {
  "id": "04034:0050",
  "jp": "【時の調律】の話を\\nしますか？",
  "en": ""
 },
 {
  "id": "04034:0051",
  "jp": "※チュートリアル内で\\n予定している内容を\\nはじめます",
  "en": ""
 }
]
