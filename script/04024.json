 },
 {
  "id": "04024:0001",
  "jp": "鍵がかかってるわ……",
  "en": ""
 },
 {
  "id": "04024:0002",
  "jp": "マスターキーは……",
  "en": ""
 },
 {
  "id": "04024:0003",
  "jp": "あっ、私が借りてたわね",
  "en": ""
 },
 {
  "id": "04024:0004",
  "jp": "シグマの家って、\\nどの部屋にも\\n鍵があるの？",
  "en": ""
 },
 {
  "id": "04024:0005",
  "jp": "シグマ家、\\nどの部屋も鍵付き？",
  "en": ""
 },
 {
  "id": "04024:0006",
  "jp": "アンタんちって、\\nどの部屋も鍵が\\nついてんの？",
  "en": ""
 },
 {
  "id": "04024:0007",
  "jp": "そうだよ",
  "en": ""
 },
 {
  "id": "04024:0008",
  "jp": "広い家だし、\\n分家の客人が\\n使うこともあるしね",
  "en": ""
 },
 {
  "id": "04024:0009",
  "jp": "ただ、あまり使ってる\\n記憶はないね",
  "en": ""
 },
 {
  "id": "04024:0010",
  "jp": "じゃあ、\\nここの鍵とかも、\\nみんな持ってるの？",
  "en": ""
 },
 {
  "id": "04024:0011",
  "jp": "みんな、鍵持って\\n鍵、一杯。\\n見分けるの大変？",
  "en": ""
 },
 {
  "id": "04024:0012",
  "jp": "ふーん、みんな\\n自分の部屋の鍵、\\n持ってんの？",
  "en": ""
 },
 {
  "id": "04024:0013",
  "jp": "いや、大体は\\n内からかけるだけだよ",
  "en": ""
 },
 {
  "id": "04024:0014",
  "jp": "外から開けるための\\nマスターキーは、\\n家に１つしかないよ",
  "en": ""
 },
 {
  "id": "04024:0015",
  "jp": "この時は佳子が\\n持っていたみたいだね",
  "en": ""
 },
 {
  "id": "04024:0016",
  "jp": "確認なんだけど、\\nマスターキーって\\n館に１個だけなの？",
