[
 {
  "id": "04296:0000",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04296:0001",
  "jp": "…停電のようです",
  "en": ""
 },
 {
  "id": "04296:0002",
  "jp": "馬鹿な！\\n黒上館で停電など",
  "en": ""
 },
 {
  "id": "04296:0003",
  "jp": "扉の開く音",
  "en": ""
 },
 {
  "id": "04296:0004",
  "jp": "$c02うぎゃーーーーー",
  "en": ""
 },
 {
  "id": "04296:0005",
  "jp": "扉の閉まる音",
  "en": ""
 },
 {
  "id": "04296:0006",
  "jp": "今のは？",
  "en": ""
 },
 {
  "id": "04296:0007",
  "jp": "この部屋の中から……",
  "en": ""
 },
 {
  "id": "04296:0008",
  "jp": "ドアをガチャガチャ\\n言わせる音",
  "en": ""
 },
 {
  "id": "04296:0009",
  "jp": "鍵がかかっています",
  "en": ""
 },
 {
  "id": "04296:0010",
  "jp": "そんな",
  "en": ""
 },
 {
  "id": "04296:0011",
  "jp": "扉を壊します！",
  "en": ""
 },
 {
  "id": "04296:0012",
  "jp": "$c02死$c00んでいる",
  "en": ""
 },
 {
  "id": "04296:0013",
  "jp": "$c02絞殺$c00ですな",
  "en": ""
 },
 {
  "id": "04296:0014",
  "jp": "鍵がかかって\\nいたのに……",
  "en": ""
 },
 {
  "id": "04296:0015",
  "jp": "密室という訳か",
  "en": ""
 },
 {
  "id": "04296:0016",
  "jp": "ここに\\nマスターキーが……",
  "en": ""
 },
 {
  "id": "04296:0017",
  "jp": "これですね",
  "en": ""
 },
 {
  "id": "04296:0018",
  "jp": "でも、壊れていて\\n使えません",
  "en": ""
 },
 {
  "id": "04296:0019",
  "jp": "そうですね",
  "en": ""
 },
 {
  "id": "04296:0020",
  "jp": "これじゃあ\\n差し込むことも\\nできませんね",
  "en": ""
 },
 {
  "id": "04296:0021",
  "jp": "$c02密室殺人$c00だね",
  "en": ""
 },
 {
  "id": "04296:0022",
  "jp": "でも、\\n扉の音がしたよね！",
  "en": ""
 },
 {
  "id": "04296:0023",
  "jp": "ギイギイ、闇の中で\\n蠢く扉の音してた",
  "en": ""
 },
 {
  "id": "04296:0024",
  "jp": "でも、扉の音はしてた\\nじゃない",
  "en": ""
 },
 {
  "id": "04296:0025",
  "jp": "ああ、密室といっても\\n本当の密室じゃない",
  "en": ""
 },
 {
  "id": "04296:0026",
  "jp": "必ず、\\nどこかにトリックが\\nあるはずだ",
  "en": ""
 },
 {
  "id": "04296:0027",
  "jp": "もう１個、\\n竹さんの部屋の\\n鍵があるとか？",
  "en": ""
 },
 {
  "id": "04296:0028",
  "jp": "小婆ちゃんの部屋、\\n別に鍵がある？",
  "en": ""
 },
 {
  "id": "04296:0029",
  "jp": "竹の部屋だけ、別の鍵が\\nあったりしないの？",
  "en": ""
 },
 {
  "id": "04296:0030",
  "jp": "残念ながら\\n黒上館の鍵は、",
  "en": ""
 },
 {
  "id": "04296:0031",
  "jp": "マスターキーと\\n客室の部屋の鍵\\nだけだよ",
  "en": ""
 },
 {
  "id": "04296:0032",
  "jp": "部屋の内側からなら\\n鍵をかけることは\\nできるけどね",
  "en": ""
 },
 {
  "id": "04296:0033",
  "jp": "うーん？",
  "en": ""
 },
 {
  "id": "04296:0034",
  "jp": "ふみゅ",
  "en": ""
 },
 {
  "id": "04296:0035",
  "jp": "ふーん？",
  "en": ""
 },
 {
  "id": "04296:0036",
  "jp": "まずは刻音を集めて、\\n１つずつ\\n超推理していこう",
  "en": ""
 },
 {
  "id": "04296:0037",
  "jp": "【鍵のかかった扉】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04296:0038",
  "jp": "【壊れたキー】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04296:0039",
  "jp": "超推理に\\n「密室殺人」\\nに関する闇が現れた！",
  "en": ""
 }
]
