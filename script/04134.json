[
 {
  "id": "04134:0000",
  "jp": "イベント制作中",
  "en": ""
 },
 {
  "id": "04134:0001",
  "jp": "ゆう？\\n何見てるの？",
  "en": ""
 },
 {
  "id": "04134:0002",
  "jp": "ん～、てんとうむし",
  "en": ""
 },
 {
  "id": "04134:0003",
  "jp": "あ、ほんとだ",
  "en": ""
 },
 {
  "id": "04134:0004",
  "jp": "こんな地下でも、\\nてんとうむし、\\n来るんだね",
  "en": ""
 },
 {
  "id": "04134:0005",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04134:0006",
  "jp": "あ、おねえちゃん、\\n後で、また\\n占いしてくれる？",
  "en": ""
 },
 {
  "id": "04134:0007",
  "jp": "ん、いいわよ",
  "en": ""
 },
 {
  "id": "04134:0008",
  "jp": "ゆう君は、\\nねねちゃんの弟さん？",
  "en": ""
 },
 {
  "id": "04134:0009",
  "jp": "ゆーっちは、\\nねねっちの弟？",
  "en": ""
 },
 {
  "id": "04134:0010",
  "jp": "ゆうって、\\nねねの弟みたいね",
  "en": ""
 },
 {
  "id": "04134:0011",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04134:0012",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04134:0013",
  "jp": "はてな？",
  "en": ""
 },
 {
  "id": "04134:0014",
  "jp": "あれ？\\nし～ぐま～？",
  "en": ""
 },
 {
  "id": "04134:0015",
  "jp": "あ、ごめん、ちょっと、\\nぼーっとしちゃった\\nみたいだ",
  "en": ""
 },
 {
  "id": "04134:0016",
  "jp": "そうだね、\\n彼はねねの弟みたいだ",
  "en": ""
 },
 {
  "id": "04134:0017",
  "jp": "ねぇ、\\n気になったんだけど、",
  "en": ""
 },
 {
  "id": "04134:0018",
  "jp": "少し疑問",
  "en": ""
 },
 {
  "id": "04134:0019",
  "jp": "ところでさ、少し\\n気になってるんだけど",
  "en": ""
 },
 {
  "id": "04134:0020",
  "jp": "だんだん、黒上の人、\\n増えてきてない？",
  "en": ""
 },
 {
  "id": "04134:0021",
  "jp": "黒上の人間、\\n少しずつ増えてる",
  "en": ""
 },
 {
  "id": "04134:0022",
  "jp": "なんか、少しずつ\\n黒上の関係者、\\n増えてきてない？",
  "en": ""
 },
 {
  "id": "04134:0023",
  "jp": "恐らくなんだけど、",
  "en": ""
 },
 {
  "id": "04134:0024",
  "jp": "いくつもの歴史改変が\\n行われているうちに、",
  "en": ""
 },
 {
  "id": "04134:0025",
  "jp": "歴史そのものから、",
  "en": ""
 },
 {
  "id": "04134:0026",
  "jp": "消えてしまった\\n人がいたんじゃ\\nないかな？",
  "en": ""
 },
 {
  "id": "04134:0027",
  "jp": "あの黒衣の男も、\\n最初に現れた時、",
  "en": ""
 },
 {
  "id": "04134:0028",
  "jp": "『無限の$c02死$c00が\\n　渦巻いている』と\\nいう言い方をしていた",
  "en": ""
 },
 {
  "id": "04134:0029",
  "jp": "それこそが、\\n変革者の狙い\\nなのかもしれない……",
  "en": ""
 },
 {
  "id": "04134:0030",
  "jp": "そんな……",
  "en": ""
 },
 {
  "id": "04134:0031",
  "jp": "由々しきじたい",
  "en": ""
 },
 {
  "id": "04134:0032",
  "jp": "なるほどね……",
  "en": ""
 },
 {
  "id": "04134:0033",
  "jp": "でも、こうやって、\\n過去の人が増えてきた\\nということは",
  "en": ""
 },
 {
  "id": "04134:0034",
  "jp": "歴史の歪みが\\n減っている……という\\nことだと思うよ",
  "en": ""
 },
 {
  "id": "04134:0035",
  "jp": "だからこれは……",
  "en": ""
 },
 {
  "id": "04134:0036",
  "jp": "歪みの終わりに\\n近づいてる証拠と\\n思いたいね",
  "en": ""
 },
 {
  "id": "04134:0037",
  "jp": "うん、分かった",
  "en": ""
 },
 {
  "id": "04134:0038",
  "jp": "了解",
  "en": ""
 },
 {
  "id": "04134:0039",
  "jp": "おっけ～、\\n前向きに考えましょ",
  "en": ""
 },
 {
  "id": "04134:0040",
  "jp": "【ゆうとねね】\\nの刻音を手に入れた！",
  "en": ""
 }
]
