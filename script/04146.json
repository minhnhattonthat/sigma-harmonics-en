[
 {
  "id": "04146:0000",
  "jp": "イベント制作中",
  "en": ""
 },
 {
  "id": "04146:0001",
  "jp": "お茶をお持ちしました",
  "en": ""
 },
 {
  "id": "04146:0002",
  "jp": "そこに置いとくれ",
  "en": ""
 },
 {
  "id": "04146:0003",
  "jp": "大婆様の分は、\\nどういたしましょう？",
  "en": ""
 },
 {
  "id": "04146:0004",
  "jp": "一緒に、\\n置いとけばえぇ",
  "en": ""
 },
 {
  "id": "04146:0005",
  "jp": "さっき、\\n代わったばかりなんで、",
  "en": ""
 },
 {
  "id": "04146:0006",
  "jp": "しばらく、\\n目覚めんと思うがの",
  "en": ""
 },
 {
  "id": "04146:0007",
  "jp": "？　新しい、\\n漢方ですか？",
  "en": ""
 },
 {
  "id": "04146:0008",
  "jp": "あぁ、そうじゃ、\\nそこにある草じゃ、",
  "en": ""
 },
 {
  "id": "04146:0009",
  "jp": "先日、守人に\\n買ってきてもろうた",
  "en": ""
 },
 {
  "id": "04146:0010",
  "jp": "良い物なんじゃが、\\n手入れが面倒でな、",
  "en": ""
 },
 {
  "id": "04146:0011",
  "jp": "１日でも、\\n水をやるのを忘れると",
  "en": ""
 },
 {
  "id": "04146:0012",
  "jp": "枯れてしまいおる",
  "en": ""
 },
 {
  "id": "04146:0013",
  "jp": "それは、大変ですね",
  "en": ""
 },
 {
  "id": "04146:0014",
  "jp": "大婆様と、竹さんは、\\nこの間と同じ？",
  "en": ""
 },
 {
  "id": "04146:0015",
  "jp": "婆ちゃんと小婆ちゃん\\nこの間と同じか？",
  "en": ""
 },
 {
  "id": "04146:0016",
  "jp": "大婆と竹は、\\nこの間と同じよね？",
  "en": ""
 },
 {
  "id": "04146:0017",
  "jp": "そうだね、必ず\\nどちらかは、眠りに\\nついてるみたいだね",
  "en": ""
 },
 {
  "id": "04146:0018",
  "jp": "あれ？\\n彼女は大婆様じゃ？",
  "en": ""
 },
 {
  "id": "04146:0019",
  "jp": "はてな？　婆ちゃん、\\n婆ちゃんじゃない？",
  "en": ""
 },
 {
  "id": "04146:0020",
  "jp": "ややや？　大婆って、\\n彼女じゃないの？",
  "en": ""
 },
 {
  "id": "04146:0021",
  "jp": "……違うみたいだね\\n入れ替わりで寝ている\\nと言ってたね",
  "en": ""
 },
 {
  "id": "04146:0022",
  "jp": "さっきの時間で見た\\nもう１人の方が\\n大婆だろうね",
  "en": ""
 },
 {
  "id": "04146:0023",
  "jp": "そうだ、\\n他の時間でみた\\n枯れかけてた植木、",
  "en": ""
 },
 {
  "id": "04146:0024",
  "jp": "ふみゅ。\\n先ほど見た枯れ木",
  "en": ""
 },
 {
  "id": "04146:0025",
  "jp": "あ、ねぇねぇ。\\n他の時間でみた\\n枯れ木ってさ",
  "en": ""
 },
 {
  "id": "04146:0026",
  "jp": "この話で言っている\\n草のことだよね？",
  "en": ""
 },
 {
  "id": "04146:0027",
  "jp": "ここで言っている\\n珍しい草のこと？",
  "en": ""
 },
 {
  "id": "04146:0028",
  "jp": "今言ってた、守人が\\n買ってきたって草\\nじゃない？",
  "en": ""
 },
 {
  "id": "04146:0029",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04146:0030",
  "jp": "そうか、\\nお婆さんが亡くなって、",
  "en": ""
 },
 {
  "id": "04146:0031",
  "jp": "ふみゅ。\\n婆ちゃん$c02死$c00んで\\n水が切れた？",
  "en": ""
 },
 {
  "id": "04146:0032",
  "jp": "なるほどね。\\nすぐ枯れるって\\n言ってたから",
  "en": ""
 },
 {
  "id": "04146:0033",
  "jp": "水をあげなかったから\\n枯れてきてたんだ……",
  "en": ""
 },
 {
  "id": "04146:0034",
  "jp": "ダミー",
  "en": ""
 },
 {
  "id": "04146:0035",
  "jp": "この後、水が切れて\\n枯れたってわけか",
  "en": ""
 },
 {
  "id": "04146:0036",
  "jp": "【竹の作った漢方薬】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04146:0037",
  "jp": "【竹の作る漢方薬】\\nの刻音を手に入れた！",
  "en": ""
 }
]
