[
 {
  "id": "04228:0000",
  "jp": "誰です",
  "en": ""
 },
 {
  "id": "04228:0001",
  "jp": "あ、僕は黒上シ……",
  "en": ""
 },
 {
  "id": "04228:0002",
  "jp": "黒上？",
  "en": ""
 },
 {
  "id": "04228:0003",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04228:0004",
  "jp": "いいわ、\\n黒上ならばね",
  "en": ""
 },
 {
  "id": "04228:0005",
  "jp": "お客様なんて久しぶり。\\nお茶、入れるわね",
  "en": ""
 },
 {
  "id": "04228:0006",
  "jp": "あの……どうして、\\n僕を……？",
  "en": ""
 },
 {
  "id": "04228:0007",
  "jp": "？　黒上なのでしょ？\\n時を渡った",
  "en": ""
 },
 {
  "id": "04228:0008",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04228:0009",
  "jp": "まだ若いのにね……",
  "en": ""
 },
 {
  "id": "04228:0010",
  "jp": "この時代の私は、\\n掟に従い、あなたには\\n何も問いません",
  "en": ""
 },
 {
  "id": "04228:0011",
  "jp": "でも、あなたは何か\\n聞きたいことがあって",
  "en": ""
 },
 {
  "id": "04228:0012",
  "jp": "姿を現したのでしょ？",
  "en": ""
 },
 {
  "id": "04228:0013",
  "jp": "……この世界で\\n何が起こって\\nいるのですか？",
  "en": ""
 },
 {
  "id": "04228:0014",
  "jp": "……あなたが、\\nその若さで",
  "en": ""
 },
 {
  "id": "04228:0015",
  "jp": "どこまで黒上を\\n知っているのか\\n分からないけど、",
  "en": ""
 },
 {
  "id": "04228:0016",
  "jp": "ここは、私たちが\\n時の調律者に敗北しつつ\\nある世界です",
  "en": ""
 },
 {
  "id": "04228:0017",
  "jp": "調律者に敗北……？",
  "en": ""
 },
 {
  "id": "04228:0018",
  "jp": "えぇ、私たちが\\n築いてきた歴史は\\n全て消えてしまった……",
  "en": ""
 },
 {
  "id": "04228:0019",
  "jp": "もう使い人もほとんど\\n残っていないわ",
  "en": ""
 },
 {
  "id": "04228:0020",
  "jp": "今は、守人と、\\n黒上の現頭首が\\n戦っているだけ……",
  "en": ""
 },
 {
  "id": "04228:0021",
  "jp": "……ネオン……\\nいえ、ネオンさんは？",
  "en": ""
 },
 {
  "id": "04228:0022",
  "jp": "音音？\\nあなた、音音を\\n知っているのね？",
  "en": ""
 },
 {
  "id": "04228:0023",
  "jp": "でも、\\nあなたの見た子は\\n音音じゃないわ",
  "en": ""
 },
 {
  "id": "04228:0024",
  "jp": "美巫女、\\nでてらっしゃい",
  "en": ""
 },
 {
  "id": "04228:0025",
  "jp": "この子は音音の孫よ",
  "en": ""
 },
 {
  "id": "04228:0026",
  "jp": "あなたが、どの《時》の\\n音音を知っているのか\\n分からないけど、",
  "en": ""
 },
 {
  "id": "04228:0027",
  "jp": "あの子は、\\nもうずいぶん前に、\\nゆうを庇って車に……",
  "en": ""
 },
 {
  "id": "04228:0028",
  "jp": "えっ……？",
  "en": ""
 },
 {
  "id": "04228:0029",
  "jp": "今までより、はっきり\\n聞こえる車の音",
  "en": ""
 },
 {
  "id": "04228:0030",
  "jp": "ネオンに突き飛ばされる\\nその後でクラッシュ音",
  "en": ""
 },
 {
  "id": "04228:0031",
  "jp": "昔から\\n未来を見通すような\\nところがあってね",
  "en": ""
 },
 {
  "id": "04228:0032",
  "jp": "まるで、ゆうが事故に\\n遭うのを知って\\nいたかのように……",
  "en": ""
 },
 {
  "id": "04228:0033",
  "jp": "そうよね、\\nこの子は本当に\\nねねにそっくりだわ",
  "en": ""
 },
 {
  "id": "04228:0034",
  "jp": "あの子の持っていた\\n不思議な力も……",
  "en": ""
 },
 {
  "id": "04228:0035",
  "jp": "美巫女の力は、\\nいつか来る誰かのため\\nなのよね？",
  "en": ""
 },
 {
  "id": "04228:0036",
  "jp": "うん、でも……",
  "en": ""
 },
 {
  "id": "04228:0037",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04228:0038",
  "jp": "なんでもない",
  "en": ""
 },
 {
  "id": "04228:0039",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04228:0040",
  "jp": "佳子さん、黒上の\\n頭首は今どこに？",
  "en": ""
 },
 {
  "id": "04228:0041",
  "jp": "ゆうは今も調律者と\\n戦っています",
  "en": ""
 },
 {
  "id": "04228:0042",
  "jp": "守人に\\n列車をだすように\\n言っておきましょう",
  "en": ""
 },
 {
  "id": "04228:0043",
  "jp": "彼に案内して\\nもらいなさいな",
  "en": ""
 },
 {
  "id": "04228:0044",
  "jp": "はい、\\nありがとうございます",
  "en": ""
 },
 {
  "id": "04228:0045",
  "jp": "君の持っている力は、",
  "en": ""
 },
 {
  "id": "04228:0046",
  "jp": "きっと、大切なものを\\n守るための力だね……",
  "en": ""
 },
 {
  "id": "04228:0047",
  "jp": "待ってて、",
  "en": ""
 },
 {
  "id": "04228:0048",
  "jp": "君がそれを\\n成せるように",
  "en": ""
 },
 {
  "id": "04228:0049",
  "jp": "僕も、僕ができる\\nことを探してみる",
  "en": ""
 },
 {
  "id": "04228:0050",
  "jp": "あの子は、\\nゆうの若い頃に\\nそっくりね……",
  "en": ""
 }
]
