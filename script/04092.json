[
 {
  "id": "04092:0000",
  "jp": "お呼びでしょうか？",
  "en": ""
 },
 {
  "id": "04092:0001",
  "jp": "これから、\\n時間はあるか？",
  "en": ""
 },
 {
  "id": "04092:0002",
  "jp": "はい、一体？",
  "en": ""
 },
 {
  "id": "04092:0003",
  "jp": "この間の続きだ、\\n先日は、邪魔が入って",
  "en": ""
 },
 {
  "id": "04092:0004",
  "jp": "最後まで\\nできなかっただろう",
  "en": ""
 },
 {
  "id": "04092:0005",
  "jp": "あぁ、\\n玉突きですね",
  "en": ""
 },
 {
  "id": "04092:0006",
  "jp": "ふっ、私の方が上だと、\\nハッキリさせてやるよ",
  "en": ""
 },
 {
  "id": "04092:0007",
  "jp": "はは、\\n今度は負けませんよ",
  "en": ""
 },
 {
  "id": "04092:0008",
  "jp": "では、\\nさっそく、始めよう",
  "en": ""
 },
 {
  "id": "04092:0009",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "04092:0010",
  "jp": "玉突き？",
  "en": ""
 },
 {
  "id": "04092:0011",
  "jp": "空中の玉を\\n華麗にアタック",
  "en": ""
 },
 {
  "id": "04092:0012",
  "jp": "私のこれにも、\\n弾は付いてるわよ",
  "en": ""
 },
 {
  "id": "04092:0013",
  "jp": "ビリヤードのことだよ",
  "en": ""
 },
 {
  "id": "04092:0014",
  "jp": "そんなゲームはないよ。\\nビリヤードのことだね",
  "en": ""
 },
 {
  "id": "04092:0015",
  "jp": "いや、玉だから。\\nビリヤードのことだね",
  "en": ""
 },
 {
  "id": "04092:0016",
  "jp": "館の東にある大部屋で\\n２人がやってただろ？",
  "en": ""
 },
 {
  "id": "04092:0017",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04092:0018",
  "jp": "ふみゅ",
  "en": ""
 },
 {
  "id": "04092:0019",
  "jp": "あぁ、あれね",
  "en": ""
 },
 {
  "id": "04092:0020",
  "jp": "じゃあ、この後から\\nずっとしてたのかな？",
  "en": ""
 },
 {
  "id": "04092:0021",
  "jp": "ではでは、この後\\nずっと、玉突きか？",
  "en": ""
 },
 {
  "id": "04092:0022",
  "jp": "ってことは、\\nあの２人、この時から\\nずっとあそこに？",
  "en": ""
 },
 {
  "id": "04092:0023",
  "jp": "これだけじゃ、\\n分からないけどね",
  "en": ""
 },
 {
  "id": "04092:0024",
  "jp": "館のどこかに\\nあるんじゃないかな？",
  "en": ""
 },
 {
  "id": "04092:0025",
  "jp": "【誘ったのは静馬】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04092:0026",
  "jp": "ユリ子$c02殺害$c00に関する\\n刻音は揃ったかも\\nしれない",
  "en": ""
 },
 {
  "id": "04092:0027",
  "jp": "超推理を進めてみよう",
  "en": ""
 },
 {
  "id": "04092:0028",
  "jp": "超推理をしてみよう",
  "en": ""
 }
