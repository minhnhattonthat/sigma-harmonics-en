[
 {
  "id": "04250:0000",
  "jp": "おじゃまするね",
  "en": ""
 },
 {
  "id": "04250:0001",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04250:0002",
  "jp": "ゆう君は？",
  "en": ""
 },
 {
  "id": "04250:0003",
  "jp": "おびえ疲れたのか、\\n寝てしまいました",
  "en": ""
 },
 {
  "id": "04250:0004",
  "jp": "もう、\\n聞いたと思うけど、",
  "en": ""
 },
 {
  "id": "04250:0005",
  "jp": "佳子さんも\\n亡くなられた……",
  "en": ""
 },
 {
  "id": "04250:0006",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04250:0007",
  "jp": "悲鳴が聞こえた時、\\n何かみたり聞いたり\\nしなかったかい？",
  "en": ""
 },
 {
  "id": "04250:0008",
  "jp": "……びっくりして、\\n外をのぞいた時に、",
  "en": ""
 },
 {
  "id": "04250:0009",
  "jp": "あなたのお母さんが、\\nそこの廊下にいました",
  "en": ""
 },
 {
  "id": "04250:0010",
  "jp": "こんな無線機を\\n持ってた？",
  "en": ""
 },
 {
  "id": "04250:0011",
  "jp": "はい、それと同じのを\\n持ってました",
  "en": ""
 },
 {
  "id": "04250:0012",
  "jp": "うん、ありがとう",
  "en": ""
 },
 {
  "id": "04250:0013",
  "jp": "君の言の葉に、\\n揺らぎはない",
  "en": ""
 },
 {
  "id": "04250:0014",
  "jp": "つまり、僕の母は、",
  "en": ""
 },
 {
  "id": "04250:0015",
  "jp": "佳子さんの悲鳴が\\n聞こえた時、\\nこの部屋の前にいた",
  "en": ""
 },
 {
  "id": "04250:0016",
  "jp": "娯楽室で、話を聞いた\\n時も、母の言の葉に\\n揺らぎはなかった",
  "en": ""
 },
 {
  "id": "04250:0017",
  "jp": "むしろ、あの時、\\n他の２人の\\n言の葉には、",
  "en": ""
 },
 {
  "id": "04250:0018",
  "jp": "小さいけど、\\n確かな揺らぎが\\nあった……",
  "en": ""
 },
 {
  "id": "04250:0019",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04250:0020",
  "jp": "ねね、少しいいか？",
  "en": ""
 },
 {
  "id": "04250:0021",
  "jp": "あっ、はい",
  "en": ""
 },
 {
  "id": "04250:0022",
  "jp": "麟君の\\nお母さんには、犯行は\\n不可能ってこと？",
  "en": ""
 },
 {
  "id": "04250:0023",
  "jp": "ふみゅ。\\nねねっちは、\\n嘘をつかない",
  "en": ""
 },
 {
  "id": "04250:0024",
  "jp": "譲葉親子には、\\n犯行が不可能と\\nそゆこと？",
  "en": ""
 },
 {
  "id": "04250:0025",
  "jp": "話の通り、受け取ると\\nそうだろうね",
  "en": ""
 },
 {
  "id": "04250:0026",
  "jp": "だろうね。\\n話の通り、受け取って\\n問題ないだろう",
  "en": ""
 },
 {
  "id": "04250:0027",
  "jp": "そうだね、ねねが\\n嘘をつく理由はないし",
  "en": ""
 },
 {
  "id": "04250:0028",
  "jp": "ねねが、ここで嘘をつく\\n理由もあるはずがない",
  "en": ""
 },
 {
  "id": "04250:0029",
  "jp": "ダミー",
  "en": ""
 },
 {
  "id": "04250:0030",
  "jp": "麟と麟の母には、\\nそれぞれ、\\n不在証明がある",
  "en": ""
 },
 {
  "id": "04250:0031",
  "jp": "それに、麟君が、\\n言の葉に揺らぎは\\nないって、",
  "en": ""
 },
 {
  "id": "04250:0032",
  "jp": "ダミー",
  "en": ""
 },
 {
  "id": "04250:0033",
  "jp": "ということに\\n間違いはないだろうね",
  "en": ""
 },
 {
  "id": "04250:0034",
  "jp": "つまり嘘じゃない\\nってことでしょ？",
  "en": ""
 },
 {
  "id": "04250:0035",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04250:0036",
  "jp": "【麟の母を見たねね】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04250:0037",
  "jp": "【ゆうとねねのアリバイ】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04250:0038",
  "jp": "【２人の言葉に揺らぎ】\\nの刻音を手に入れた！",
  "en": ""
 }
]
