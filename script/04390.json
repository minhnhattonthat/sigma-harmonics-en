 {
  "id": "04390:0687",
  "jp": "思考の闇91",
  "en": ""
 },
 {
  "id": "04390:0688",
  "jp": "時を「渡り」、歴史に\\n直接介入していた人物",
  "en": ""
 },
 {
  "id": "04390:0689",
  "jp": "思考の闇92",
  "en": ""
 },
 {
  "id": "04390:0690",
  "jp": "時折、歴史そのものから\\n存在自体が消えてしまう人物",
  "en": ""
 },
 {
  "id": "04390:0691",
  "jp": "未定義",
  "en": ""
 },
