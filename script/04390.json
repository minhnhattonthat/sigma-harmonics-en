 },
 {
  "id": "04390:0597",
  "jp": "思考の闇46",
  "en": ""
 },
 {
  "id": "04390:0598",
  "jp": "ユリ子が死亡したのは銃声より前？\\n答えはＹＥＳ・ＮＯ",
