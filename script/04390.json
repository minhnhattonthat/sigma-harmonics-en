 },
 {
  "id": "04390:0589",
  "jp": "思考の闇42",
  "en": ""
 },
 {
  "id": "04390:0590",
  "jp": "静馬の死亡に関する\\n刻音をまとめてみよう",
  "en": ""
 },
 {
  "id": "04390:0591",
  "jp": "思考の闇43",
  "en": ""
 },
 {
  "id": "04390:0592",
  "jp": "執事の死亡に関する\\n刻音をまとめてみよう",
