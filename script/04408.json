[
 {
  "id": "04408:0000",
  "jp": "ねじ曲げられた時間が、\\n僕に助けを求め",
  "en": ""
 },
 {
  "id": "04408:0001",
  "jp": "真実の欠片を残して\\nくれているようだ",
  "en": ""
 },
 {
  "id": "04408:0002",
  "jp": "ここでは、手に入れた\\n【真実の手がかり】を\\n確認できる",
  "en": ""
 },
 {
  "id": "04408:0003",
  "jp": "ここで、手がかりを\\n確認して、超推理に挑む\\nのもいいかもしれない",
  "en": ""
 },
 {
  "id": "04408:0004",
  "jp": "ここでは、\\n再推理の必要はないぞ",
  "en": ""
 },
 {
  "id": "04408:0005",
  "jp": "刻音は\\n全て奏でられている",
  "en": ""
 },
 {
  "id": "04408:0006",
  "jp": "そうか……",
  "en": ""
 },
 {
  "id": "04408:0007",
  "jp": "！？\\nそうか……",
  "en": ""
 },
 {
  "id": "04408:0008",
  "jp": "刻音は全て奏でられた\\n真実を解き明かそう…",
  "en": ""
 },
 {
  "id": "04408:0009",
  "jp": "本当に推理を\\nしなおすのなら",
  "en": ""
 },
 {
  "id": "04408:0010",
  "jp": "もう１度、再推理\\nボタンをタッチしよう",
  "en": ""
 },
 {
  "id": "04408:0011",
  "jp": "この闇は、\\nまだ生まれていない。\\n先に他の闇を払おう",
  "en": ""
 },
 {
  "id": "04408:0012",
  "jp": "既に\\nこの闇は払われている\\n次に進もう",
  "en": ""
 },
 {
  "id": "04408:0013",
  "jp": "刻音は\\n全て奏でられている",
  "en": ""
 },
 {
  "id": "04408:0014",
  "jp": "もう１度、奏でなおす\\nなら、再推理を選ぼう",
  "en": ""
 },
 {
  "id": "04408:0015",
  "jp": "ねねの証言は本当\\nの刻音を生みだした\\n（仮）",
  "en": ""
 },
 {
  "id": "04408:0016",
  "jp": "２階から落とされた\\nの刻音を手に入れた\\n（仮）",
