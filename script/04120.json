 },
 {
  "id": "04120:0042",
  "jp": "【神降ろしの変更】",
  "en": ""
 },
 {
  "id": "04120:0043",
  "jp": "戦闘中、\\n右上の「神」のボタンを\\nタッチすることで、",
  "en": ""
 },
 {
  "id": "04120:0044",
  "jp": "ネオンに降ろす\\n神（ネオンの姿）を",
  "en": ""
 },
 {
  "id": "04120:0045",
  "jp": "変更することが\\nできます",
  "en": ""
 },
 {
  "id": "04120:0046",
  "jp": "ボタンをタッチし、\\n絵柄を切り替えた\\n状態で",
  "en": ""
 },
 {
  "id": "04120:0047",
  "jp": "ゲージが溜まるまで\\n待ち",
