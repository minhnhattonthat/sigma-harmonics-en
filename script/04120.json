  "en": ""
 },
 {
  "id": "04120:0049",
  "jp": "降ろした神が\\n変更されると同時に",
  "en": ""
 },
 {
  "id": "04120:0050",
  "jp": "式札が３箇所のうちの\\nどこに配置されるかが\\n変化します",
  "en": ""
 },
 {
  "id": "04120:0051",
  "jp": "また、神降ろしの変更は、\\nフィールドメニューの",
  "en": ""
 },
 {
  "id": "04120:0052",
  "jp": "「神降」からも\\n行うことができます",
  "en": ""
 }
