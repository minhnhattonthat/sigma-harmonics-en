[
 {
  "id": "04674:0000",
  "jp": "$c02大逢魔$c00だ！！\\n来るぞ！",
  "en": ""
 },
 {
  "id": "04674:0001",
  "jp": "おや、まだ調律の\\n済んでいない闇が\\nあるようですね",
  "en": ""
 },
 {
  "id": "04674:0002",
  "jp": "こんな状態では\\nお相手をするわけには\\nいきませんよ",
  "en": ""
 },
 {
  "id": "04674:0003",
  "jp": "逃げたわ！",
  "en": ""
 },
 {
  "id": "04674:0004",
  "jp": "スタコラ仮面？",
  "en": ""
 },
 {
  "id": "04674:0005",
  "jp": "ちょっと、\\n待ちなさいよ！",
  "en": ""
 },
 {
  "id": "04674:0006",
  "jp": "仕方がない、\\n全ての時間の$c02大逢魔$c00を\\n倒して出直そう",
  "en": ""
 },
 {
  "id": "04674:0007",
  "jp": "歴史の改変を\\n邪魔するのは\\n貴方ですか？",
  "en": ""
 },
 {
  "id": "04674:0008",
  "jp": "ああ、\\n黒上シグマの名に懸けて",
  "en": ""
 },
 {
  "id": "04674:0009",
  "jp": "改変は阻止させて\\nもらう",
  "en": ""
 },
 {
  "id": "04674:0010",
  "jp": "私も忘れないでね",
  "en": ""
 },
 {
  "id": "04674:0011",
  "jp": "私も一緒",
  "en": ""
 },
 {
  "id": "04674:0012",
  "jp": "アタシも居るわよ",
  "en": ""
 },
 {
  "id": "04674:0013",
  "jp": "いいでしょう、\\nどちらが歴史の\\n決定者になるか",
  "en": ""
 },
 {
  "id": "04674:0014",
  "jp": "勝負です！",
  "en": ""
 },
 {
  "id": "04674:0015",
  "jp": "おや",
  "en": ""
 },
 {
  "id": "04674:0016",
  "jp": "ま・た・も・や",
  "en": ""
 },
 {
  "id": "04674:0017",
  "jp": "貴方たちですか",
  "en": ""
 },
 {
  "id": "04674:0018",
  "jp": "懲りもせず、\\n私の邪魔をするとは\\n許せませんねぇ",
  "en": ""
 },
 {
  "id": "04674:0019",
  "jp": "言ったはずだ、\\n改変は阻止すると",
  "en": ""
 },
 {
  "id": "04674:0020",
  "jp": "年上に向かって\\nお行儀が悪いですね",
  "en": ""
 },
 {
  "id": "04674:0021",
  "jp": "どうやら躾が\\n必要ですな",
  "en": ""
 },
 {
  "id": "04674:0022",
  "jp": "クックックッ",
  "en": ""
 },
 {
  "id": "04674:0023",
  "jp": "飽きもせず\\nまたもや来ましたね\\nシグマ君",
  "en": ""
 },
 {
  "id": "04674:0024",
  "jp": "貴方の推理力には\\n脱帽しますよ",
  "en": ""
 },
 {
  "id": "04674:0025",
  "jp": "お前が諦めるまで\\n何度でも闇を払い",
  "en": ""
 },
 {
  "id": "04674:0026",
  "jp": "歴史の流れを\\n正常に戻させて\\nもらうよ",
  "en": ""
 },
 {
  "id": "04674:0027",
  "jp": "クックックッ",
  "en": ""
 },
 {
  "id": "04674:0028",
  "jp": "正常……\\n何が正常ですか",
  "en": ""
 },
 {
  "id": "04674:0029",
  "jp": "貴方がですか？\\n笑わせてくれますね",
  "en": ""
 },
 {
  "id": "04674:0030",
  "jp": "正常な歴史、それは\\nこれから作る\\n歴史なのですよ",
  "en": ""
 },
 {
  "id": "04674:0031",
  "jp": "さあ、勝負です！",
  "en": ""
 },
 {
  "id": "04674:0032",
  "jp": "いい加減、\\nしつこいですね",
  "en": ""
 },
 {
  "id": "04674:0033",
  "jp": "貴方の顔は\\n見飽きましたよ",
  "en": ""
 },
 {
  "id": "04674:0034",
  "jp": "そして、\\nオマケの\\nお嬢ちゃんもね",
  "en": ""
 },
 {
  "id": "04674:0035",
  "jp": "誰が、オマケですって",
  "en": ""
 },
 {
  "id": "04674:0036",
  "jp": "刺身で言えばツマふう？",
  "en": ""
 },
 {
  "id": "04674:0037",
  "jp": "オマケとは何よ！",
  "en": ""
 },
 {
  "id": "04674:0038",
  "jp": "超推理もできない、\\n戦うだけの存在じゃ\\nないですか",
  "en": ""
 },
 {
  "id": "04674:0039",
  "jp": "何ですってぇぇぇ！",
  "en": ""
 },
 {
  "id": "04674:0040",
  "jp": "行くよ、シグマ！",
  "en": ""
 },
 {
  "id": "04674:0041",
  "jp": "ふみゅ？",
  "en": ""
 },
 {
  "id": "04674:0042",
  "jp": "シグマ、仮面が仮面\\n着けられない\\n身体にしてあげよう",
  "en": ""
 },
 {
  "id": "04674:0043",
  "jp": "あったまきた！",
  "en": ""
 },
 {
  "id": "04674:0044",
  "jp": "シグマ！\\nコイツやっちゃおう！",
  "en": ""
 },
 {
  "id": "04674:0045",
  "jp": "あ、はいはい",
  "en": ""
 },
 {
  "id": "04674:0046",
  "jp": "そろそろ本気で\\n相手をしないと",
  "en": ""
 },
 {
  "id": "04674:0047",
  "jp": "いけないかも\\nしれませんね",
  "en": ""
 },
 {
  "id": "04674:0048",
  "jp": "いつでも、どうぞ",
  "en": ""
 },
 {
  "id": "04674:0049",
  "jp": "負けないんだからね",
  "en": ""
 },
 {
  "id": "04674:0050",
  "jp": "シグマと私、相性ピッタリ。\\n常勝コンビ",
  "en": ""
 },
 {
  "id": "04674:0051",
  "jp": "あんたなんかに\\n負けないわよー",
  "en": ""
 },
 {
  "id": "04674:0052",
  "jp": "そうですか、\\n本当にそうですか？",
  "en": ""
 },
 {
  "id": "04674:0053",
  "jp": "勿論！",
  "en": ""
 },
 {
  "id": "04674:0054",
  "jp": "肯定",
  "en": ""
 },
 {
  "id": "04674:0055",
  "jp": "あったり前よ！",
  "en": ""
 },
 {
  "id": "04674:0056",
  "jp": "負けたことがないと\\n言い切る！",
  "en": ""
 },
 {
  "id": "04674:0057",
  "jp": "そんな戯言、\\nもう言えないように\\nしてあげましょう",
  "en": ""
 },
 {
  "id": "04674:0058",
  "jp": "もう何回目でしょうね",
  "en": ""
 },
 {
  "id": "04674:0059",
  "jp": "私も面倒臭く\\nなってきましたよ",
  "en": ""
 },
 {
  "id": "04674:0060",
  "jp": "僕もだよ",
  "en": ""
 },
 {
  "id": "04674:0061",
  "jp": "そこだけは、同意見だね",
  "en": ""
 },
 {
  "id": "04674:0062",
  "jp": "そろそろケリを\\nつけましょうか？",
  "en": ""
 },
 {
  "id": "04674:0063",
  "jp": "驚いた！\\nそれも同意見だ",
  "en": ""
 },
 {
  "id": "04674:0064",
  "jp": "馬鹿にすると\\n許しませんよ！",
  "en": ""
 },
 {
  "id": "04674:0065",
  "jp": "どう許さないのか\\n教えてもらおうかな",
  "en": ""
 },
 {
  "id": "04674:0066",
  "jp": "貴様！\\nなぜ、邪魔をする！\\nなぜだ、わからん！",
  "en": ""
 },
 {
  "id": "04674:0067",
  "jp": "真実の歴史は\\n１つしかない",
  "en": ""
 },
 {
  "id": "04674:0068",
  "jp": "お前の歴史と\\n僕の歴史",
  "en": ""
 },
 {
  "id": "04674:0069",
  "jp": "生き残るのは\\n一方だけだ",
  "en": ""
 },
 {
  "id": "04674:0070",
  "jp": "宿命の戦い、\\nとでもいうのか",
  "en": ""
 },
 {
  "id": "04674:0071",
  "jp": "そんなところかな",
  "en": ""
 },
 {
  "id": "04674:0072",
  "jp": "私の作った\\n新しい歴史……",
  "en": ""
 },
 {
  "id": "04674:0073",
  "jp": "これ以上の破壊は\\n許しません",
  "en": ""
 },
 {
  "id": "04674:0074",
  "jp": "それは、そちらの解釈",
  "en": ""
 },
 {
  "id": "04674:0075",
  "jp": "僕たちにしてみれば\\n壊された歴史を\\n修復しているだけさ",
  "en": ""
 },
 {
  "id": "04674:0076",
  "jp": "嘘をつくな！",
  "en": ""
 },
 {
  "id": "04674:0077",
  "jp": "そんなのは、\\n嘘、嘘、嘘、嘘、嘘！",
  "en": ""
 },
 {
  "id": "04674:0078",
  "jp": "貴様らは、歴史を\\n破壊している！",
  "en": ""
 },
 {
  "id": "04674:0079",
  "jp": "正しい歴史を……\\n許さん……",
  "en": ""
 },
 {
  "id": "04674:0080",
  "jp": "怒ってる？",
  "en": ""
 },
 {
  "id": "04674:0081",
  "jp": "仮面、頭キテる？",
  "en": ""
 },
 {
  "id": "04674:0082",
  "jp": "もしかして、\\n怒っちゃった？",
  "en": ""
 },
 {
  "id": "04674:0083",
  "jp": "みたいだね、気をつけて",
  "en": ""
 },
 {
  "id": "04674:0084",
  "jp": "何故だ！\\n私の歴史を！",
  "en": ""
 },
 {
  "id": "04674:0085",
  "jp": "何故だ！",
  "en": ""
 },
 {
  "id": "04674:0086",
  "jp": "正しい歴史を、\\n何故間違った歴史に\\n変えるのだ！",
  "en": ""
 },
 {
  "id": "04674:0087",
  "jp": "もう終わりだ",
  "en": ""
 },
 {
  "id": "04674:0088",
  "jp": "最後だよ～ん",
  "en": ""
 },
 {
  "id": "04674:0089",
  "jp": "おしまい",
  "en": ""
 },
 {
  "id": "04674:0090",
  "jp": "終わりよ～ん",
  "en": ""
 },
 {
  "id": "04674:0091",
  "jp": "そうか…わかった！",
  "en": ""
 },
 {
  "id": "04674:0092",
  "jp": "間違っているのは\\n貴様の存在\\nその小娘の存在",
  "en": ""
 },
 {
  "id": "04674:0093",
  "jp": "そう、\\n間違った歴史に\\nなるのは、",
  "en": ""
 },
 {
  "id": "04674:0094",
  "jp": "間違った存在が\\nあるから",
  "en": ""
 },
 {
  "id": "04674:0095",
  "jp": "もしかして",
  "en": ""
 },
 {
  "id": "04674:0096",
  "jp": "話、聞いてない",
  "en": ""
 },
 {
  "id": "04674:0097",
  "jp": "仮面……",
  "en": ""
 },
 {
  "id": "04674:0098",
  "jp": "脳内世界に旅行中？",
  "en": ""
 },
 {
  "id": "04674:0099",
  "jp": "あれ、もしかして",
  "en": ""
 },
 {
  "id": "04674:0100",
  "jp": "聞こえてない？",
  "en": ""
 },
 {
  "id": "04674:0101",
  "jp": "そうみたいだね",
  "en": ""
 },
 {
  "id": "04674:0102",
  "jp": "$c02逢魔$c00に憑かれ、\\n魔を刺されてる\\nわけだけど……",
  "en": ""
 },
 {
  "id": "04674:0103",
  "jp": "限界を超えちゃった\\nみたいだね",
  "en": ""
 },
 {
  "id": "04674:0104",
  "jp": "貴様ーーーーー",
  "en": ""
 },
 {
  "id": "04674:0105",
  "jp": "倒す・倒す・倒すぞ！",
  "en": ""
 },
 {
  "id": "04674:0106",
  "jp": "そして、正しい歴史を～",
  "en": ""
 }
]
