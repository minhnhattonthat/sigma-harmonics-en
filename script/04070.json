 },
 {
  "id": "04070:0007",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04070:0008",
  "jp": "くっくっくっ……\\nははは……\\nははははははははは！",
  "en": "Kukuku... Hahaha... Hahahahahahahaha!"
 },
 {
  "id": "04070:0009",
  "jp": "ふふふ……\\nふふふふ……\\nあはははははははは！",
  "en": "Fufufu... Fufufufu... Ahahahahahahaha!"
 },
 {
  "id": "04070:0010",
  "jp": "こいつは面白ぇ！",
  "en": "Now this is rich!"
 },
 {
  "id": "04070:0011",
  "jp": "傑作だわ",
  "en": "Priceless."
 },
 {
  "id": "04070:0012",
  "jp": "黒上のシグマ様\\nと来たか！！",
  "en": "So it's Sigma-sama of the Kurogami, is it!!"
 },
 {
  "id": "04070:0013",
  "jp": "くっ！　ネオン！！\\n式札の力を解放！",
  "en": "Ngh! Neon!! Release the power of the Shiki Cards!"
 },
 {
  "id": "04070:0014",
  "jp": "封印の扉と\\nこの場所を繋げる！！",
  "en": "Connect the door of the seal to this place!!"
 },
 {
  "id": "04070:0015",
  "jp": "はい！！",
  "en": "Right!!"
 },
 {
  "id": "04070:0016",
  "jp": "我が奏でるは真の音、\\n旋律を標とし\\n道を開け！！",
  "en": "I play the true sound; with the melody as my guide, open the way!!"
 },
 {
  "id": "04070:0017",
  "jp": "シグマ！\\n狭間が消滅する！",
  "en": "Sigma! The Rift is vanishing!"
 },
 {
  "id": "04070:0018",
  "jp": "元の時間に\\n戻らないと！！",
  "en": "We have to get back to our own time!!"
 },
 {
  "id": "04070:0019",
  "jp": "分かってる！！",
  "en": "I know!!"
 },
 {
  "id": "04070:0020",
  "jp": "黒上シグマ！！",
  "en": "Sigma Kurogami!!"
 },
 {
  "id": "04070:0021",
  "jp": "？！",
  "en": ""
 },
 {
  "id": "04070:0022",
  "jp": "また逢おう",
  "en": "We shall meet again..."
 },
 {
  "id": "04070:0023",
  "jp": "$c02逢魔が時$c00にね……",
  "en": "at the $c02Hour of Ouma$c00..."
 },
 {
  "id": "04070:0024",
  "jp": "ふふ……",
  "en": "Heh heh..."
 },
 {
  "id": "04070:0025",
  "jp": "ははははははは！！",
  "en": "Hahahahahaha!!"
 },
 {
  "id": "04070:0026",
  "jp": "シグマ！",
  "en": "Sigma!"
 },
 {
  "id": "04070:0027",
  "jp": "終わった……かな",
  "en": "Is it... over?"
 },
 {
  "id": "04070:0028",
  "jp": "$c02逢魔人$c00も\\n封印できたはずだ",
  "en": "The $c02Ouma-born$c00 should be sealed now, too."
 },
 {
  "id": "04070:0029",
  "jp": "ネオン……？",
  "en": "Neon...?"
 },
 {
  "id": "04070:0030",
  "jp": "……ネオン？",
  "en": "...Neon?"
 },
 {
  "id": "04070:0031",
  "jp": "……ごめんね",
  "en": "...I'm sorry."
 },
 {
  "id": "04070:0032",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04070:0033",
  "jp": "くっ！！\\nまだなのか？！",
  "en": "Ngh!! It's still not over?!"
 },
 {
  "id": "04070:0034",
  "jp": "ネオン！！！",
  "en": "Neon!!!"
 },
 {
  "id": "04070:0035",
  "jp": "ぽたり……\\n　（仮）\\nエフェクト予定",
  "en": "Drip... (temp) Effect planned"
 },
 {
  "id": "04070:0036",
  "jp": "えっ？！",
  "en": "Huh?!"
 },
 {
  "id": "04070:0037",
  "jp": "ネオン！！",
  "en": "Neon!!"
 },
 {
  "id": "04070:0038",
  "jp": "大丈夫？！",
  "en": "Are you okay?!"
 },
 {
  "id": "04070:0039",
  "jp": "……ちゃん……",
  "en": "...-chan..."
 },
 {
  "id": "04070:0040",
  "jp": "シグマ？\\nだ、大丈夫なの？",
  "en": "Sigma? A-are you okay?"
 },
 {
  "id": "04070:0041",
  "jp": "……？\\nネオン？",
  "en": "...? Neon?"
 },
 {
  "id": "04070:0042",
  "jp": "う、うん",
  "en": "Y-yeah."
 },
 {
  "id": "04070:0043",
  "jp": "大丈夫か？！",
  "en": "Are you all right?!"
 },
 {
  "id": "04070:0044",
  "jp": "えっ？\\nあ……えっ？",
  "en": "Huh? Ah... huh?"
 },
 {
  "id": "04070:0045",
  "jp": "だ、大丈夫は、\\n私の台詞……\\nのような……",
  "en": "I-isn't \"are you okay\" supposed to be my line... or something...?"
 },
 {
  "id": "04070:0046",
  "jp": "…………ふぅ",
  "en": "...Phew."
 },
 {
  "id": "04070:0047",
  "jp": "ん……？\\nここは？",
  "en": "Hm...? Where am I?"
 },
 {
  "id": "04070:0048",
  "jp": "そうだ……また時が\\n書き変えられて……",
  "en": "Right... time has been rewritten again..."
 },
 {
  "id": "04070:0049",
  "jp": "！？",
  "en": ""
 },
 {
  "id": "04070:0050",
  "jp": "ネオン、ここに来る\\n前のこと憶えてる？",
  "en": "Neon, do you remember what happened before we came here?"
 },
 {
  "id": "04070:0051",
  "jp": "うーん……？\\nあれ？",
  "en": "Hmm...? Huh?"
 },
 {
  "id": "04070:0052",
  "jp": "時の調律をして、\\n時空の歪みに\\n飛び込んだ後……",
  "en": "After we did the Time Tuning and jumped into the distortion in space-time..."
 },
 {
  "id": "04070:0053",
  "jp": "ん？\\nあれれ？",
  "en": "Hm? Huh-huh?"
 },
 {
  "id": "04070:0054",
  "jp": "えっと、\\nその後は……ここ？",
  "en": "Um, and after that... here?"
 },
 {
  "id": "04070:0055",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04070:0056",
  "jp": "どうしたの？",
  "en": "What's wrong?"
 },
 {
  "id": "04070:0057",
  "jp": "……あれは未来？",
  "en": "...Was that the future?"
 },
 {
  "id": "04070:0058",
  "jp": "この$c02狂$c00った時間のまま\\n進んだ時の……",
  "en": "The time that lies ahead if things go on with time $c02warped$c00 like this..."
 },
 {
  "id": "04070:0059",
  "jp": "ネオンが$c02死ぬ$c00……\\n未来なのか？",
  "en": "a future where Neon $c02dies$c00...?"
 },
 {
  "id": "04070:0060",
  "jp": "？？？",
  "en": ""
 },
 {
  "id": "04070:0061",
  "jp": "いや、なんでもない",
  "en": "No, it's nothing."
 },
 {
  "id": "04070:0062",
  "jp": "さて、この狭間が\\nあるということは、",
  "en": "Now then, if this Rift is still here,"
 },
 {
  "id": "04070:0063",
  "jp": "まだ、終わってない\\nってことだね",
  "en": "that means it isn't over yet."
 },
 {
  "id": "04070:0064",
  "jp": "……そうみたい",
  "en": "...Seems that way."
 },
 {
  "id": "04070:0065",
  "jp": "でも$c02逢魔人$c00、\\n封じたよね？\\nなんでだろ……？",
  "en": "But we sealed the $c02Ouma-born$c00, didn't we? I wonder why...?"
 },
 {
  "id": "04070:0066",
  "jp": "あの２人以外にも\\nいたのか……",
  "en": "So there were others besides those two..."
 },
 {
  "id": "04070:0067",
  "jp": "あるいは……",
  "en": "Or else..."
 },
 {
  "id": "04070:0068",
  "jp": "……しょうがない",
  "en": "...It can't be helped."
 },
 {
  "id": "04070:0069",
  "jp": "何度でも\\n調律してやるさ",
  "en": "I'll tune it as many times as it takes."
 },
 {
  "id": "04070:0070",
  "jp": "うん、\\n調律してやろー！",
  "en": "Yeah, let's tune it right up!"
 },
 {
  "id": "04070:0071",
  "jp": "あぁ",
  "en": "Right."
 }
]
