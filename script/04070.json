[
 {
  "id": "04070:0000",
  "jp": "てめぇ、おいたが\\n過ぎるんじゃねぇか？",
  "en": "Ain't you gettin' a bit too cheeky, punk?"
 },
 {
  "id": "04070:0001",
  "jp": "名前……\\n聞いてなかったわね？",
  "en": "I never did get your name, did I?"
 },
 {
  "id": "04070:0002",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04070:0003",
