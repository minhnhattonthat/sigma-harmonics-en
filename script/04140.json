[
 {
  "id": "04140:0000",
  "jp": "竹さん……\\nダメだ……",
  "en": ""
 },
 {
  "id": "04140:0001",
  "jp": "かなり\\n苦しんだ感じだ……",
  "en": ""
 },
 {
  "id": "04140:0002",
  "jp": "外傷はないし、\\n毒……かもしれない",
  "en": ""
 },
 {
  "id": "04140:0003",
  "jp": "お婆さんも……",
  "en": ""
 },
 {
  "id": "04140:0004",
  "jp": "小婆ちゃんもか",
  "en": ""
 },
 {
  "id": "04140:0005",
  "jp": "…………はぁ\\nため息でちゃったわ",
  "en": ""
 },
 {
  "id": "04140:0006",
  "jp": "譲葉の言葉を\\n信じるなら、",
  "en": ""
 },
 {
  "id": "04140:0007",
  "jp": "毒を飲まされている\\nみたいだね",
  "en": ""
 },
 {
  "id": "04140:0008",
  "jp": "あれ？　この植木、\\n枯れてきてる？",
  "en": ""
 },
 {
  "id": "04140:0009",
  "jp": "はてな？\\nこの木は\\n前も枯れてたか？",
  "en": ""
 },
 {
  "id": "04140:0010",
  "jp": "あれ？\\nこれって、前から\\n枯れてたっけ？",
  "en": ""
 },
 {
  "id": "04140:0011",
  "jp": "そうだね、\\n他の植木は、普通だ",
  "en": ""
 },
 {
  "id": "04140:0012",
  "jp": "いや、\\nそんなことはないよ\\n他は枯れてない",
  "en": ""
 },
 {
  "id": "04140:0013",
  "jp": "なぜ、これだけ？",
  "en": ""
 },
 {
  "id": "04140:0014",
  "jp": "あ、さっきの\\n時間で話してたよね？",
  "en": ""
 },
 {
  "id": "04140:0015",
  "jp": "ふみゅ\\n前の時間で聞いたか？",
  "en": ""
 },
 {
  "id": "04140:0016",
  "jp": "そういえば、\\nなんか言ってたわね",
  "en": ""
 },
 {
  "id": "04140:0017",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04140:0018",
  "jp": "そうか、\\n竹さんが亡くなって、",
  "en": ""
 },
 {
  "id": "04140:0019",
  "jp": "すぐに枯れると\\n言ってたので",
  "en": ""
 },
 {
  "id": "04140:0020",
  "jp": "水あげなきゃ、すぐに\\n枯れちゃうだの\\nなんだのって",
  "en": ""
 },
 {
  "id": "04140:0021",
  "jp": "水をあげなかったから\\n枯れてきてたんだ……",
  "en": ""
 },
 {
  "id": "04140:0022",
  "jp": "もう枯れたと？",
  "en": ""
 },
 {
  "id": "04140:0023",
  "jp": "もう、\\n枯れちゃったのね",
  "en": ""
 },
 {
  "id": "04140:0024",
  "jp": "あれ？！",
  "en": ""
 },
 {
  "id": "04140:0025",
  "jp": "ふみゅ？",
  "en": ""
 },
 {
  "id": "04140:0026",
  "jp": "ややや？",
  "en": ""
 },
 {
  "id": "04140:0027",
  "jp": "お婆さんが２人？？",
  "en": ""
 },
 {
  "id": "04140:0028",
  "jp": "婆ちゃん２人？",
  "en": ""
 },
 {
  "id": "04140:0029",
  "jp": "大婆が２人いる？",
  "en": ""
 },
 {
  "id": "04140:0030",
  "jp": "……双子だった\\nみたいだね",
  "en": ""
 },
 {
  "id": "04140:0031",
  "jp": "【竹の作った漢方薬】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04140:0032",
  "jp": "【竹の死】\\nの刻音を手に入れた！",
  "en": ""
 }
]
