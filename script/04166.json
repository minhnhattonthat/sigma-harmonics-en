 {
  "id": "04166:0000",
  "jp": "イベント制作中",
  "en": ""
 },
 {
  "id": "04166:0001",
  "jp": "ユリ子さんの入れた\\n紅茶、おいしいわね",
  "en": ""
 },
 {
  "id": "04166:0002",
  "jp": "何か、特別な物？",
  "en": ""
 },
 {
  "id": "04166:0003",
  "jp": "そうみたいよ",
  "en": ""
 },
 {
  "id": "04166:0004",
  "jp": "でも、ユリ子に\\n任せっきりだから、\\nよく知らないの",
  "en": ""
 },
 {
  "id": "04166:0005",
  "jp": "そう、後で、\\nユリ子さんに\\n聞いてみようかしら",
  "en": ""
 },
 {
  "id": "04166:0006",
  "jp": "帰る前に、ユリ子に\\n少し、もらって\\nいったらいいわ",
  "en": ""
 },
 {
  "id": "04166:0007",
  "jp": "じゃあ、お言葉に\\n甘えまして、いただいて\\nいきますわ",
  "en": ""
 },
 {
  "id": "04166:0008",
  "jp": "そうですわね、\\n今日で３日目ですから",
  "en": ""
 },
 {
  "id": "04166:0009",
  "jp": "そろそろ麟が迎えに\\n来るはずですし",
  "en": ""
 },
 {
  "id": "04166:0010",
  "jp": "そういえば、\\nこの部屋って？",
  "en": ""
 },
 {
  "id": "04166:0011",
  "jp": "ふみゅ。そういえば\\nこの部屋は？",
  "en": ""
 },
 {
  "id": "04166:0012",
  "jp": "そういえば\\nここって誰の部屋？",
  "en": ""
 },
 {
  "id": "04166:0013",
  "jp": "昔から、客人を\\n泊めるのに使ってるよ",
  "en": ""
 },
 {
  "id": "04166:0014",
  "jp": "僕の知ってるここは\\n客人用の部屋だね",
  "en": ""
 },
 {
  "id": "04166:0015",
  "jp": "３日目と言ってたし、\\nしばらく滞在していた\\nみたいだね",
  "en": ""
 },
 {
  "id": "04166:0016",
  "jp": "【芙蓉と佳子の会話】\\nの刻音を手に入れた！",
  "en": ""
 }
