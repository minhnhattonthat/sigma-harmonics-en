[
 {
  "id": "04098:0000",
  "jp": "きゃぁーーーーー！",
  "en": ""
 },
 {
  "id": "04098:0001",
  "jp": "あ、あなた……？",
  "en": ""
 },
 {
  "id": "04098:0002",
  "jp": "なんじゃ！\\nなんの騒ぎ……",
  "en": ""
 },
 {
  "id": "04098:0003",
  "jp": "おおぉ……\\nし、静馬……\\n静馬！！",
  "en": ""
 },
 {
  "id": "04098:0004",
  "jp": "なんてことじゃ……",
  "en": ""
 },
 {
  "id": "04098:0005",
  "jp": "どうしました！",
  "en": ""
 },
 {
  "id": "04098:0006",
  "jp": "だ、旦那様！？",
  "en": ""
 },
 {
  "id": "04098:0007",
  "jp": "し、$c02死$c00んでる……\\n背中を刺されてる\\nようです……",
  "en": ""
 },
 {
  "id": "04098:0008",
  "jp": "ど、どういうこと？",
  "en": ""
 },
 {
  "id": "04098:0009",
  "jp": "ふみゅみゅ……",
  "en": ""
 },
 {
  "id": "04098:0010",
  "jp": "あっちゃー\\n過去だから、干渉できない\\nのは、分かってるけど",
  "en": ""
 },
 {
  "id": "04098:0011",
  "jp": "ユリ子さんを\\n$c02殺$c00したのと同じ犯人に\\n$c02殺$c00されたの？",
  "en": ""
 },
 {
  "id": "04098:0012",
  "jp": "これは、ユリユリ$c02殺害$c00と\\n同一犯の犯行？",
  "en": ""
 },
 {
  "id": "04098:0013",
  "jp": "なんか、後手に回った\\n感じで気分悪いわね",
  "en": ""
 },
 {
  "id": "04098:0014",
  "jp": "まだ、分からない……",
  "en": ""
 },
 {
  "id": "04098:0015",
  "jp": "これって、ユリ子と\\n同じ犯人でしょ？",
  "en": ""
 },
 {
  "id": "04098:0016",
  "jp": "でも、この過去にいる、\\n$c02大逢魔$c00の気配は１つ",
  "en": ""
 },
 {
  "id": "04098:0017",
  "jp": "だから、１人に対する\\n意識への干渉しか\\nできないはず……",
  "en": ""
 },
 {
  "id": "04098:0018",
  "jp": "ねぇ、佳子さん、\\nここに入る時に、\\n鍵を開けてたよね？",
  "en": ""
 },
 {
  "id": "04098:0019",
  "jp": "疑問。\\nよっちゃん、ここ入る時\\n鍵を使った",
  "en": ""
 },
 {
  "id": "04098:0020",
  "jp": "ちょっと待った。\\n佳子、ここに入る時\\n鍵開けてなかった？",
  "en": ""
 },
 {
  "id": "04098:0021",
  "jp": "あぁ、この部屋には、\\n鍵がかかっていた",
  "en": ""
 },
 {
  "id": "04098:0022",
  "jp": "見たところ、窓にも\\n鍵がかかっている\\nみたいだ",
  "en": ""
 },
 {
  "id": "04098:0023",
  "jp": "鍵って、いくつも\\nあるのかな？",
  "en": ""
 },
 {
  "id": "04098:0024",
  "jp": "確認。\\n鍵は館に１つ？",
  "en": ""
 },
 {
  "id": "04098:0025",
  "jp": "佳子の持ってた鍵って\\nいくつもあるもの？",
  "en": ""
 },
 {
  "id": "04098:0026",
  "jp": "僕が知っている館では\\n外から解錠できる\\n鍵は１個だけだった",
  "en": ""
 },
 {
  "id": "04098:0027",
  "jp": "佳子も大婆に\\n鍵を借りていたし",
  "en": ""
 },
 {
  "id": "04098:0028",
  "jp": "いくつもあるとは\\n考えにくいと思う",
  "en": ""
 },
 {
  "id": "04098:0029",
  "jp": "つまり……",
  "en": ""
 },
 {
  "id": "04098:0030",
  "jp": "いわゆる一つの……",
  "en": ""
 },
 {
  "id": "04098:0031",
  "jp": "んじゃあ……",
  "en": ""
 },
 {
  "id": "04098:0032",
  "jp": "密室だね……",
  "en": ""
 },
 {
  "id": "04098:0033",
  "jp": "【静馬は密室で…】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04098:0034",
  "jp": "【駆けつけた大婆】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04098:0035",
  "jp": "【駆けつけた執事】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04098:0036",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04098:0037",
  "jp": "あ、式札で\\n他の時が紡げるように\\nなったみたい",
  "en": ""
 },
 {
  "id": "04098:0038",
  "jp": "あ、新しい時間、紡げる\\nようになったふう",
  "en": ""
 },
 {
  "id": "04098:0039",
  "jp": "ん？　式札に\\n新しい時間が\\n増えてるわね",
  "en": ""
 },
 {
  "id": "04098:0040",
  "jp": "でも、ずいぶん、\\n時間が安定せずに\\nゆらいでるのね",
  "en": ""
 },
 {
  "id": "04098:0041",
  "jp": "しかし、時間、不安定\\nゆらゆらしてる",
  "en": ""
 },
 {
  "id": "04098:0042",
  "jp": "しっかし、ずいぶんと\\n不安定な時間ね",
  "en": ""
 },
 {
  "id": "04098:0043",
  "jp": "$c02大逢魔$c00が時を隠そうと\\nしているのかも\\nしれない",
  "en": ""
 },
 {
  "id": "04098:0044",
  "jp": "そんなこともするの？",
  "en": ""
 },
 {
  "id": "04098:0045",
  "jp": "ふみゅ。\\n流石は$c02大逢魔$c00",
  "en": ""
 },
 {
  "id": "04098:0046",
  "jp": "あいつら、\\nそんなこともすんの？",
  "en": ""
 },
 {
  "id": "04098:0047",
  "jp": "僕らは、情報が\\n多いほど、上手く\\n調律できるからね",
  "en": ""
 },
 {
  "id": "04098:0048",
  "jp": "色々と見せたくは\\nないんだろうね",
  "en": ""
 },
 {
  "id": "04098:0049",
  "jp": "そんな……",
  "en": ""
 },
 {
  "id": "04098:0050",
  "jp": "なるほど……",
  "en": ""
 },
 {
  "id": "04098:0051",
  "jp": "なるほどね",
  "en": ""
 },
 {
  "id": "04098:0052",
  "jp": "でも、今みたいに\\nいくら隠そうとしても",
  "en": ""
 },
 {
  "id": "04098:0053",
  "jp": "変革した時間や事柄は\\n隠しきれないし",
  "en": ""
 },
 {
  "id": "04098:0054",
  "jp": "嘘の再演を見せる\\nなんてことはできない",
  "en": ""
 },
 {
  "id": "04098:0055",
  "jp": "うん、じゃあ、\\n私たちは、落ち着いて",
  "en": ""
 },
 {
  "id": "04098:0056",
  "jp": "ふみゅ。ならば\\n平素の通り、\\nこと進めると吉",
  "en": ""
 },
 {
  "id": "04098:0057",
  "jp": "まぁ、そんなら\\n話は早いわ",
  "en": ""
 },
 {
  "id": "04098:0058",
  "jp": "刻音を集めてけば\\nいいんだよね？",
  "en": ""
 },
 {
  "id": "04098:0059",
  "jp": "ダミー",
  "en": ""
 },
 {
  "id": "04098:0060",
  "jp": "アタシたちは、\\nキッチリ刻音集めれば\\nいいわけでしょ？",
  "en": ""
 },
 {
  "id": "04098:0061",
  "jp": "そういうことさ",
  "en": ""
 }
]
