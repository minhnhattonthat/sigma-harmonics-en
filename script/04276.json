[
 {
  "id": "04276:0000",
  "jp": "ん……？ よく分から\\nなかったが……",
  "en": ""
 },
 {
  "id": "04276:0001",
  "jp": "ふむ……なるほどな",
  "en": ""
 },
 {
  "id": "04276:0002",
  "jp": "知っていることは\\n話そう",
  "en": ""
 },
 {
  "id": "04276:0003",
  "jp": "ただ、私も全てを\\n知っている\\nわけではない",
  "en": ""
 },
 {
  "id": "04276:0004",
  "jp": "君の疑問を\\n解いてあげられるかは\\n分からないよ",
  "en": ""
 },
 {
  "id": "04276:0005",
  "jp": "まず、調律者の\\n言ったことに嘘はない",
  "en": ""
 },
 {
  "id": "04276:0006",
  "jp": "いま世界が\\n向かっている方向は、",
  "en": ""
 },
 {
  "id": "04276:0007",
  "jp": "歴史としては、\\n正しいんだ……",
  "en": ""
 },
 {
  "id": "04276:0008",
  "jp": "えっ？　どういう？",
  "en": ""
 },
 {
  "id": "04276:0009",
  "jp": "本来、世界はある事件を\\nきっかけに、",
  "en": ""
 },
 {
  "id": "04276:0010",
  "jp": "現世に溢れだした\\n$c02逢魔$c00によって\\n侵食されていった",
  "en": ""
 },
 {
  "id": "04276:0011",
  "jp": "それを私たち使い人が",
  "en": ""
 },
 {
  "id": "04276:0012",
  "jp": "時を渡り、\\n歴史を変えた",
  "en": ""
 },
 {
  "id": "04276:0013",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04276:0014",
  "jp": "調律者とは、時が歪みを\\n戻そうとする力の具現",
  "en": ""
 },
 {
  "id": "04276:0015",
  "jp": "現世では、人の世で\\n最も力の強いものを\\nベースとして",
  "en": ""
 },
 {
  "id": "04276:0016",
  "jp": "形を取っているようだ",
  "en": ""
 },
 {
  "id": "04276:0017",
  "jp": "残念ながら、\\n私は、選ばれなかった\\nようだがね",
  "en": ""
 },
 {
  "id": "04276:0018",
  "jp": "お陰で戦いやすくは\\nなっているよ",
  "en": ""
 },
 {
  "id": "04276:0019",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04276:0020",
  "jp": "彼らは、自らを世界から\\nずれた存在として、",
  "en": ""
 },
 {
  "id": "04276:0021",
  "jp": "《シグマ》\\nと呼んでいる",
  "en": ""
 },
 {
  "id": "04276:0022",
  "jp": "！？",
  "en": ""
 },
 {
  "id": "04276:0023",
  "jp": "違うよ、私はシグマだ、\\nこの世界のね",
  "en": ""
 },
 {
  "id": "04276:0024",
  "jp": "本当の世界のシグマ\\nである、私の仕事だ",
  "en": ""
 },
 {
  "id": "04276:0025",
  "jp": "そもそも、それが、",
  "en": ""
 },
 {
  "id": "04276:0026",
  "jp": "【シグマ】である、\\n私たちの仕事だろ？",
  "en": ""
 },
 {
  "id": "04276:0027",
  "jp": "僕は……",
  "en": ""
 },
 {
  "id": "04276:0028",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04276:0029",
  "jp": "シグマ……",
  "en": ""
 },
 {
  "id": "04276:0030",
  "jp": "僕も……シグマだ",
  "en": ""
 },
 {
  "id": "04276:0031",
  "jp": "何？",
  "en": ""
 },
 {
  "id": "04276:0032",
  "jp": "そうか……君は、\\n自分が誰だかも、",
  "en": ""
 },
 {
  "id": "04276:0033",
  "jp": "何のためにいるのかも\\n分からないと？",
  "en": ""
 },
 {
  "id": "04276:0034",
  "jp": "はい、やつは……\\n調律者は、",
  "en": ""
 },
 {
  "id": "04276:0035",
  "jp": "平行世界で存在が\\n不安定な人物を\\nベースとしたせい……",
  "en": ""
 },
 {
  "id": "04276:0036",
  "jp": "と言っていました",
  "en": ""
 },
 {
  "id": "04276:0037",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04276:0038",
  "jp": "……君は……？",
  "en": ""
 },
 {
  "id": "04276:0039",
  "jp": "えっ？",
  "en": ""
 },
 {
  "id": "04276:0040",
  "jp": "そうか……\\nそうなのか……",
  "en": ""
 },
 {
  "id": "04276:0041",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04276:0042",
  "jp": "恐らく、君は本当に\\nシグマ……なのだろう",
  "en": ""
 },
 {
  "id": "04276:0043",
  "jp": "あの男とは\\n別の調律者だ",
  "en": ""
 },
 {
  "id": "04276:0044",
  "jp": "では、黒上の頭首と\\nして問う",
  "en": ""
 },
 {
  "id": "04276:0045",
  "jp": "もう１人の調律者よ、\\n君はこれから\\nどうするつもりだ？",
  "en": ""
 },
 {
  "id": "04276:0046",
  "jp": "僕は……",
  "en": ""
 },
 {
  "id": "04276:0047",
  "jp": "ネオン……",
  "en": ""
 },
 {
  "id": "04276:0048",
  "jp": "君は、使命を……\\n全うしたのかい？",
  "en": ""
 },
 {
  "id": "04276:0049",
  "jp": "どうだろ？",
  "en": ""
 },
 {
  "id": "04276:0050",
  "jp": "私は、\\nかなり特殊だったから",
  "en": ""
 },
 {
  "id": "04276:0051",
  "jp": "本来、\\nできっこないはずの",
  "en": ""
 },
 {
  "id": "04276:0052",
  "jp": "未来への道を紡い\\nじゃった少女がいたの",
  "en": ""
 },
 {
  "id": "04276:0053",
  "jp": "その有り得ない未来を\\n調律するはずの私は、",
  "en": ""
 },
 {
  "id": "04276:0054",
  "jp": "分岐点までの半世紀、\\n世界に留まった……",
  "en": ""
 },
 {
  "id": "04276:0055",
  "jp": "私はその間、\\nハーモニクス（平行世界）\\nをうろちょろしてたの",
  "en": ""
 },
 {
  "id": "04276:0056",
  "jp": "そして、\\nあなたの生まれる\\n世界をみつけた",
  "en": ""
 },
 {
  "id": "04276:0057",
  "jp": "私ね、\\nあの世界が好きだよ、",
  "en": ""
 },
 {
  "id": "04276:0058",
  "jp": "大勢の人がいて、\\n大きな争いもなくて、\\n平和で……",
  "en": ""
 },
 {
  "id": "04276:0059",
  "jp": "学校を抜け出して\\n食べたドーナッツも\\nおいしかった！",
  "en": ""
 },
 {
  "id": "04276:0060",
  "jp": "ずっと待ってたんだよ",
  "en": ""
 },
 {
  "id": "04276:0061",
  "jp": "君は……",
  "en": ""
 },
 {
  "id": "04276:0062",
  "jp": "私はネオン、\\nシグマの知っている\\n月弓ネオン",
  "en": ""
 },
 {
  "id": "04276:0063",
  "jp": "……あぁ、そうだね",
  "en": ""
 },
 {
  "id": "04276:0064",
  "jp": "ネオン……\\n僕は、どうしたら\\nいいんだろう？",
  "en": ""
 },
 {
  "id": "04276:0065",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04276:0066",
  "jp": "シグマの好きにすれば\\nいいんじゃないかな？",
  "en": ""
 },
 {
  "id": "04276:0067",
  "jp": "え？",
  "en": ""
 },
 {
  "id": "04276:0068",
  "jp": "自分が誰だって\\n関係ないよ",
  "en": ""
 },
 {
  "id": "04276:0069",
  "jp": "今までだって自分が\\n正しいと思うこと",
  "en": ""
 },
 {
  "id": "04276:0070",
  "jp": "無理矢理だって\\n貫いてきたでしょ？",
  "en": ""
 },
 {
  "id": "04276:0071",
  "jp": "そう……だったかな",
  "en": ""
 },
 {
  "id": "04276:0072",
  "jp": "そうだよ、シグマの\\nとんでもない推理に",
  "en": ""
 },
 {
  "id": "04276:0073",
  "jp": "いっぱい\\n付き合わされたもん",
  "en": ""
 },
 {
  "id": "04276:0074",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04276:0075",
  "jp": "うん、\\nシグマはシグマ、",
  "en": ""
 },
 {
  "id": "04276:0076",
  "jp": "あの世界で生まれて\\nから、私と一緒に\\n過去を調律してきた",
  "en": ""
 },
 {
  "id": "04276:0077",
  "jp": "黒上のシグマ",
  "en": ""
 },
 {
  "id": "04276:0078",
  "jp": "その黒上シグマは\\n何を望むの？",
  "en": ""
 },
 {
  "id": "04276:0079",
  "jp": "……どうしたいの？",
  "en": ""
 },
 {
  "id": "04276:0080",
  "jp": "僕は……",
  "en": ""
 },
 {
  "id": "04276:0081",
  "jp": "はは……\\nなんだ、僕も……",
  "en": ""
 },
 {
  "id": "04276:0082",
  "jp": "うん、シグマは\\nシグマの思うように、",
  "en": ""
 },
 {
  "id": "04276:0083",
  "jp": "シグマらしく、\\n行けばいいと思う",
  "en": ""
 },
 {
  "id": "04276:0084",
  "jp": "……あぁ、そうだな",
  "en": ""
 },
 {
  "id": "04276:0085",
  "jp": "やつを倒します",
  "en": ""
 },
 {
  "id": "04276:0086",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04276:0087",
  "jp": "ここは僕の知っている\\n世界じゃない",
  "en": ""
 },
 {
  "id": "04276:0088",
  "jp": "それに、\\n美巫女ちゃんにも\\n言ってしまいました、",
  "en": ""
 },
 {
  "id": "04276:0089",
  "jp": "僕のできることを\\nするってね",
  "en": ""
 },
 {
  "id": "04276:0090",
  "jp": "同じ調律者の僕なら、",
  "en": ""
 },
 {
  "id": "04276:0091",
  "jp": "この状況、何とか\\nできるかもしれない",
  "en": ""
 },
 {
  "id": "04276:0092",
  "jp": "そうか……分かった",
  "en": ""
 },
 {
  "id": "04276:0093",
  "jp": "やつは、さきほど\\n《世界を終わらせる》\\nと言っていた",
  "en": ""
 },
 {
  "id": "04276:0094",
  "jp": "あまり時間が\\nないのかもしれない",
  "en": ""
 },
 {
  "id": "04276:0095",
  "jp": "やつの所までは、\\nこのまま乱歩に\\n案内させる",
  "en": ""
 },
 {
  "id": "04276:0096",
  "jp": "いいな、乱歩",
  "en": ""
 },
 {
  "id": "04276:0097",
  "jp": "はい、\\nかしこまりました",
  "en": ""
 },
 {
  "id": "04276:0098",
  "jp": "旦那様は？",
  "en": ""
 },
 {
  "id": "04276:0099",
  "jp": "……私は館に\\n用ができた",
  "en": ""
 },
 {
  "id": "04276:0100",
  "jp": "別行動を\\n取らせてもらう",
  "en": ""
 }
]
