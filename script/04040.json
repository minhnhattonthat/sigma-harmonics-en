[
 {
  "id": "04040:0000",
  "jp": "始まる",
  "en": ""
 },
 {
  "id": "04040:0001",
  "jp": "ねじ曲げられた\\n時の最初の悲鳴",
  "en": ""
 },
 {
  "id": "04040:0002",
  "jp": "《時の再演》……",
  "en": ""
 },
 {
  "id": "04040:0003",
  "jp": "$c02狂$c00った時間の\\n最初の事柄……",
  "en": ""
 },
 {
  "id": "04040:0004",
  "jp": "大婆様？\\nお早いですね",
  "en": ""
 },
 {
  "id": "04040:0005",
  "jp": "わしが通りかかったら、\\n食事の準備が\\nできとったでな",
  "en": ""
 },
 {
  "id": "04040:0006",
  "jp": "他のもんは、\\nどうした？",
  "en": ""
 },
 {
  "id": "04040:0007",
  "jp": "ん？\\n遅れてしまったかな",
  "en": ""
 },
 {
  "id": "04040:0008",
  "jp": "じゃあ、\\nお食事にしましょう",
  "en": ""
 },
 {
  "id": "04040:0009",
  "jp": "佳子さん、\\nあれは返して\\nくれたかの？",
  "en": ""
 },
 {
  "id": "04040:0010",
  "jp": "すみません",
  "en": ""
 },
 {
  "id": "04040:0011",
  "jp": "もう少し、お借りして\\nよろしいですか？",
  "en": ""
 },
 {
  "id": "04040:0012",
  "jp": "すぐに、食事になって\\nしまいましたので……",
  "en": ""
 },
 {
  "id": "04040:0013",
  "jp": "そうかえ。\\nただ、雑はいかんよ",
  "en": ""
 },
 {
  "id": "04040:0014",
  "jp": "キッチリしてくれれば\\nそれでええ",
  "en": ""
 },
 {
  "id": "04040:0015",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "04040:0016",
  "jp": "それと、\\nねねやユリ子は、\\nどうしたんだい？",
  "en": ""
 },
 {
  "id": "04040:0017",
  "jp": "ねねは、ユリ子から\\n今日の食事が\\nトマトだと聞き",
  "en": ""
 },
 {
  "id": "04040:0018",
  "jp": "逃げてしまった\\nようですよ",
  "en": ""
 },
 {
  "id": "04040:0019",
  "jp": "相変わらず、\\nトマトは\\nダメらしい",
  "en": ""
 },
 {
  "id": "04040:0020",
  "jp": "なんね！",
  "en": ""
 },
 {
  "id": "04040:0021",
  "jp": "だぁから、ねねが\\n食べやすいよう",
  "en": ""
 },
 {
  "id": "04040:0022",
  "jp": "スープにしてもらった\\nんじゃろが",
  "en": ""
 },
 {
  "id": "04040:0023",
  "jp": "それで、\\nなんでユリ子は\\nおらんね？",
  "en": ""
 },
 {
  "id": "04040:0024",
  "jp": "皆が食事を\\nする時は、ここにおる\\n決まりじゃろが？",
  "en": ""
 },
 {
  "id": "04040:0025",
  "jp": "まぁ、いいでは\\nありませんか",
  "en": ""
 },
 {
  "id": "04040:0026",
  "jp": "あれも、一人で\\n館の面倒を見てる……",
  "en": ""
 },
 {
  "id": "04040:0027",
  "jp": "いいも、悪いも\\nあるか！",
  "en": ""
 },
 {
  "id": "04040:0028",
  "jp": "守ってこその\\n規律じゃろ！",
  "en": ""
 },
 {
  "id": "04040:0029",
  "jp": "そんもそも、\\n黒上の戒律は……",
  "en": ""
 },
 {
  "id": "04040:0030",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04040:0031",
  "jp": "ぐっ？！",
  "en": ""
 },
 {
  "id": "04040:0032",
  "jp": "大婆様……？",
  "en": ""
 },
 {
  "id": "04040:0033",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04040:0034",
  "jp": "なんて……ことだ……\\n酷い、な……",
  "en": ""
 },
 {
  "id": "04040:0035",
  "jp": "…………\\n佳子……",
  "en": ""
 },
 {
  "id": "04040:0036",
  "jp": "月弓の者を呼べ",
  "en": ""
 },
 {
  "id": "04040:0037",
  "jp": "あっ、はい",
  "en": ""
 },
 {
  "id": "04040:0038",
  "jp": "ねぇ、これって、\\n最初の事件と同じ？",
  "en": ""
 },
 {
  "id": "04040:0039",
  "jp": "ふみゅ？\\n最初の事件と\\nデジャブー",
  "en": ""
 },
 {
  "id": "04040:0040",
  "jp": "ねぇ、ちょっと、\\nこれって、",
  "en": ""
 },
 {
  "id": "04040:0041",
  "jp": "最初の事件と同じ\\nなんじゃないの？",
  "en": ""
 },
 {
  "id": "04040:0042",
  "jp": "いや、似てるけど、\\n細部が違う",
  "en": ""
 },
 {
  "id": "04040:0043",
  "jp": "会話の内容や、\\nねねが、この場に\\nいなかったりね",
  "en": ""
 },
 {
  "id": "04040:0044",
  "jp": "うん、確かに……",
  "en": ""
 },
 {
  "id": "04040:0045",
  "jp": "肯定",
  "en": ""
 },
 {
  "id": "04040:0046",
  "jp": "知ってるわよ、\\nアタシだって",
  "en": ""
 },
 {
  "id": "04040:0047",
  "jp": "これから、\\n同じようなことが\\n起こっても、",
  "en": ""
 },
 {
  "id": "04040:0048",
  "jp": "惑わされないように\\n気を付けて視よう",
  "en": ""
 },
 {
  "id": "04040:0049",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04040:0050",
  "jp": "じゃあ、\\nまずは確認するね",
  "en": ""
 },
 {
  "id": "04040:0051",
  "jp": "今回も、前回同様、\\n食事の最中に\\n毒らしきものを",
  "en": ""
 },
 {
  "id": "04040:0052",
  "jp": "盛った人はいなかった\\nと思うけど、\\nどう？",
  "en": ""
 },
 {
  "id": "04040:0053",
  "jp": "ではでは、\\n前回と同じものの\\n確認……",
  "en": ""
 },
 {
  "id": "04040:0054",
  "jp": "視てる限り、\\n毒はこの場で\\n入ってないふう",
  "en": ""
 },
 {
  "id": "04040:0055",
  "jp": "食事も完全一致",
  "en": ""
 },
 {
  "id": "04040:0056",
  "jp": "疑うなら、\\n食事係であるはずの\\nユリユリ",
  "en": ""
 },
 {
  "id": "04040:0057",
  "jp": "でも、\\n状況は似てるわね",
  "en": ""
 },
 {
  "id": "04040:0058",
  "jp": "食事をとっていた\\nメンツで",
  "en": ""
 },
 {
  "id": "04040:0059",
  "jp": "大婆のスープに\\n近づいたものはいない",
  "en": ""
 },
 {
  "id": "04040:0060",
  "jp": "その上、今回は、\\n見事なまでに、",
  "en": ""
 },
 {
  "id": "04040:0061",
  "jp": "全員が同じ物を\\n飲食してるわね",
  "en": ""
 },
 {
  "id": "04040:0062",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04040:0063",
  "jp": "恐らく、今回も……",
  "en": ""
 },
 {
  "id": "04040:0064",
  "jp": "【食事中には\\n　毒は盛られてない】",
  "en": ""
 },
 {
  "id": "04040:0065",
  "jp": "と考えても\\nいいだろうね",
  "en": ""
 },
 {
  "id": "04040:0066",
  "jp": "時の再演で、\\n静馬さんが言ってた\\n月弓を呼べって……",
  "en": ""
 },
 {
  "id": "04040:0067",
  "jp": "時紡ぎをして、\\n何が起こったのか",
  "en": ""
 },
 {
  "id": "04040:0068",
  "jp": "調べようとしてる\\nのかもしれない",
  "en": ""
 },
 {
  "id": "04040:0069",
  "jp": "あ、そうか\\n過去を視る\\nつもりなんだ",
  "en": ""
 },
 {
  "id": "04040:0070",
  "jp": "そういえば、\\n時の再演で\\n静馬が言ってた",
  "en": ""
 },
 {
  "id": "04040:0071",
  "jp": "【月弓を呼べ】\\nって……",
  "en": ""
 },
 {
  "id": "04040:0072",
  "jp": "ネオンの家だね",
  "en": ""
 },
 {
  "id": "04040:0073",
  "jp": "時紡ぎで、\\n何が起こったか、\\n視るんじゃないかな？",
  "en": ""
 },
 {
  "id": "04040:0074",
  "jp": "うーん、\\nそうなんだろうけどさ",
  "en": ""
 },
 {
  "id": "04040:0075",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04040:0076",
  "jp": "まぁ、なんでもないわ",
  "en": ""
 },
 {
  "id": "04040:0077",
  "jp": "はてな？",
  "en": ""
 },
 {
  "id": "04040:0078",
  "jp": "そういえば、\\nねねっちいない",
  "en": ""
 },
 {
  "id": "04040:0079",
  "jp": "部屋に戻った……\\nと言ってたね",
  "en": ""
 },
 {
  "id": "04040:0080",
  "jp": "確かに、\\n少し気になるね",
  "en": ""
 },
 {
  "id": "04040:0081",
  "jp": "最初の事件では\\n姿の見えなかった\\nユリ子は$c02殺$c00されていた",
  "en": ""
 },
 {
  "id": "04040:0082",
  "jp": "…………\\n刻音を集めながら、\\n少し探してみよう",
  "en": ""
 },
 {
  "id": "04040:0083",
  "jp": "ふみゅ。\\nねねっちも探す",
  "en": ""
 },
 {
  "id": "04040:0084",
  "jp": "大婆様……？",
  "en": ""
 },
 {
  "id": "04040:0085",
  "jp": "あなた！！！",
  "en": ""
 },
 {
  "id": "04040:0086",
  "jp": "！？\\n佳子？",
  "en": ""
 },
 {
  "id": "04040:0087",
  "jp": "お婆さんの遺体が\\n無くなってる？！",
  "en": ""
 },
 {
  "id": "04040:0088",
  "jp": "なっ！\\n大婆の遺体、\\n消えてるじゃん？！",
  "en": ""
 },
 {
  "id": "04040:0089",
  "jp": "……吃驚仰天、\\n遺体が消えた？",
  "en": ""
 },
 {
  "id": "04040:0090",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04040:0091",
  "jp": "一体、何が……？",
  "en": ""
 },
 {
  "id": "04040:0092",
  "jp": "何がどうしたっての？",
  "en": ""
 },
 {
  "id": "04040:0093",
  "jp": "むむ……\\n起こったことは何？",
  "en": ""
 },
 {
  "id": "04040:0094",
  "jp": "分からない……\\nその時の魂の影は\\n存在しないみたいだ",
  "en": ""
 },
 {
  "id": "04040:0095",
  "jp": "どうして？",
  "en": ""
 },
 {
  "id": "04040:0096",
  "jp": "はぁ？",
  "en": ""
 },
 {
  "id": "04040:0097",
  "jp": "はてな？",
  "en": ""
 },
 {
  "id": "04040:0098",
  "jp": "魂の影は、\\n人の心の残滓",
  "en": ""
 },
 {
  "id": "04040:0099",
  "jp": "心が動いてなければ\\n影は残らないし、",
  "en": ""
 },
 {
  "id": "04040:0100",
  "jp": "元凶となっている\\n逢魔のせいで、消えて\\nしまう場合もある",
  "en": ""
 },
 {
  "id": "04040:0101",
  "jp": "そうなんだ……",
  "en": ""
 },
 {
  "id": "04040:0102",
  "jp": "じゃあ、\\n事件の全部が視れる\\n訳じゃないのね？",
  "en": ""
 },
 {
  "id": "04040:0103",
  "jp": "ふーん、じゃあ、\\nその時間に\\nいけるからって、",
  "en": ""
 },
 {
  "id": "04040:0104",
  "jp": "全部が確認できる\\n訳じゃないんだ",
  "en": ""
 },
 {
  "id": "04040:0105",
  "jp": "理解",
  "en": ""
 },
 {
  "id": "04040:0106",
  "jp": "起こったことは、\\n視れたり\\n視れなかったり",
  "en": ""
 },
 {
  "id": "04040:0107",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04040:0108",
  "jp": "だから、集められる\\n刻音の中から、答えを\\n導きだしていくのさ",
  "en": ""
 },
 {
  "id": "04040:0109",
  "jp": "超推理に\\n「大婆の死体消失」\\nに関する闇が現れた！",
  "en": ""
 },
 {
  "id": "04040:0110",
  "jp": "【誰も毒を…】\\nの刻音を手に入れた！",
  "en": ""
 }
]
