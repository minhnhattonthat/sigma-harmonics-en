[
 {
  "id": "04148:0000",
  "jp": "【逢魔との戦闘】",
  "en": ""
 },
 {
  "id": "04148:0001",
  "jp": "逢魔との戦闘には\\nネオンだけが参加し、",
  "en": ""
 },
 {
  "id": "04148:0002",
  "jp": "シグマであるあなたは、\\n後ろからネオンに指示を\\nだすことになります",
  "en": ""
 },
 {
  "id": "04148:0003",
  "jp": "戦闘中は、\\n時間の経過によって",
  "en": ""
 },
 {
  "id": "04148:0004",
  "jp": "式札（カード）の上にある\\n緑色のゲージが\\n増えていきます",
  "en": ""
 },
 {
  "id": "04148:0005",
  "jp": "ゲージが溜まったら、\\n式札をタッチして",
  "en": ""
 },
 {
  "id": "04148:0006",
  "jp": "上部の所定の位置に\\nスライドさせると",
  "en": ""
 },
 {
  "id": "04148:0007",
  "jp": "ネオンが技を\\n使用します",
  "en": ""
 },
 {
  "id": "04148:0008",
  "jp": "【レーダー表示】",
  "en": ""
 },
 {
  "id": "04148:0009",
  "jp": "左画面の下部には、\\n周囲の状況を示す",
  "en": ""
 },
 {
  "id": "04148:0010",
  "jp": "レーダーが\\n表示されており、",
  "en": ""
 },
 {
  "id": "04148:0011",
  "jp": "扇形の領域が\\n現在のネオンの向きを、",
  "en": ""
 },
 {
  "id": "04148:0012",
  "jp": "赤いマーカーが\\n敵の位置を\\n表しています",
  "en": ""
 },
 {
  "id": "04148:0013",
  "jp": "【式札の切り替え】",
  "en": ""
 },
 {
  "id": "04148:0014",
  "jp": "複数の式札が、一箇所で\\n重なっている場合は、",
  "en": ""
 },
 {
  "id": "04148:0015",
  "jp": "一番上の式札を\\nタッチすることで、",
  "en": ""
 },
 {
  "id": "04148:0016",
  "jp": "その式札を後ろに回し、\\n次の式札に切り替える\\nことができます",
  "en": ""
 }
]
