[
 {
  "id": "04170:0000",
  "jp": "イベント制作中",
  "en": ""
 },
 {
  "id": "04170:0001",
  "jp": "どうだ、少しは、\\nゆっくりできたかね？",
  "en": ""
 },
 {
  "id": "04170:0002",
  "jp": "えぇ、おかげさまで",
  "en": ""
 },
 {
  "id": "04170:0003",
  "jp": "お心遣い\\n感謝いたしますわ",
  "en": ""
 },
 {
  "id": "04170:0004",
  "jp": "先日も電報を届けて\\nもらいまして",
  "en": ""
 },
 {
  "id": "04170:0005",
  "jp": "あぁ、お前の息子から\\nだったな",
  "en": ""
 },
 {
  "id": "04170:0006",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "04170:0007",
  "jp": "……お前の息子は、\\n譲葉の力、\\n持っているのか？",
  "en": ""
 },
 {
  "id": "04170:0008",
  "jp": "えぇ、もちろん",
  "en": ""
 },
 {
  "id": "04170:0009",
  "jp": "とても、優秀ですわ",
  "en": ""
 },
 {
  "id": "04170:0010",
  "jp": "そういえば、ゆう君は、\\nどうですか？",
  "en": ""
 },
 {
  "id": "04170:0011",
  "jp": "黒上の次期頭首\\nなのでしょう？",
  "en": ""
 },
 {
  "id": "04170:0012",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04170:0013",
  "jp": "？\\nお気に障りましたか？",
  "en": ""
 },
 {
  "id": "04170:0014",
  "jp": "すみません、でも、\\n大婆様と佳子さんの",
  "en": ""
 },
 {
  "id": "04170:0015",
  "jp": "思ってることが、\\n少し違うよう\\nでしたので、",
  "en": ""
 },
 {
  "id": "04170:0016",
  "jp": "ご頭首は、\\nどう思って\\nいらっしゃるのかと",
  "en": ""
 },
 {
  "id": "04170:0017",
  "jp": "ちょっとした\\n興味ですわ",
  "en": ""
 },
 {
  "id": "04170:0018",
  "jp": "お前はどう思う？\\n譲葉",
  "en": ""
 },
 {
  "id": "04170:0019",
  "jp": "私ですか？",
  "en": ""
 },
 {
  "id": "04170:0020",
  "jp": "それが、分からないから\\n聞いているのでしてよ",
  "en": ""
 },
 {
  "id": "04170:0021",
  "jp": "ほう……お前でも\\n分からないのか？",
  "en": ""
 },
 {
  "id": "04170:0022",
  "jp": "えぇ、そういう意味では\\n面白いとは思いますわ",
  "en": ""
 },
 {
  "id": "04170:0023",
  "jp": "ふっ、そうか",
  "en": ""
 },
 {
  "id": "04170:0024",
  "jp": "私は、大婆様とは、\\n反対の心配をしている",
  "en": ""
 },
 {
  "id": "04170:0025",
  "jp": "それだけだよ",
  "en": ""
 },
 {
  "id": "04170:0026",
  "jp": "あれ？　執事さん、\\n何してるんだろう？",
  "en": ""
 },
 {
  "id": "04170:0027",
  "jp": "ふみゅ。\\n仮面は一体？",
  "en": ""
 },
 {
  "id": "04170:0028",
  "jp": "あん？\\n執事、あんなとこで\\n何してんの？",
  "en": ""
 },
 {
  "id": "04170:0029",
  "jp": "盗み聞きをしてる\\nようにみえるね",
  "en": ""
 },
 {
  "id": "04170:0030",
  "jp": "あ、執事さん",
  "en": ""
 },
 {
  "id": "04170:0031",
  "jp": "ふみゅ？\\n仮面だ",
  "en": ""
 },
 {
  "id": "04170:0032",
  "jp": "ん？　執事がいた",
  "en": ""
 },
 {
  "id": "04170:0033",
  "jp": "大婆の言いつけで\\n芙蓉の様子を\\n窺ってるんだろうね",
  "en": ""
 },
 {
  "id": "04170:0034",
  "jp": "そういえば、ゆう君って\\n黒上の次期頭首なんだ",
  "en": ""
 },
 {
  "id": "04170:0035",
  "jp": "ところで、ゆーっちは\\n黒上次期頭首ふう",
  "en": ""
 },
 {
  "id": "04170:0036",
  "jp": "話変わるけど、今、\\nゆうが次期頭首って\\n言ってたよね？",
  "en": ""
 },
 {
  "id": "04170:0037",
  "jp": "じゃあ、シグマの\\nお爺さんか、\\nお父様かな？？",
  "en": ""
 },
 {
  "id": "04170:0038",
  "jp": "つまり、シグマの\\nご先祖さん？",
  "en": ""
 },
 {
  "id": "04170:0039",
  "jp": "ってことは、\\nシグマのご先祖よね？",
  "en": ""
 },
 {
  "id": "04170:0040",
  "jp": "そうかもね",
  "en": ""
 },
 {
  "id": "04170:0041",
  "jp": "多分、ゆうもねねも、\\n幼名か愛称だろうね",
  "en": ""
 },
 {
  "id": "04170:0042",
  "jp": "へぇ、シグマの家って、\\nそういうのつけるんだ",
  "en": ""
 },
 {
  "id": "04170:0043",
  "jp": "じゃあ、シグマは\\nしぐっち？",
  "en": ""
 },
 {
  "id": "04170:0044",
  "jp": "シグマは、なんて\\n呼ばれてたの？",
  "en": ""
 },
 {
  "id": "04170:0045",
  "jp": "愛称は、誰だって\\nつけるだろ？",
  "en": ""
 },
 {
  "id": "04170:0046",
  "jp": "や、やめてくれ",
  "en": ""
 },
 {
  "id": "04170:0047",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04170:0048",
  "jp": "ふふ、\\nまぁ、そうね",
  "en": ""
 },
 {
  "id": "04170:0049",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04170:0050",
  "jp": "あ、いや、さてね\\n覚えてないよ",
  "en": ""
 },
 {
  "id": "04170:0051",
  "jp": "え～、本当にー？",
  "en": ""
 },
 {
  "id": "04170:0052",
  "jp": "【静馬と芙蓉の会話】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04170:0053",
  "jp": "【執事の盗み聞き】\\nの刻音を手に入れた！",
  "en": ""
 }
]
