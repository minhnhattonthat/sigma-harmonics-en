[
 {
  "id": "04094:0000",
  "jp": "あ、大婆様",
  "en": ""
 },
 {
  "id": "04094:0001",
  "jp": "？\\n何か用かえ？",
  "en": ""
 },
 {
  "id": "04094:0002",
  "jp": "はい、\\n鍵をお借りしようかと",
  "en": ""
 },
 {
  "id": "04094:0003",
  "jp": "鍵？\\n何につかうんじゃ？",
  "en": ""
 },
 {
  "id": "04094:0004",
  "jp": "ユリ子が\\n見つからないのですが",
  "en": ""
 },
 {
  "id": "04094:0005",
  "jp": "厨の棚を\\n開けたいので……",
  "en": ""
 },
 {
  "id": "04094:0006",
  "jp": "ユリ子？\\nそういえば、\\n見ておらんな……",
  "en": ""
 },
 {
  "id": "04094:0007",
  "jp": "鍵は渡すが、使い\\n終わったら、ちゃんと\\n戻しといとくれ",
  "en": ""
 },
 {
  "id": "04094:0008",
  "jp": "はい、\\n分かっております",
  "en": ""
 },
 {
  "id": "04094:0009",
  "jp": "あれ？　この２人は、\\nユリ子さんを\\n見てないの？",
  "en": ""
 },
 {
  "id": "04094:0010",
  "jp": "ふみゅ？\\nユリユリ、非目撃",
  "en": ""
 },
 {
  "id": "04094:0011",
  "jp": "あんれ～、２人とも\\nユリ子見てないって\\n言ってるじゃん",
  "en": ""
 },
 {
  "id": "04094:0012",
  "jp": "ユリ子さん、\\n２階に来てたよね？",
  "en": ""
 },
 {
  "id": "04094:0013",
  "jp": "さっき、\\n上に来てたはず？",
  "en": ""
 },
 {
  "id": "04094:0014",
  "jp": "さっき、２階に\\n行ってなかったっけ？",
  "en": ""
 },
 {
  "id": "04094:0015",
  "jp": "そうだね……\\nもしかすると、",
  "en": ""
 },
 {
  "id": "04094:0016",
  "jp": "ねねが下で見かけた\\nのが、彼女の最後の\\n姿なのかもしれない",
  "en": ""
 },
 {
  "id": "04094:0017",
  "jp": "ユリ子さん、\\n下にいたのかな？",
  "en": ""
 },
 {
  "id": "04094:0018",
  "jp": "ふみゅみゅ。\\nどうやら、ユリユリは\\nまだ下にいるふう？",
  "en": ""
 },
 {
  "id": "04094:0019",
  "jp": "ってことは、\\nユリ子はまだ下？",
  "en": ""
 },
 {
  "id": "04094:0020",
  "jp": "……下に魂の影が\\nあるか見てみよう",
  "en": ""
 },
 {
  "id": "04094:0021",
  "jp": "うん",
  "en": ""
 },
 {
  "id": "04094:0022",
  "jp": "了解",
  "en": ""
 },
 {
  "id": "04094:0023",
  "jp": "おっけー",
  "en": ""
 },
 {
  "id": "04094:0024",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04094:0025",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04094:0026",
  "jp": "む……",
  "en": ""
 },
 {
  "id": "04094:0027",
  "jp": "あ、ねぇ、シグマ",
  "en": ""
 },
 {
  "id": "04094:0028",
  "jp": "シグマ、確認",
  "en": ""
 },
 {
  "id": "04094:0029",
  "jp": "そういやぁ、シグマ",
  "en": ""
 },
 {
  "id": "04094:0030",
  "jp": "佳子さんと大婆様が\\n言ってた、鍵って\\n何のことだか分かる？",
  "en": ""
 },
 {
  "id": "04094:0031",
  "jp": "よっちゃんと婆ちゃんの\\n会話中、鍵の話してたが\\n何の鍵ふう？",
  "en": ""
 },
 {
  "id": "04094:0032",
  "jp": "なんか、鍵を借りるだの\\nなんだのと、言ってた\\nけど、それって何？",
  "en": ""
 },
 {
  "id": "04094:0033",
  "jp": "多分、館の\\nマスターキーだね",
  "en": ""
 },
 {
  "id": "04094:0034",
  "jp": "この館の鍵は、全部、\\nそれ１つで開くように\\nなってるよ",
  "en": ""
 },
 {
  "id": "04094:0035",
  "jp": "へぇ、そうなんだ",
  "en": ""
 },
 {
  "id": "04094:0036",
  "jp": "ふみゅ。理解した",
  "en": ""
 },
 {
  "id": "04094:0037",
  "jp": "ふーん、なるほど",
  "en": ""
 },
 {
  "id": "04094:0038",
  "jp": "【鍵を借りた佳子】\\nの刻音を手に入れた！",
  "en": ""
 },
 {
  "id": "04094:0039",
  "jp": "ユリ子$c02殺害$c00に関する\\n刻音は揃ったかも\\nしれない",
  "en": ""
 },
 {
  "id": "04094:0040",
  "jp": "超推理を進めてみよう",
  "en": ""
 },
 {
  "id": "04094:0041",
  "jp": "超推理をしてみよう",
  "en": ""
 }
