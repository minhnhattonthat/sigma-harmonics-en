[
 {
  "id": "04086:0000",
  "jp": "……夢？",
  "en": ""
 },
 {
  "id": "04086:0001",
  "jp": "僕の名は……",
  "en": ""
 },
 {
  "id": "04086:0002",
  "jp": "黒上シグマ",
  "en": ""
 },
 {
  "id": "04086:0003",
  "jp": "そう、ここは僕の家、\\n【黒上の館】",
  "en": ""
 },
 {
  "id": "04086:0004",
  "jp": "黒上財閥という名は、\\n日本ではわりと有名だ",
  "en": ""
 },
 {
  "id": "04086:0005",
  "jp": "僕も財閥が\\n運営している\\n高校へ通っている",
  "en": ""
 },
 {
  "id": "04086:0006",
  "jp": "大時計の音",
  "en": ""
 },
 {
  "id": "04086:0007",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04086:0008",
  "jp": "えっ……？",
  "en": ""
 },
 {
  "id": "04086:0009",
  "jp": "これが、\\n黒上のもう１つの顔",
  "en": ""
 },
 {
  "id": "04086:0010",
  "jp": "遥か昔より、\\nこの大時計が封じている\\n【$c02逢魔$c00】……",
  "en": ""
 },
 {
  "id": "04086:0011",
  "jp": "黒上家は、その\\n【$c02逢魔$c00】から人々を\\n守る一族でもある",
  "en": ""
 },
 {
  "id": "04086:0012",
  "jp": "僕もそのひとり",
  "en": ""
 },
 {
  "id": "04086:0013",
  "jp": "様々な【音】を使い\\n奇跡を起こす\\n【音使い】だ",
  "en": ""
 },
 {
  "id": "04086:0014",
  "jp": "？！",
  "en": ""
 },
 {
  "id": "04086:0015",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04086:0016",
  "jp": "どうか\\nなさいましたか？",
  "en": ""
 },
 {
  "id": "04086:0017",
  "jp": "あ、いや、\\nなんでもないよ",
  "en": ""
 },
 {
  "id": "04086:0018",
  "jp": "ちょっと、\\n寝ぼけてるみたいだ",
  "en": ""
 },
 {
  "id": "04086:0019",
  "jp": "はは、左様ですか……",
  "en": ""
 },
 {
  "id": "04086:0020",
  "jp": "……様が、\\n参られています",
  "en": ""
 },
 {
  "id": "04086:0021",
  "jp": "あれ？\\nもうそんな時間かい？",
  "en": ""
 },
 {
  "id": "04086:0022",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "04086:0023",
  "jp": "分かったよ、\\nありがとう",
  "en": ""
 },
 {
  "id": "04086:0024",
  "jp": "それでは、\\n私は失礼いたします",
  "en": ""
 },
 {
  "id": "04086:0025",
  "jp": "そういえば\\n彼の仮面をつけた顔も\\n大分、見慣れてきた",
  "en": ""
 },
 {
  "id": "04086:0026",
  "jp": "黒上の執事だって\\nあの仮面で\\n現れた時は",
  "en": ""
 },
 {
  "id": "04086:0027",
  "jp": "ちょっと\\n吃驚したっけな",
  "en": ""
 },
 {
  "id": "04086:0028",
  "jp": "元々は、代々この館を\\n守っている一族だって\\n聞いたけど……",
  "en": ""
 },
 {
  "id": "04086:0029",
  "jp": "といけない、\\n人が来てるんだ、\\n急ごう",
  "en": ""
 },
 {
  "id": "04086:0030",
  "jp": "シグマー！",
  "en": ""
 },
 {
  "id": "04086:0031",
  "jp": "おはよう！",
  "en": ""
 },
 {
  "id": "04086:0032",
  "jp": "あぁ、おはよう",
  "en": ""
 },
 {
  "id": "04086:0033",
  "jp": "彼女は……",
  "en": ""
 },
 {
  "id": "04086:0034",
  "jp": "そう【月弓ネオン】",
  "en": ""
 },
 {
  "id": "04086:0035",
  "jp": "僕と同じ、\\n$c02逢魔$c00と戦う一族、\\n月弓家のひとり",
  "en": ""
 },
 {
  "id": "04086:0036",
  "jp": "【神霊】の力を\\n封じ込めた\\n【式札】を使う",
  "en": ""
 },
 {
  "id": "04086:0037",
  "jp": "つまり【札使い】だ",
  "en": ""
 },
 {
  "id": "04086:0038",
  "jp": "今日も、\\n早朝練習しよ！",
  "en": ""
 },
 {
  "id": "04086:0039",
  "jp": "早く、シグマの\\nご両親みたいに",
  "en": ""
 },
 {
  "id": "04086:0040",
  "jp": "立派な【使い人】に\\nならなきゃ！",
  "en": ""
 },
 {
  "id": "04086:0041",
  "jp": "じゃあ、練習用の\\n$c02逢魔$c00を喚ぶ前に",
  "en": ""
 },
 {
  "id": "04086:0042",
  "jp": "【神降ろし】を\\n始めるよ",
  "en": ""
 },
 {
  "id": "04086:0043",
  "jp": "準備いい？",
  "en": ""
 },
 {
  "id": "04086:0044",
  "jp": "神降ろし……\\n準備……？",
  "en": ""
 },
 {
  "id": "04086:0045",
  "jp": "……？\\n大丈夫？",
  "en": ""
 },
 {
  "id": "04086:0046",
  "jp": "なんだか、頭が\\nボーっとして……",
  "en": ""
 },
 {
  "id": "04086:0047",
  "jp": "どうしよ、今日の\\n練習やめとく？",
  "en": ""
 },
 {
  "id": "04086:0048",
  "jp": "練習……早朝練習……",
  "en": ""
 },
 {
  "id": "04086:0049",
  "jp": "私はシグマが\\n守ってくれないと、\\n戦えないから……",
  "en": ""
 },
 {
  "id": "04086:0050",
  "jp": "そうだ、月弓は、\\n$c02逢魔$c00と戦う時、",
  "en": ""
 },
 {
  "id": "04086:0051",
  "jp": "【式札】を使って\\n【神降ろし】を行う",
  "en": ""
 },
 {
  "id": "04086:0052",
  "jp": "でも、\\n神降ろしをすると、",
  "en": ""
 },
 {
  "id": "04086:0053",
  "jp": "自分自身の\\nコントロールが\\nできなくなるから",
  "en": ""
 },
 {
  "id": "04086:0054",
  "jp": "僕ら【音使い】が\\n奏でる旋律で\\n導かないといけない",
  "en": ""
 },
 {
  "id": "04086:0055",
  "jp": "うん、大丈夫",
  "en": ""
 },
 {
  "id": "04086:0056",
  "jp": "大分、\\n頭がスッキリしてきた",
  "en": ""
 },
 {
  "id": "04086:0057",
  "jp": "さぁ、\\n始めようか",
  "en": ""
 },
 {
  "id": "04086:0058",
  "jp": "うん！",
  "en": ""
 },
 {
  "id": "04086:0059",
  "jp": "月弓が名の元に\\n契約せしめし神霊よ",
  "en": ""
 },
 {
  "id": "04086:0060",
  "jp": "我が身に宿り、\\n魔を討つ力を与え賜え\\n……",
  "en": ""
 },
 {
  "id": "04086:0061",
  "jp": "神降ろし！！",
  "en": ""
 }
]
