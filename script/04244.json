[
 {
  "id": "04244:0000",
  "jp": "さっきの声は……？",
  "en": ""
 },
 {
  "id": "04244:0001",
  "jp": "佳子の声だ\\n場所は、どこだ？！",
  "en": ""
 },
 {
  "id": "04244:0002",
  "jp": "こっちの方なのは\\n確かです",
  "en": ""
 },
 {
  "id": "04244:0003",
  "jp": "娯楽室の方へ\\n行ってみましょう！",
  "en": ""
 },
 {
  "id": "04244:0004",
  "jp": "麟君、冷静だね\\nこういうことに\\n慣れてるみたい",
  "en": ""
 },
 {
  "id": "04244:0005",
  "jp": "ふみゅ。りんりん\\n思いの外、場慣れ\\nしてるふう",
  "en": ""
 },
 {
  "id": "04244:0006",
  "jp": "あの麟って子\\n全然、子供っぽくなくて\\n冷静すぎ",
  "en": ""
 },
 {
  "id": "04244:0007",
  "jp": "言の葉使いは表の世界\\nにも協力してるらしいし",
  "en": ""
 },
 {
  "id": "04244:0008",
  "jp": "僕らが思ってるより\\n色々と経験してる\\nのかもね",
  "en": ""
 },
 {
  "id": "04244:0009",
  "jp": "【回廊で会った３人】\\nの刻音を手に入れた！",
  "en": ""
 }
