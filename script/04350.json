[
 {
  "id": "04350:0000",
  "jp": "大婆様に始まり、\\nねね、佳子…",
  "en": ""
 },
 {
  "id": "04350:0001",
  "jp": "はい、麟様、芙蓉様も\\nお部屋で\\n亡くなられて……",
