[
 {
  "id": "04204:0000",
  "jp": "ネオン！！！",
  "en": ""
 },
 {
  "id": "04204:0001",
  "jp": "時空が割れる音\\n（仮）",
  "en": ""
 },
 {
  "id": "04204:0002",
  "jp": "お前は一体何だ？",
  "en": ""
 },
 {
  "id": "04204:0003",
  "jp": "私が計画した、\\n黒上消滅の過去を",
  "en": ""
 },
 {
  "id": "04204:0004",
  "jp": "ことごとく調律\\nしてのけただと！",
  "en": ""
 },
 {
  "id": "04204:0005",
  "jp": "なっ？！　譲葉麟！？",
  "en": ""
 },
 {
  "id": "04204:0006",
  "jp": "お、お前が変革者？！\\nまさか時渡りを？！",
  "en": ""
 },
 {
  "id": "04204:0007",
  "jp": "答えろ！\\nお前はなんだ？",
  "en": ""
 },
 {
  "id": "04204:0008",
  "jp": "変革されし時の流れを\\n避けた黒上？",
  "en": ""
 },
 {
  "id": "04204:0009",
  "jp": "いや、違うな",
  "en": ""
 },
 {
  "id": "04204:0010",
  "jp": "そんなものが存在\\nするはずがない",
  "en": ""
 },
 {
  "id": "04204:0011",
  "jp": "時の流れを避けること\\nなど誰にもできない",
  "en": ""
 },
 {
  "id": "04204:0012",
  "jp": "でも、僕はここにいる",
  "en": ""
 },
 {
  "id": "04204:0013",
  "jp": "ありえん……",
  "en": ""
 },
 {
  "id": "04204:0014",
  "jp": "では、お前は何を犠牲\\nにしてここに来た？",
  "en": ""
 },
 {
  "id": "04204:0015",
  "jp": "犠牲？　僕は犠牲など\\nだしていない",
  "en": ""
 },
 {
  "id": "04204:0016",
  "jp": "はっ！　笑わせるな",
  "en": ""
 },
 {
  "id": "04204:0017",
  "jp": "犠牲もなしに\\n時が紡げる人間など\\n存在するか",
  "en": ""
 },
 {
  "id": "04204:0018",
  "jp": "あの大時計は、人の\\n命を喰らい時を紡ぐ",
  "en": ""
 },
 {
  "id": "04204:0019",
  "jp": "それも、\\n神代より受け継がれし\\n命しか受け付けない",
  "en": ""
 },
 {
  "id": "04204:0020",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04204:0021",
  "jp": "知っているだろう？",
  "en": ""
 },
 {
  "id": "04204:0022",
  "jp": "黒上は、\\nコクジョウ、国の常、",
  "en": ""
 },
 {
  "id": "04204:0023",
  "jp": "遙か昔、日本が\\n大和と呼ばれた\\n時代から存在する",
  "en": ""
 },
 {
  "id": "04204:0024",
  "jp": "古き神の血族だ",
  "en": ""
 },
 {
  "id": "04204:0025",
  "jp": "法水の姓を持つ、\\n私たち兄妹にも\\n神の血は流れていた",
  "en": ""
 },
 {
  "id": "04204:0026",
  "jp": "だから私は、\\n時を紡ぐため妹の命を、\\nあの時計に喰らわせた",
  "en": ""
 },
 {
  "id": "04204:0027",
  "jp": "妹を……？",
  "en": ""
 },
 {
  "id": "04204:0028",
  "jp": "そうだ、お前も\\n黒上だと言うのなら、\\n知っているはずだ",
  "en": ""
 },
 {
  "id": "04204:0029",
  "jp": "時紡ぎは、命を摘む",
  "en": ""
 },
 {
  "id": "04204:0030",
  "jp": "大時計に捧げられし\\n命は輪廻から外れ、",
  "en": ""
 },
 {
  "id": "04204:0031",
  "jp": "やがて$c02逢魔人$c00となり\\n時を憎む……とな",
  "en": ""
 },
 {
  "id": "04204:0032",
  "jp": "だから問おう",
  "en": ""
 },
 {
  "id": "04204:0033",
  "jp": "お前が黒上として\\n時を紡いだのなら、",
  "en": ""
 },
 {
  "id": "04204:0034",
  "jp": "一体、何を己が\\n業にしてここにきた",
  "en": ""
 },
 {
  "id": "04204:0035",
  "jp": "僕……は……",
  "en": ""
 },
 {
  "id": "04204:0036",
  "jp": "ネオン……？",
  "en": ""
 },
 {
  "id": "04204:0037",
  "jp": "ネオンだと……？",
  "en": ""
 },
 {
  "id": "04204:0038",
  "jp": "月弓音音か？",
  "en": ""
 },
 {
  "id": "04204:0039",
  "jp": "なるほど、\\n月弓家は月読の末裔、",
  "en": ""
 },
 {
  "id": "04204:0040",
  "jp": "贄になるには\\n相応しい……",
  "en": ""
 },
 {
  "id": "04204:0041",
  "jp": "いや、待て、\\nお前のいる未来、",
  "en": ""
 },
 {
  "id": "04204:0042",
  "jp": "月弓音音が生きている\\nというのか？",
  "en": ""
 },
 {
  "id": "04204:0043",
  "jp": "ますますおかしい、",
  "en": ""
 },
 {
  "id": "04204:0044",
  "jp": "月弓音音が生きている\\n《時》から来ただと、",
  "en": ""
 },
 {
  "id": "04204:0045",
  "jp": "ならばやはり、\\nお前は何者だ？",
  "en": ""
 },
 {
  "id": "04204:0046",
  "jp": "……？",
  "en": ""
 },
 {
  "id": "04204:0047",
  "jp": "分からぬのか？",
  "en": ""
 },
 {
  "id": "04204:0048",
  "jp": "お前のいうネオンは、",
  "en": ""
 },
 {
  "id": "04204:0049",
  "jp": "この時間では\\n《ねね》という愛称で、\\n呼ばれていただろう？",
  "en": ""
 },
 {
  "id": "04204:0050",
  "jp": "あれを犠牲に\\nしたのなら……",
  "en": ""
 },
 {
  "id": "04204:0051",
  "jp": "ち、違う！",
  "en": ""
 },
 {
  "id": "04204:0052",
  "jp": "何が違う？",
  "en": ""
 },
 {
  "id": "04204:0053",
  "jp": "まさか、アイツが\\n庇っていた……",
  "en": ""
 },
 {
  "id": "04204:0054",
  "jp": "《ゆう》とかいう\\nガキか？",
  "en": ""
 },
 {
  "id": "04204:0055",
  "jp": "いや、違うな……",
  "en": ""
 },
 {
  "id": "04204:0056",
  "jp": "あのガキは、\\n確か本来の歴史でも、\\n車に轢かれ$c02死$c00……",
  "en": ""
 },
 {
  "id": "04204:0057",
  "jp": "車がぶつかる音\\n遠くから救急車の音\\n誰かが駆け寄る音（仮）",
  "en": ""
 },
 {
  "id": "04204:0058",
  "jp": "違う！！",
  "en": ""
 },
 {
  "id": "04204:0059",
  "jp": "な？！",
  "en": ""
 },
 {
  "id": "04204:0060",
  "jp": "違う……こんな\\n世界は知らない……",
  "en": ""
 },
 {
  "id": "04204:0061",
  "jp": "取り戻す……\\n元の世界を……",
  "en": ""
 },
 {
  "id": "04204:0062",
  "jp": "そんな馬鹿な！！",
  "en": ""
 },
 {
  "id": "04204:0063",
  "jp": "これは、\\n調律ではない？！",
  "en": ""
 },
 {
  "id": "04204:0064",
  "jp": "再構築？！\\nい、いや違う……",
  "en": ""
 },
 {
  "id": "04204:0065",
  "jp": "消失？\\n存在の……否定？",
  "en": ""
 },
 {
  "id": "04204:0066",
  "jp": "？！　まさか！！",
  "en": ""
 },
 {
  "id": "04204:0067",
  "jp": "お前は\\n《シグマ》なのか？！",
  "en": ""
 },
 {
  "id": "04204:0068",
  "jp": "そうだ……\\n僕は、黒上シグマ……",
  "en": ""
 },
 {
  "id": "04204:0069",
  "jp": "僕の知っている\\n世界……",
  "en": ""
 },
 {
  "id": "04204:0070",
  "jp": "それが本当の世界だ\\n……だから……",
  "en": ""
 },
 {
  "id": "04204:0071",
  "jp": "くっ……\\nははははは！！",
  "en": ""
 },
 {
  "id": "04204:0072",
  "jp": "なるほど、",
  "en": ""
 },
 {
  "id": "04204:0073",
  "jp": "結局、私は\\n黒上のシグマによって\\n否定されるのか！",
  "en": ""
 },
 {
  "id": "04204:0074",
  "jp": "くっはははははは！\\nなんという因果だ！",
  "en": ""
 },
 {
  "id": "04204:0075",
  "jp": "時の調律を始める",
  "en": ""
 },
 {
  "id": "04204:0076",
  "jp": "……はっ、まぁいい",
  "en": ""
 },
 {
  "id": "04204:0077",
  "jp": "これなら私も……\\n時を紡いだ……",
  "en": ""
 },
 {
  "id": "04204:0078",
  "jp": "価値が……あった\\nのかもしれん……",
  "en": ""
 },
 {
  "id": "04204:0079",
  "jp": "……取り戻した……",
  "en": ""
 },
 {
  "id": "04204:0080",
  "jp": "おはよう……",
  "en": ""
 },
 {
  "id": "04204:0081",
  "jp": "…………？",
  "en": ""
 },
 {
  "id": "04204:0082",
  "jp": "あなた……誰？",
  "en": ""
 },
 {
  "id": "04204:0083",
  "jp": "えっ？",
  "en": ""
 },
 {
  "id": "04204:0084",
  "jp": "？！",
  "en": ""
 }
]
