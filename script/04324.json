 },
 {
  "id": "04324:0221",
  "jp": "シグマ、変",
  "en": ""
 },
 {
  "id": "04324:0222",
  "jp": "ご頭首、$c02死$c00んだ後でも\\n事件起きてる",
  "en": ""
 },
 {
  "id": "04324:0223",
  "jp": "あれは何故？",
  "en": ""
 },
 {
  "id": "04324:0224",
  "jp": "待った！",
  "en": ""
 },
 {
  "id": "04324:0225",
  "jp": "頭首が$c02死$c00んだ後も、\\n事件は起きてるでしょ？",
  "en": ""
 },
 {
  "id": "04324:0226",
  "jp": "どう説明をつける\\nつもり？",
