 },
 {
  "id": "04324:0204",
  "jp": "えー、それを言ったら、\\n佳子よりも力の無い、",
  "en": ""
 },
 {
  "id": "04324:0205",
  "jp": "大婆やねねにだって\\n犯行は可能でしょ？",
  "en": ""
 },
 {
  "id": "04324:0206",
  "jp": "うん、そこが逆に\\n怪しいんだ",
  "en": ""
 },
 {
  "id": "04324:0207",
  "jp": "僕の超推理がそういう\\n結論を導き出した",
  "en": ""
 },
 {
  "id": "04324:0208",
  "jp": "そ、そう……",
