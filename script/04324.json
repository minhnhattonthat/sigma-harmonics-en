 },
 {
  "id": "04324:0238",
  "jp": "事故ねぇ",
  "en": ""
 },
 {
  "id": "04324:0239",
  "jp": "ああ、もし静馬が\\n今言ったような装置を\\n仕掛けたとしたら、",
