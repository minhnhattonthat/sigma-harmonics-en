 },
 {
  "id": "04324:0178",
  "jp": "うん、普通のお茶会\\nだったと思うけど",
  "en": ""
 },
 {
  "id": "04324:0179",
  "jp": "覚えてる。\\nごくごく平和な出来事",
  "en": ""
 },
 {
  "id": "04324:0180",
  "jp": "うん、覚えてるよ。\\n別に普通だった\\nでしょ？",
  "en": ""
 },
 {
  "id": "04324:0181",
  "jp": "あの時、大婆の出した\\n茶に、$c02毒物$c00が混入されて\\nいたんだ",
  "en": ""
 },
 {
  "id": "04324:0182",
  "jp": "$c02毒物$c00……",
  "en": ""
 },
 {
  "id": "04324:0183",
  "jp": "超スピードで走る$c02毒$c00？",
  "en": ""
 },
 {
  "id": "04324:0184",
  "jp": "$c02毒物$c00？",
  "en": ""
 },
 {
  "id": "04324:0185",
  "jp": "ハシリドコロ、\\nという植物がある",
  "en": ""
 },
 {
  "id": "04324:0186",
  "jp": "この植物を食べて\\nしまうと、$c02猛毒$c00が\\n副交感神経に作用して",
  "en": ""
 },
 {
  "id": "04324:0187",
  "jp": "錯乱状態に陥り、\\n走り回った挙句、\\n$c02死亡$c00するという",
  "en": ""
 },
 {
  "id": "04324:0188",
  "jp": "おそらく、これに類する\\n毒を混ぜ、ユリ子を\\n$c02死$c00に追いやったのさ",
  "en": ""
 },
 {
  "id": "04324:0189",
  "jp": "へぇ、そうなんだ",
  "en": ""
 },
 {
  "id": "04324:0190",
  "jp": "ふみゅ",
  "en": ""
 },
 {
  "id": "04324:0191",
  "jp": "ふーん",
  "en": ""
 },
 {
  "id": "04324:0192",
  "jp": "これが超推理によって\\n導き出された結論だ",
  "en": ""
 },
 {
  "id": "04324:0193",
  "jp": "さぁ、行こう",
  "en": ""
 },
 {
  "id": "04324:0194",
  "jp": "$c02大逢魔$c00は\\n【中庭】\\nにいるはずだ",
  "en": ""
 },
 {
  "id": "04324:0195",
  "jp": "えっ、そうなんだ？",
  "en": ""
 },
 {
  "id": "04324:0196",
  "jp": "ふみゅ？",
  "en": ""
 },
 {
  "id": "04324:0197",
  "jp": "ホント？",
  "en": ""
 },
 {
  "id": "04324:0198",
  "jp": "ああ、今回は銃を使った\\n犯行だからね",
  "en": ""
 },
 {
  "id": "04324:0199",
  "jp": "誰にだって静馬を\\n$c02殺害$c00することは\\nできたはずさ",
  "en": ""
 },
 {
  "id": "04324:0200",
  "jp": "でも、それを言ったら、\\n佳子さんよりもっと\\n力の無い、",
  "en": ""
 },
 {
  "id": "04324:0201",
  "jp": "大婆様やねねちゃんにも\\n犯行は可能よね？",
  "en": ""
 },
 {
  "id": "04324:0202",
  "jp": "変。そしたらよっちゃん\\nでなく、もっと弱い",
  "en": ""
 },
 {
  "id": "04324:0203",
  "jp": "婆ちゃん、ねねっちでも\\n犯行可能",
