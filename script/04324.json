 },
 {
  "id": "04324:0248",
  "jp": "それ以外には\\n考えられない",
  "en": ""
 },
 {
  "id": "04324:0249",
  "jp": "$c02大逢魔$c00は、最も\\n事件に影響を及ぼした\\n場所にいるはずだ",
  "en": ""
 },
 {
  "id": "04324:0250",
