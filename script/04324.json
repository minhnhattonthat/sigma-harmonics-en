 },
 {
  "id": "04324:0244",
  "jp": "館内に装置を仕掛け、\\n自分の部屋に戻った",
  "en": ""
 },
 {
  "id": "04324:0245",
  "jp": "しかしそこでテスト用に\\n仕掛けていた装置が\\n動き出し、静馬を撃った",
  "en": ""
 },
 {
  "id": "04324:0246",
  "jp": "超推理はこういう結論を\\n導き出したのさ",
  "en": ""
 },
 {
  "id": "04324:0247",
  "jp": "やはり犯行は\\n$c02逢魔$c00の仕業だろう",
