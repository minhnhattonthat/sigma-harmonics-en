  "en": ""
 },
 {
  "id": "04324:0021",
  "jp": "う、うん",
  "en": ""
 },
 {
  "id": "04324:0022",
  "jp": "ふみゅ",
  "en": ""
 },
 {
  "id": "04324:0023",
  "jp": "わかったわよ\\n行けばいいんでしょ！",
  "en": ""
 },
 {
  "id": "04324:0024",
