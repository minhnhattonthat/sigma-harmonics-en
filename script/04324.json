 },
 {
  "id": "04324:0026",
  "jp": "ユリ子",
  "en": ""
 },
 {
  "id": "04324:0027",
  "jp": "大婆",
  "en": ""
 },
 {
  "id": "04324:0028",
  "jp": "ねね",
  "en": ""
 },
 {
  "id": "04324:0029",
  "jp": "静馬",
  "en": ""
 },
 {
  "id": "04324:0030",
  "jp": "執事",
  "en": ""
 },
 {
  "id": "04324:0031",
  "jp": "どういうこと？",
  "en": ""
 },
 {
  "id": "04324:0032",
  "jp": "何故？",
  "en": ""
 },
 {
  "id": "04324:0033",
  "jp": "どーゆーこと？",
  "en": ""
 },
 {
  "id": "04324:0034",
  "jp": "順を追って話そうか",
  "en": ""
 },
 {
  "id": "04324:0035",
  "jp": "まず、静馬が銃で\\n襲われた、一度目の$c02殺人$c00",
  "en": ""
 },
 {
  "id": "04324:0036",
  "jp": "僕らが１８時の再演で\\n視たように、遺体が\\n発見されたのは",
  "en": ""
 },
 {
  "id": "04324:0037",
  "jp": "銃撃からだいぶ時間が\\n経ってからだ",
  "en": ""
 },
 {
  "id": "04324:0038",
  "jp": "銃で撃たれたのに、\\n遺体の発見は\\n遅れた……",
  "en": ""
 },
 {
  "id": "04324:0039",
  "jp": "ズギューンなのに\\n知らんぷり？",
  "en": ""
 },
 {
  "id": "04324:0040",
  "jp": "みんな銃声に\\n気づかなかった、ってん\\nでしょ？",
  "en": ""
 },
 {
  "id": "04324:0041",
  "jp": "ああ",
  "en": ""
 },
 {
  "id": "04324:0042",
  "jp": "これは、犯人が\\nサイレンサーか何かを\\n使って、",
  "en": ""
 },
 {
  "id": "04324:0043",
  "jp": "秘密裏に事を\\n済ませようと\\nしたんだろうね",
  "en": ""
 },
 {
  "id": "04324:0044",
  "jp": "サイレンサーって\\nあれよね？",
  "en": ""
 },
 {
  "id": "04324:0045",
  "jp": "サイレンサー、\\n確か銃がだんまりを\\n決め込む？",
  "en": ""
 },
 {
  "id": "04324:0046",
  "jp": "サイレンサー、つまり\\n消音機付きで撃った",
  "en": ""
 },
 {
  "id": "04324:0047",
  "jp": "確かに再演の時も\\n大きな音は聞こえて\\nなかったわ",
  "en": ""
 },
 {
  "id": "04324:0048",
  "jp": "うん、銃に取りつける\\n消音機さ",
  "en": ""
 },
 {
  "id": "04324:0049",
  "jp": "１７時の再演でも、\\n大きな音は聞こえ\\nなかったろう？",
  "en": ""
 },
 {
  "id": "04324:0050",
  "jp": "なるほど、\\nだから静馬さんが\\n$c02殺$c00されたのは、",
  "en": ""
 },
 {
  "id": "04324:0051",
  "jp": "ユリ子さんが掃除に\\n来るまで、誰にも\\n気づかれなかったのね",
  "en": ""
 },
 {
  "id": "04324:0052",
  "jp": "ふみゅ",
  "en": ""
 },
 {
  "id": "04324:0053",
  "jp": "だからご頭首の遺体は、\\nユリユリが後に発見",
  "en": ""
 },
 {
  "id": "04324:0054",
  "jp": "なるほど、だから\\n頭首が$c02殺$c00されたって\\nことは、",
  "en": ""
 },
 {
  "id": "04324:0055",
  "jp": "ユリ子が掃除に来た時、\\n初めて発覚したのね",
  "en": ""
 },
 {
  "id": "04324:0056",
  "jp": "そして次に、執事が\\n撃たれた状況に関して\\n考えてみよう",
  "en": ""
 },
 {
  "id": "04324:0057",
  "jp": "こちらも銃撃だけど、\\n静馬の時とは大きな\\n違いがある",
  "en": ""
 },
 {
  "id": "04324:0058",
  "jp": "うん、今度は銃声を\\n聞いて、すぐにみんなが\\n集まってきてる",
  "en": ""
 },
 {
  "id": "04324:0059",
  "jp": "ふみゅ、鳴り響く銃声に\\n誘われて全員集合",
  "en": ""
 },
 {
  "id": "04324:0060",
  "jp": "ズギューン、ってしたから\\nみんな大慌てで\\n駆けつけてる",
  "en": ""
 },
 {
  "id": "04324:0061",
  "jp": "$c02逢魔$c00が操れる人間は\\n一人だけ",
  "en": ""
 },
 {
  "id": "04324:0062",
  "jp": "静馬を$c02殺害$c00する時は\\n慎重に事を運んだ\\n犯人が、",
  "en": ""
 },
 {
  "id": "04324:0063",
  "jp": "執事の時は、銃声が\\n響きわたるのを\\n気にしていない",
  "en": ""
 },
 {
  "id": "04324:0064",
  "jp": "同一犯による\\n犯行にしては、\\nあまりにも不自然だね",
  "en": ""
 },
 {
  "id": "04324:0065",
  "jp": "つまり犯人は、銃声に\\n気づいた誰かが、",
  "en": ""
 },
 {
  "id": "04324:0066",
  "jp": "わざと自分の走り去る\\n姿を目撃するように\\n仕向けた、",
  "en": ""
 },
 {
  "id": "04324:0067",
  "jp": "と考えられるんじゃ\\nないかな",
  "en": ""
 },
 {
  "id": "04324:0068",
  "jp": "つまり佳子さんが、\\nユリ子さんに罪を\\n押しつけるために……",
  "en": ""
 },
 {
  "id": "04324:0069",
  "jp": "即ち、よっちゃんの罠。\\n罪がユリユリに\\nかぶさるふうに？",
  "en": ""
 },
 {
  "id": "04324:0070",
  "jp": "よーするに、佳子が\\nユリ子に罪を\\nかぶせようとして？",
  "en": ""
 },
 {
  "id": "04324:0071",
  "jp": "そう、ユリ子の服を着て\\n走り去った",
  "en": ""
 },
 {
  "id": "04324:0072",
  "jp": "うーん、でも、\\nそれだけで佳子さんが\\n犯人だって",
  "en": ""
 },
 {
  "id": "04324:0073",
  "jp": "決めつけるのは、\\nちょっと無理が\\nあるんじゃない？",
  "en": ""
 },
 {
  "id": "04324:0074",
  "jp": "シグマ、私は疑問",
  "en": ""
 },
 {
  "id": "04324:0075",
  "jp": "よっちゃんを\\n犯人とする根拠、\\nちょっと弱いふう？",
  "en": ""
 },
 {
  "id": "04324:0076",
  "jp": "えー、でもさ、それだけで\\n佳子が犯人だって\\n決めつけるのは、",
  "en": ""
 },
 {
  "id": "04324:0077",
  "jp": "ちょっと強引なんじゃ\\nないの？",
  "en": ""
 },
 {
  "id": "04324:0078",
  "jp": "もう１つ、佳子の犯行を\\n裏付ける、おかしな\\n行動があるのさ",
  "en": ""
 },
 {
  "id": "04324:0079",
  "jp": "そんなのあったっけ？",
  "en": ""
 },
 {
  "id": "04324:0080",
  "jp": "ふみゅ？",
  "en": ""
 },
 {
  "id": "04324:0081",
  "jp": "えっ、どんなの？",
  "en": ""
 },
 {
  "id": "04324:0082",
  "jp": "静馬が$c02殺$c00された後、\\n佳子がとった行動",
  "en": ""
 },
 {
  "id": "04324:0083",
  "jp": "執事との会話を\\n思い出してごらん",
  "en": ""
 },
 {
  "id": "04324:0084",
  "jp": "会話には、おかしな所は\\nなかった……はず",
  "en": ""
 },
 {
  "id": "04324:0085",
  "jp": "追憶の彼方より。\\n呼び出しても、\\n会話怪しくなくない",
  "en": ""
 },
 {
  "id": "04324:0086",
  "jp": "うーん、別に変な会話\\nじゃなかったよ？",
  "en": ""
 },
 {
  "id": "04324:0087",
  "jp": "よく思い出してごらん。\\n会話の後、佳子が\\n向かったのは……",
  "en": ""
 },
 {
  "id": "04324:0088",
  "jp": "あっ！",
  "en": ""
 },
 {
  "id": "04324:0089",
  "jp": "部屋に閉じこもるって\\n言ってるのに、\\n逆の方向へ！",
  "en": ""
 },
 {
  "id": "04324:0090",
  "jp": "吃驚仰天",
  "en": ""
 },
 {
  "id": "04324:0091",
  "jp": "言われて然り、\\nよっちゃんの部屋は\\n真逆な感じ",
  "en": ""
 },
 {
  "id": "04324:0092",
  "jp": "ややや！",
  "en": ""
 },
 {
  "id": "04324:0093",
  "jp": "佳子、部屋に閉じこもる\\nっていいながら、\\n部屋とは逆の方へ！",
  "en": ""
 },
 {
  "id": "04324:0094",
  "jp": "そう、佳子はこの会話の後\\nユリ子の部屋へ行き、\\nユリ子を$c02殺$c00した",
  "en": ""
 },
 {
  "id": "04324:0095",
  "jp": "そしてユリ子の服に\\n着替えて、執事を\\n撃ったのさ",
  "en": ""
 },
 {
  "id": "04324:0096",
  "jp": "でもシグマ、執事さんの\\n部屋には鍵が\\nかかってたでしょ？",
  "en": ""
 },
 {
  "id": "04324:0097",
  "jp": "マスターキーはずっと\\n大婆様が持ってた、\\nってことだけど、",
  "en": ""
 },
 {
  "id": "04324:0098",
  "jp": "大婆様に気づかれない\\nように借りて、",
  "en": ""
 },
 {
  "id": "04324:0099",
  "jp": "またこっそり\\n返しておいたってこと？",
  "en": ""
 },
 {
  "id": "04324:0100",
  "jp": "シグマ、も１つ確認。\\n仮面密室$c02殺人$c00事件",
  "en": ""
 },
 {
  "id": "04324:0101",
  "jp": "マスターキー、\\n婆ちゃん管理のはず",
  "en": ""
 },
 {
  "id": "04324:0102",
  "jp": "よっちゃん、婆ちゃんの\\n懐からこっそり借りて、\\nまたこっそり返却？",
  "en": ""
 },
 {
  "id": "04324:0103",
  "jp": "あっ、でもシグマ。\\nそうなると執事の部屋を\\n密室にしたのも、",
  "en": ""
 },
 {
  "id": "04324:0104",
  "jp": "佳子がやったってこと？",
  "en": ""
 },
 {
  "id": "04324:0105",
  "jp": "マスターキーは大婆が\\nずっと持ってたんだし、",
  "en": ""
 },
 {
  "id": "04324:0106",
  "jp": "こっそり借りて、\\nまたこっそり返した、\\nとでも言うわけ？",
  "en": ""
 },
 {
  "id": "04324:0107",
  "jp": "いや、その必要はないよ",
  "en": ""
 },
 {
  "id": "04324:0108",
  "jp": "えっ？",
  "en": ""
 },
 {
  "id": "04324:0109",
  "jp": "ふみゅ？",
  "en": ""
 },
 {
  "id": "04324:0110",
  "jp": "ええっ？",
  "en": ""
 },
 {
  "id": "04324:0111",
  "jp": "執事の部屋の前に\\nあった血痕。\\nこれが何よりの証拠さ",
  "en": ""
 },
 {
  "id": "04324:0112",
  "jp": "どういうこと？",
  "en": ""
 },
 {
  "id": "04324:0113",
  "jp": "？",
  "en": ""
 },
 {
  "id": "04324:0114",
  "jp": "訳わかんない",
  "en": ""
 },
 {
  "id": "04324:0115",
  "jp": "銃声があれだけ大きく\\n鳴り響いたことからも\\nわかるように、",
  "en": ""
 },
 {
  "id": "04324:0116",
  "jp": "執事は廊下で\\n撃たれたに違いない",
  "en": ""
 },
 {
  "id": "04324:0117",
  "jp": "そして撃たれた直後、\\n執事にはまだ\\n息があった",
  "en": ""
 },
 {
  "id": "04324:0118",
  "jp": "じゃあ、執事さんは、\\n犯人から逃げる為に、\\n自分の部屋へ入って…",
  "en": ""
 },
 {
  "id": "04324:0119",
  "jp": "迫る$c02殺人鬼$c00。逃げる仮面。\\n仮面は部屋に逃避。\\nそしてそして…",
  "en": ""
 },
 {
  "id": "04324:0120",
  "jp": "じゃあ、執事は、犯人から\\n逃げようと、自分の\\n部屋へ入って…",
  "en": ""
 },
 {
  "id": "04324:0121",
  "jp": "そう、自分で鍵を掛け、\\n部屋の中で絶命した",
  "en": ""
 },
 {
  "id": "04324:0122",
  "jp": "部屋の外にあったのは、\\n撃たれた時の血痕だね",
  "en": ""
 },
 {
  "id": "04324:0123",
  "jp": "なるほど",
  "en": ""
 },
 {
  "id": "04324:0124",
  "jp": "腑に落下",
  "en": ""
 },
 {
  "id": "04324:0125",
  "jp": "ふーん",
  "en": ""
 },
 {
  "id": "04324:0126",
  "jp": "図らずも密室になった\\nことは、犯人にとって\\n有利に働いたけど",
  "en": ""
 },
 {
  "id": "04324:0127",
  "jp": "ユリ子の$c02死$c00に関しては、\\nねねが不審を\\n抱いてしまった",
  "en": ""
 },
 {
  "id": "04324:0128",
  "jp": "これが大きな誤算\\nだったようだね",
  "en": ""
 },
 {
  "id": "04324:0129",
  "jp": "さぁ、行こう",
  "en": ""
 },
 {
  "id": "04324:0130",
  "jp": "$c02大逢魔$c00は\\n【静馬の部屋】\\nにいるはずだ",
  "en": ""
 },
 {
  "id": "04324:0131",
  "jp": "うん、そういう\\nことだろうね",
  "en": ""
 },
 {
  "id": "04324:0132",
  "jp": "えー、そうかなぁ？",
  "en": ""
 },
 {
  "id": "04324:0133",
  "jp": "だろうか？",
  "en": ""
 },
 {
  "id": "04324:0134",
  "jp": "あ、それでいいんだ？",
  "en": ""
 },
 {
  "id": "04324:0135",
  "jp": "そんなことはないさ、\\n僕の超推理がそういう\\n結論を出したんだ",
  "en": ""
 },
 {
  "id": "04324:0136",
  "jp": "それに、執事さんの\\n部屋には鍵が\\nかかってたでしょ？",
  "en": ""
 },
 {
  "id": "04324:0137",
  "jp": "ふみゅふみゅ。\\nあとあと、仮面の密室は？",
  "en": ""
 },
 {
  "id": "04324:0138",
  "jp": "あとさ、執事の部屋には\\n鍵、かかってたじゃん？\\nあの密室も、",
  "en": ""
 },
 {
  "id": "04324:0139",
  "jp": "そうなの？",
  "en": ""
 },
 {
  "id": "04324:0140",
  "jp": "そう？",
  "en": ""
 },
 {
  "id": "04324:0141",
  "jp": "えっ、そうなの？",
  "en": ""
 },
 {
  "id": "04324:0142",
  "jp": "ああ、静馬を襲ったのも、\\n執事を襲ったのも、\\nユリ子に違いない",
  "en": ""
 },
 {
  "id": "04324:0143",
  "jp": "でも、ユリ子さんが犯人\\nだとしたら、一体いつ\\n執事さんを撃ったの？",
  "en": ""
 },
 {
  "id": "04324:0144",
  "jp": "遺体の状態から見て、\\n$c02死$c00んですぐとは思えない\\nって、",
  "en": ""
 },
 {
  "id": "04324:0145",
  "jp": "シグマが言ったん\\nだよね？",
  "en": ""
 },
 {
  "id": "04324:0146",
  "jp": "疑問。\\nユリユリ犯人のとき、\\n執事は何時撃たれた？",
  "en": ""
 },
 {
  "id": "04324:0147",
  "jp": "ユリユリの遺体、\\n$c02死$c00んでしばらくふう",
  "en": ""
 },
 {
  "id": "04324:0148",
  "jp": "シグマもそう言った",
  "en": ""
 },
 {
  "id": "04324:0149",
  "jp": "でもさ、ユリ子が犯人\\nだったら、いつ執事を\\n襲ったってのよ",
  "en": ""
 },
 {
  "id": "04324:0150",
  "jp": "遺体の状態が、$c02死$c00んで\\nすぐじゃないみたい\\nだって、",
  "en": ""
 },
 {
  "id": "04324:0151",
  "jp": "シグマが言ったんじゃ\\nなかったっけ？",
  "en": ""
 },
 {
  "id": "04324:0152",
  "jp": "そんなこと\\n言ったかな……",
  "en": ""
 },
 {
  "id": "04324:0153",
  "jp": "きっと遺体を発見した\\n３人の勘違いだよ",
  "en": ""
 },
 {
  "id": "04324:0154",
  "jp": "立て続けに人が$c02死$c00んで、\\n気が動転して\\nいたんだろう",
  "en": ""
 },
 {
  "id": "04324:0155",
  "jp": "自分たちが思うよりも、\\n実際はずっと長く\\n執事の部屋に居た、",
  "en": ""
 },
 {
  "id": "04324:0156",
  "jp": "ということも\\nあり得るしね",
  "en": ""
 },
 {
  "id": "04324:0157",
  "jp": "それに、執事さんの\\n部屋には鍵が\\nかかってたでしょ？",
  "en": ""
 },
 {
  "id": "04324:0158",
  "jp": "マスターキーはずっと\\n大婆様が持ってた、\\nってことだけど……",
  "en": ""
 },
 {
  "id": "04324:0159",
  "jp": "シグマ、も１つ確認。\\n仮面密室$c02殺人$c00事件",
  "en": ""
 },
 {
  "id": "04324:0160",
  "jp": "マスターキー、\\n婆ちゃん管理のはず",
  "en": ""
 },
 {
  "id": "04324:0161",
  "jp": "あっ、でもシグマ。\\nそうなると執事の部屋を\\n密室にしたのも、",
  "en": ""
 },
 {
  "id": "04324:0162",
  "jp": "ユリ子がやったっ\\nてこと？",
  "en": ""
 },
 {
  "id": "04324:0163",
  "jp": "いや、あの犯行には、\\nマスターキーは\\n必要無いんだ",
  "en": ""
 },
 {
  "id": "04324:0164",
  "jp": "ユリ子は廊下で執事を\\n撃ち$c02殺$c00し、その場から\\n全速力で駆け去った",
  "en": ""
 },
 {
  "id": "04324:0165",
  "jp": "そこを大婆に目撃\\nされたのさ。\\n単純な事件だね",
  "en": ""
 },
 {
  "id": "04324:0166",
  "jp": "さぁ、行こう",
  "en": ""
 },
 {
  "id": "04324:0167",
  "jp": "$c02大逢魔$c00は\\n【ユリ子の部屋】\\nにいるはずだ",
  "en": ""
 },
 {
  "id": "04324:0168",
  "jp": "ああ、何よりも、\\n執事が$c02死亡$c00していた\\n状況から見て、",
  "en": ""
 },
 {
  "id": "04324:0169",
  "jp": "マスターキーを所持\\nしていた大婆以外には、\\n犯行は不可能だ",
  "en": ""
 },
 {
  "id": "04324:0170",
  "jp": "でも、廊下を走り去って\\nいったユリ子さんは、\\nどう説明するの？",
  "en": ""
 },
 {
  "id": "04324:0171",
  "jp": "ふみゅ？\\n廊下で一人運動会してた\\nユリユリは何？",
  "en": ""
 },
 {
  "id": "04324:0172",
  "jp": "えっ、でも、廊下を\\n走ってったユリ子は、\\n一体何だったの？",
  "en": ""
 },
 {
  "id": "04324:0173",
  "jp": "あれこそが、大婆による\\nユリ子$c02殺害$c00の現場さ",
  "en": ""
 },
 {
  "id": "04324:0174",
  "jp": "えっ？\\nどういうこと？",
  "en": ""
 },
 {
  "id": "04324:0175",
  "jp": "何故に？",
  "en": ""
 },
 {
  "id": "04324:0176",
  "jp": "んー、\\nわっかんないなあ",
  "en": ""
 },
 {
  "id": "04324:0177",
  "jp": "大婆が中庭で茶会を\\n開いたのを\\n覚えているかい？",
