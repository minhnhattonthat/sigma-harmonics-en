 },
 {
  "id": "04324:0010",
  "jp": "これは、\\n僕の超推理が\\n導きだした結論だ",
  "en": ""
 },
 {
  "id": "04324:0011",
  "jp": "さぁ、\\n調律を始めよう！",
  "en": ""
 },
 {
  "id": "04324:0012",
  "jp": "Ｑ．Ｅ．Ｄ．",
  "en": ""
 },
 {
  "id": "04324:0013",
