 },
 {
  "id": "04324:0230",
  "jp": "自動で弾丸を\\n撃ち出すような\\n装置を仕掛けるんだ",
  "en": ""
 },
 {
  "id": "04324:0231",
  "jp": "これなら、死亡した後に\\nだって、$c02殺人$c00を犯す\\nことはできるさ",
  "en": ""
 },
 {
  "id": "04324:0232",
  "jp": "それで、静馬さん自身は\\nどうして$c02死$c00ななきゃ\\nならないのよ",
  "en": ""
 },
 {
  "id": "04324:0233",
  "jp": "例えば、装置。\\nご頭首自身は何故？",
  "en": ""
 },
 {
  "id": "04324:0234",
  "jp": "はいはい。\\nんで、頭首自身は\\nなんで$c02死$c00んだっての？",
  "en": ""
 },
 {
  "id": "04324:0235",
