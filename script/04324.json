 },
 {
  "id": "04324:0209",
  "jp": "なら仕方ない",
  "en": ""
 },
 {
  "id": "04324:0210",
  "jp": "うーん、どうなのかなー",
  "en": ""
 },
 {
  "id": "04324:0211",
  "jp": "…理由って、それだけ？",
  "en": ""
 },
 {
  "id": "04324:0212",
  "jp": "それだけ？",
  "en": ""
 },
 {
  "id": "04324:0213",
  "jp": "ホントにちゃんと\\n超推理したんで\\nしょうね？",
  "en": ""
 },
 {
  "id": "04324:0214",
  "jp": "僕の超推理が\\nそういう結論を\\n導き出したんだ",
  "en": ""
 },
 {
  "id": "04324:0215",
  "jp": "何も問題は無い",
  "en": ""
 },
 {
  "id": "04324:0216",
  "jp": "$c02大逢魔$c00は\\n【ねねの部屋】\\nにいるはずだ",
  "en": ""
 },
 {
  "id": "04324:0217",
  "jp": "$c02大逢魔$c00は\\n【執事の部屋】\\nにいるはずだ",
  "en": ""
 },
 {
  "id": "04324:0218",
  "jp": "ちょ、ちょっと待ってよ",
  "en": ""
 },
 {
  "id": "04324:0219",
  "jp": "静馬さんが$c02死$c00んだ後も、\\n事件は起きてるよね？",
