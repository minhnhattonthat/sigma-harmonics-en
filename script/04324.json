 },
 {
  "id": "04324:0259",
  "jp": "……",
  "en": ""
 },
 {
  "id": "04324:0260",
  "jp": "……",
  "en": ""
 },
 {
  "id": "04324:0261",
  "jp": "……",
  "en": ""
 },
 {
  "id": "04324:0262",
  "jp": "意識が低下し、\\n感覚に異常をきたした\\n状態で、",
