[
 {
  "id": "04252:0000",
  "jp": "月弓に、\\n式を飛ばしてくれ",
  "en": ""
 },
 {
  "id": "04252:0001",
  "jp": "電話も無線も\\nダメでな",
  "en": ""
 },
 {
  "id": "04252:0002",
  "jp": "至急、黒上の館まで\\n来てくれとな",
  "en": ""
 },
 {
  "id": "04252:0003",
  "jp": "はい",
  "en": ""
 },
 {
  "id": "04252:0004",
  "jp": "ねねちゃんって、\\n式を飛ばせるんだ",
  "en": ""
 },
 {
  "id": "04252:0005",
  "jp": "ねねっちは、\\nあの歳で、もう\\n式を使えるのか",
  "en": ""
 },
 {
  "id": "04252:0006",
  "jp": "へぇ、ねねって\\n式を使う力\\n持ってるんだ",
  "en": ""
 },
 {
  "id": "04252:0007",
  "jp": "すごいね。もしかして、\\n黒上と違う血筋……\\nなのかな？",
  "en": ""
 },
 {
  "id": "04252:0008",
  "jp": "でも、ゆう君の\\nお姉さんでしょ？",
  "en": ""
 },
 {
  "id": "04252:0009",
  "jp": "はてな？\\nでも、ゆーっちの\\nねぇねぇでは？",
  "en": ""
 },
 {
  "id": "04252:0010",
  "jp": "ん？　でも、\\nゆうの姉だったら\\n黒上じゃない？",
  "en": ""
 },
 {
  "id": "04252:0011",
  "jp": "そうだったね",
  "en": ""
 },
 {
  "id": "04252:0012",
  "jp": "まぁ、アタシも\\nあれくらいの歳には\\n飛ばしてたけどね",
  "en": ""
 },
 {
  "id": "04252:0013",
  "jp": "えっへん",
  "en": ""
 },
 {
  "id": "04252:0014",
  "jp": "はいはい、\\nすごいすごい",
  "en": ""
 },
 {
  "id": "04252:0015",
  "jp": "心がこもってなーい！",
  "en": ""
 },
 {
  "id": "04252:0016",
  "jp": "【式を飛ばすねね】\\nの刻音を手に入れた！",
  "en": ""
 }
]
