[
 {
  "id": "04178:0000",
  "jp": "すみません、佳子様",
  "en": ""
 },
 {
  "id": "04178:0001",
  "jp": "丁度、用事が\\n済んだところだから\\n大丈夫よ",
  "en": ""
 },
 {
  "id": "04178:0002",
  "jp": "大婆様によろしくね",
  "en": ""
 },
 {
  "id": "04178:0003",
  "jp": "はい、それでは、\\n失礼いたします",
  "en": ""
 },
 {
  "id": "04178:0004",
  "jp": "執事の去る音と\\nユリ子が来る音\\n（仮）",
  "en": ""
 },
 {
  "id": "04178:0005",
  "jp": "ん？",
  "en": ""
 },
 {
  "id": "04178:0006",
  "jp": "どうか、\\nなさったんですか？",
  "en": ""
 },
 {
  "id": "04178:0007",
  "jp": "私が倉庫から生地を\\nだすのに、借りてた\\n鍵を渡したのよ",
  "en": ""
 },
 {
  "id": "04178:0008",
  "jp": "そうですか",
  "en": ""
 },
 {
  "id": "04178:0009",
  "jp": "それで、\\nご用というのは……",
  "en": ""
 },
 {
  "id": "04178:0010",
  "jp": "そうそう、この服\\nなんだけどね……",
  "en": ""
 },
 {
  "id": "04178:0011",
  "jp": "執事さん、\\n鍵をどうする\\nつもりだろう？",
  "en": ""
 },
 {
  "id": "04178:0012",
  "jp": "ふみゅ。鍵は仮面が\\n持ってった。\\n何に使う？",
  "en": ""
 },
 {
  "id": "04178:0013",
  "jp": "あれ、\\nマスターキーよね？\\n何に使うつもりよ？",
  "en": ""
 },
 {
  "id": "04178:0014",
  "jp": "……これだけじゃ、\\n分からないね",
  "en": ""
 },
 {
  "id": "04178:0015",
  "jp": "あの鍵……",
  "en": ""
 },
 {
  "id": "04178:0016",
  "jp": "ん？　鍵の使い道、\\n分かったの？",
  "en": ""
 },
 {
  "id": "04178:0017",
  "jp": "ふみゅ？\\n何か気づいたか？",
  "en": ""
 },
 {
  "id": "04178:0018",
  "jp": "ん？　あの鍵？\\n何に使うの？",
  "en": ""
 },
 {
  "id": "04178:0019",
  "jp": "芙蓉の部屋\\nかもしれないね",
  "en": ""
 },
 {
  "id": "04178:0020",
  "jp": "普段は、\\n鍵をかけないけど、",
  "en": ""
 },
 {
  "id": "04178:0021",
  "jp": "客人には、\\nあの部屋用の鍵を\\n貸すからね",
  "en": ""
 },
 {
  "id": "04178:0022",
  "jp": "あ、それで、\\n執事さんが、\\n芙蓉さんの部屋に……",
  "en": ""
 },
 {
  "id": "04178:0023",
  "jp": "ふみゅ。それで、\\n仮面は言の葉の\\n部屋にいたか",
  "en": ""
 },
 {
  "id": "04178:0024",
  "jp": "なーる。\\nそれで、あの部屋に\\n入り込んだわけね",
  "en": ""
 },
 {
  "id": "04178:0025",
  "jp": "【鍵を借りた執事】\\nの刻音を手に入れた！",
  "en": ""
 }
]
