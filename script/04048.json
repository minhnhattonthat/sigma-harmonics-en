 },
 {
  "id": "04048:0019",
  "jp": "そりゃ、これはね。\\n事故も$c02自殺$c00も\\nありえないって",
  "en": ""
 },
 {
  "id": "04048:0020",
  "jp": "……やれやれ、\\nこりゃ重症だわ",
  "en": ""
 },
 {
  "id": "04048:0021",
  "jp": "$c02逢魔$c00に、かなりの\\n憎しみを増強\\nされてるんじゃない？",
  "en": ""
 },
 {
  "id": "04048:0022",
  "jp": "じゃなきゃ、\\nこんなふうに、変な格好\\nさせないでしょ？",
