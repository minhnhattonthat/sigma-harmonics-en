 },
 {
  "id": "04048:0012",
  "jp": "うん……\\nこんなの事故でも\\n$c02自殺$c00でもないよ",
  "en": ""
 },
 {
  "id": "04048:0013",
  "jp": "でも、なんでこんなに\\n酷いことを……",
  "en": ""
 },
 {
  "id": "04048:0014",
  "jp": "まるで、\\n何かの形を……",
  "en": ""
 },
 {
  "id": "04048:0015",
  "jp": "肯定……\\n事故、$c02自殺$c00、\\n共にありえない",
