[
 {
  "id": "04060:0000",
  "jp": "大婆様？",
  "en": ""
 },
 {
  "id": "04060:0001",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04060:0002",
  "jp": "佳子さん",
  "en": ""
 },
 {
  "id": "04060:0003",
  "jp": "？！",
  "en": ""
 },
 {
  "id": "04060:0004",
  "jp": "まぁったく……\\n触るんじゃないよ！",
  "en": ""
 },
 {
  "id": "04060:0005",
  "jp": "何度も言っとるやろう",
  "en": ""
 },
 {
  "id": "04060:0006",
  "jp": "すみません、お婆様",
  "en": ""
 },
 {
  "id": "04060:0007",
  "jp": "それで、何か用かえ？",
  "en": ""
 },
 {
  "id": "04060:0008",
  "jp": "はい、鍵をお貸し\\nいただこうかと……",
  "en": ""
 },
 {
  "id": "04060:0009",
  "jp": "そうかえ、\\n何に使うんかの？",
  "en": ""
 },
 {
  "id": "04060:0010",
  "jp": "はい、倉庫から\\nだしたいものが\\nありまして……",
  "en": ""
 },
 {
  "id": "04060:0011",
  "jp": "そうかえ。\\nでんも、梅は\\n寝てしもうてからに",
  "en": ""
 },
 {
  "id": "04060:0012",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04060:0013",
  "jp": "佳子さんかえ？",
  "en": ""
 },
 {
  "id": "04060:0014",
  "jp": "はい、大婆様",
  "en": ""
 },
 {
  "id": "04060:0015",
  "jp": "わしに、\\n触らんかったろうね？",
  "en": ""
 },
 {
  "id": "04060:0016",
  "jp": "はい、私は、\\n鍵をお借りにきた\\nだけですので……",
  "en": ""
 },
 {
  "id": "04060:0017",
  "jp": "そうかえ",
  "en": ""
 },
 {
  "id": "04060:0018",
  "jp": "それで、\\n何に使うんかの？",
  "en": ""
 },
 {
  "id": "04060:0019",
  "jp": "……はい、倉庫から\\nだしたいものが\\nありまして",
  "en": ""
 },
 {
  "id": "04060:0020",
  "jp": "そうかえ。\\nでんも、竹は\\n寝てしもうてからに……",
  "en": ""
 },
 {
  "id": "04060:0021",
  "jp": "もう、竹には\\n聞いたのかの？",
  "en": ""
 },
 {
  "id": "04060:0022",
  "jp": "……はい。\\n先ほど……",
  "en": ""
 },
 {
  "id": "04060:0023",
  "jp": "何……？\\n今の？",
  "en": ""
 },
 {
  "id": "04060:0024",
  "jp": "お婆さん、何度か、\\n同じようなことを\\nしゃべってたよね",
  "en": ""
 },
 {
  "id": "04060:0025",
  "jp": "それに、佳子さんは、\\nそれをおかしくは\\n思ってなかったみたい",
  "en": ""
 },
 {
  "id": "04060:0026",
  "jp": "はてな？",
  "en": ""
 },
 {
  "id": "04060:0027",
  "jp": "婆ちゃん、同じこと\\n繰り返ししゃべったのに、",
  "en": ""
 },
 {
  "id": "04060:0028",
  "jp": "よっちゃん、\\n普通に対応？",
  "en": ""
 },
 {
  "id": "04060:0029",
  "jp": "変な会話",
  "en": ""
 },
 {
  "id": "04060:0030",
  "jp": "大婆、何度か同じことを\\n繰り返してたわね",
  "en": ""
 },
 {
  "id": "04060:0031",
  "jp": "佳子は、結構、\\n普通に対応してたし",
  "en": ""
 },
 {
  "id": "04060:0032",
  "jp": "そうだね……\\n多分、日常的な\\n出来事なんだろうね",
  "en": ""
 },
 {
  "id": "04060:0033",
  "jp": "もう１つ、\\n気になったのは、",
  "en": ""
 },
 {
  "id": "04060:0034",
  "jp": "会話の途中にでてくる\\n《梅》と《竹》",
  "en": ""
 },
 {
  "id": "04060:0035",
  "jp": "多分、名前……\\nだよね？",
  "en": ""
 },
 {
  "id": "04060:0036",
  "jp": "でも、なんで、\\n名前が２つ……？",
  "en": ""
 },
 {
  "id": "04060:0037",
  "jp": "会話的には、\\n名前かと思う",
  "en": ""
 },
 {
  "id": "04060:0038",
  "jp": "会話の流れからは、\\n名前みたいだけど",
  "en": ""
 },
 {
  "id": "04060:0039",
  "jp": "…………",
  "en": ""
 },
 {
  "id": "04060:0040",
  "jp": "……ねぇ、シグマ",
  "en": ""
 },
 {
  "id": "04060:0041",
  "jp": "もしかして、お婆さん、\\n二重人格……？\\nなのかな？",
  "en": ""
 },
 {
  "id": "04060:0042",
  "jp": "推測。\\n１人の中に２人いる？",
  "en": ""
 },
 {
  "id": "04060:0043",
  "jp": "二重人格とかとか？",
  "en": ""
 },
 {
  "id": "04060:0044",
  "jp": "……あれかね、\\n二重人格ってやつ？",
  "en": ""
 },
 {
  "id": "04060:0045",
  "jp": "……どうだろうね",
  "en": ""
 },
 {
  "id": "04060:0046",
  "jp": "二重人格ってのは、\\n本とかでは\\nよく聞くけど、",
  "en": ""
 },
 {
  "id": "04060:0047",
  "jp": "実際には、すごく\\n珍しいって話を\\n聞いたことがあるよ",
  "en": ""
 },
 {
  "id": "04060:0048",
  "jp": "まぁ、今のネオンが、\\nそうだとも\\n言えなくもないけど",
  "en": ""
 },
 {
  "id": "04060:0049",
  "jp": "それは、\\n神降ろしてる\\n神様の影響よ！",
  "en": ""
 },
 {
  "id": "04060:0050",
  "jp": "ふみゅ……？\\n何が変わってる？？",
  "en": ""
 },
 {
  "id": "04060:0051",
  "jp": "何か、文句あんの？",
  "en": ""
 },
 {
  "id": "04060:0052",
  "jp": "でも、そう考えないと、\\n会話の内容が\\nあまりにも変だよ",
  "en": ""
 },
 {
  "id": "04060:0053",
  "jp": "そうかもね",
  "en": ""
 },
 {
  "id": "04060:0054",
  "jp": "何にせよ、\\n刻音使って推理が吉",
  "en": ""
 },
 {
  "id": "04060:0055",
  "jp": "あぁ、そうだね",
  "en": ""
 },
 {
  "id": "04060:0056",
  "jp": "まぁ、１つの考え方\\nってことよ",
  "en": ""
 },
 {
  "id": "04060:0057",
  "jp": "そうだね",
  "en": ""
 },
 {
  "id": "04060:0058",
  "jp": "【大婆は二重人格？】\\nの刻音を手に入れた！",
  "en": ""
 }
]
